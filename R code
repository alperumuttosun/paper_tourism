# ---- 0b. Warning logger ----------------------------------------------
warn_log <- list()                                                     # all warnings are collected here
log_warn <- function(step, expr) {                                     # runs a step and logs warnings AND errors
  tryCatch(withCallingHandlers(expr, warning = function(w) {
    warn_log[[length(warn_log) + 1]] <<- data.frame(step = step,       # in which step
      message = gsub("\033\\[[0-9;]*m|\033\\]8;;[^\a\033]*(\a|\033\\\\)?", "", to_utf8(conditionMessage(w))),  # warning text; colour codes removed
      call = enc2utf8(paste(deparse(conditionCall(w)), collapse = " ")),  # in which call
      stringsAsFactors = FALSE)
    invokeRestart("muffleWarning")                                     # keeps the console clean (written to CSV)
  }), error = function(e) {                                            # on error the code does not stop, it moves to the next step
    warn_log[[length(warn_log) + 1]] <<- data.frame(step = step, message = paste("HATA:", to_utf8(conditionMessage(e))),
      call = enc2utf8(paste(deparse(conditionCall(e)), collapse = " ")), stringsAsFactors = FALSE)
    message("HATA (", step, "): ", conditionMessage(e), "  -> step_warnings_log.csv")
  })
}

# ---- 1. UTF helpers ----------------------------------------------
to_utf8 <- function(x) {                                               # converts text to safe UTF-8
  x <- as.character(x)
  y <- iconv(x, from = "UTF-8", to = "UTF-8", sub = "")                # accepts UTF-8, drops invalid bytes
  bad <- is.na(y) | !validUTF8(y)
  if (any(bad)) y[bad] <- iconv(x[bad], from = "windows-1254", to = "UTF-8", sub = "")  # Turkish Windows encoding
  y[is.na(y)] <- ""
  y <- gsub("&nbsp;", " ", y, fixed = TRUE)                            # HTML space entity
  y <- gsub("\u00a0", " ", y, fixed = TRUE)                            # non-breaking space
  y <- trimws(gsub("\\s+", " ", y))                                    # repeated spaces
  Encoding(y) <- "UTF-8"                                               # tells R the text is UTF-8
  y
}
raw_to_text <- function(r) to_utf8(rawToChar(r[r != as.raw(0)]))       # raw bytes -> text
translit <- function(x) chartr("\u00e7\u011f\u0131\u00f6\u015f\u00fc\u00c7\u011e\u0130\u00d6\u015e\u00dc\u00e2\u00ee\u00fb\u00c2\u00ce\u00db",
                               "cgiosuCGIOSUaiuAIU", to_utf8(x))       # Turkish letters -> ASCII
safe_key <- function(x) {                                              # comparison key: ASCII + lower case
  k <- translit(x)
  k <- iconv(k, from = "UTF-8", to = "ASCII", sub = "")                # drops anything still non-ASCII
  k[is.na(k)] <- ""
  tolower(k)                                                           # now ASCII only -> tolower is safe
}

write_csv_utf8 <- function(df, f) {                                    # CSV that shows Turkish correctly in Excel
  df[] <- lapply(df, function(c) if (is.character(c)) to_utf8(c) else c)
  ok <- tryCatch({ data.table::fwrite(df, f, bom = TRUE); TRUE }, error = function(e) FALSE)  # Option A
  if (!ok) {                                                           # Option B: manual writing
    q <- function(v) paste0('"', gsub('"', '""', ifelse(is.na(v), "", as.character(v))), '"')
    lines <- c(paste(q(names(df)), collapse = ","), apply(df, 1, function(r) paste(q(r), collapse = ",")))
    con <- file(f, open = "wb"); writeBin(as.raw(c(0xEF, 0xBB, 0xBF)), con)
    writeBin(charToRaw(paste0(paste(enc2utf8(lines), collapse = "\r\n"), "\r\n")), con); close(con)
  }
  invisible(f)
}
csv_ok <- function(f) {                                                # CSV exists and Turkish text is not corrupted
  if (!file.exists(f) || file.info(f)$size == 0) return(FALSE)
  r <- readBin(f, "raw", min(file.info(f)$size, 200000))               # reads raw bytes (NO decoding -> no "invalid input" warning)
  txt <- rawToChar(r[r != as.raw(0) & r < as.raw(128)])                # ASCII bytes only ("<U+" is ASCII)
  !grepl("<U\\+[0-9A-Fa-f]{4}>", txt, useBytes = TRUE)
}
read_csv_utf8 <- function(f) {                                         # reads a UTF-8 CSV with BOM safely
  d <- tryCatch(data.table::fread(f, encoding = "UTF-8", data.table = FALSE),        # Option A
                error = function(e) read.csv(f, fileEncoding = "UTF-8-BOM", stringsAsFactors = FALSE))  # Option B
  names(d) <- sub("^\ufeff", "", names(d))                             # removes BOM residue from the header
  d[] <- lapply(d, function(c) if (is.character(c)) to_utf8(c) else c)
  d
}

make_abs <- function(h) {                                              # relative link -> full URL
  h <- sub("#.*$", "", to_utf8(h))
  ifelse(grepl("^https?://", h), h,
         paste0("https://yigm.ktb.gov.tr", ifelse(grepl("^/", h), h, paste0("/", h))))
}

# ---- 2. Link readers (Option A / Option B) --------------------------------
parse_raw <- function(x) {
  x <- to_utf8(x)
  m <- regmatches(x, gregexpr('<a[^>]+href="[^"]+"[^>]*>.*?</a>', x, perl = TRUE, useBytes = TRUE))[[1]]
  if (length(m) == 0) return(NULL)
  m <- to_utf8(m)                                                      # converts the marking from useBytes to UTF-8
  data.frame(text = to_utf8(gsub("<[^>]+>", "", m)),
             href = to_utf8(sub('.*href="([^"]+)".*', "\\1", m)), stringsAsFactors = FALSE)
}
yol_a <- function(u) {                                                 # Option A: httr
  r <- httr::GET(u, httr::user_agent(ua), httr::timeout(60))
  if (httr::status_code(r) != 200) return(NULL)
  parse_raw(raw_to_text(httr::content(r, as = "raw")))
}
yol_b <- function(u) {                                                 # Option B: base R
  tf <- tempfile(fileext = ".html")
  ok <- tryCatch(suppressWarnings(download.file(u, tf, mode = "wb", quiet = TRUE)), error = function(e) 1)
  if (ok != 0 || !file.exists(tf)) return(NULL)
  parse_raw(raw_to_text(readBin(tf, "raw", file.info(tf)$size)))
}
get_links <- function(u) {                                             # A, otherwise B; errors do not stop the code
  d <- tryCatch(yol_a(u), error = function(e) NULL)
  if (is.null(d) || nrow(d) == 0) d <- tryCatch(yol_b(u), error = function(e) NULL)
  if (is.null(d)) { message("Okunamadi (sitede 404 veya erisim yok): ", u); return(NULL) }
  d <- d[!is.na(d$href) & nzchar(d$href), , drop = FALSE]
  if (nrow(d) == 0) return(NULL)
  d$href <- make_abs(d$href); d$source <- rep(u, nrow(d))
  d
}
is_file_link <- function(h) grepl("\\.(xls|xlsx|pdf|zip|rar|doc|docx)(\\?|$)|/Eklenti/", h, ignore.case = TRUE)

crawl <- function(seeds, follow_pat, skip_pat, max_depth, max_pages = 80) {  # crawls pages breadth-first
  visited <- character(0); out <- list()
  queue <- data.frame(u = seeds, d = 0, stringsAsFactors = FALSE)
  while (nrow(queue) > 0 && length(visited) < max_pages) {
    u <- queue$u[1]; d <- queue$d[1]; queue <- queue[-1, , drop = FALSE]
    if (u %in% visited) next
    visited <- c(visited, u); Sys.sleep(1)
    L <- tryCatch(get_links(u), error = function(e) NULL)
    if (is.null(L)) next
    out[[length(out) + 1]] <- L
    if (d < max_depth) {
      key <- safe_key(paste(L$text, L$href))
      nxt <- unique(L$href[grepl("yigm\\.ktb\\.gov\\.tr/TR-\\d+", L$href) & grepl(follow_pat, key) & !grepl(skip_pat, key)])
      nxt <- setdiff(nxt, c(visited, queue$u))
      if (length(nxt)) queue <- rbind(queue, data.frame(u = nxt, d = d + 1, stringsAsFactors = FALSE))
    }
  }
  list(links = if (length(out)) do.call(rbind, out) else NULL, visited = visited)
}

mon_map <- c(ocak = 1, subat = 2, mart = 3, nisan = 4, mayis = 5, haziran = 6, temmuz = 7,
             agustos = 8, eylul = 9, ekim = 10, kasim = 11, aralik = 12)
label_files <- function(files) {                                       # year / month / type labels for files
  key <- safe_key(paste(files$text, files$href))
  files$year <- NA_integer_
  has_y <- grepl("20[0-3][0-9]", key)
  files$year[has_y] <- as.integer(regmatches(key, regexpr("20[0-3][0-9]", key)))
  files$month <- vapply(key, function(k) {
    h <- names(mon_map)[vapply(names(mon_map), function(m) grepl(m, k), logical(1))]
    if (length(h)) as.integer(mon_map[[h[1]]]) else NA_integer_
  }, integer(1), USE.NAMES = FALSE)
  files$kind <- ifelse(grepl("belediye", key), "belediye",
                ifelse(grepl("il-ilce|il ilce", key), "il_ilce_yillik",
                ifelse(grepl("tesisi istatistik|tesis istatistik", key), "tesis_kapasite",
                ifelse(grepl("aylik", key) & grepl("konaklama", key), "konaklama_aylik",
                ifelse(grepl("yillik", key), "yillik", "diger")))))
  files
}

# ---- 3. Excel download and reading helpers ----------------------------
local_name <- function(u) {                                            # local name of the file to download
  id <- sub(".*/Eklenti/(\\d+),.*", "\\1", u)                          # attachment number (unique)
  nm <- sub("\\?.*$", "", sub(".*/Eklenti/\\d+,", "", u))              # file name part
  file.path(proj_dir, paste0("raw_", id, "_", nm))                     # numbered so that two files with the same name do not clash
}
old_name <- function(u) file.path(proj_dir, paste0("raw_", sub("\\?.*$", "", sub(".*/Eklenti/\\d+,", "", u))))  # step01a naming
shared_names <- character(0)                                           # filled in step01b
looks_excel <- function(f) {                                           # really an Excel file (not an HTML error page)
  if (!file.exists(f) || file.info(f)$size < 1000) return(FALSE)
  sig <- readBin(f, "raw", 4)
  identical(sig[1:2], as.raw(c(0x50, 0x4B))) || identical(sig, as.raw(c(0xD0, 0xCF, 0x11, 0xE0)))
}
download_once <- function(u) {                                         # downloads if missing, leaves it alone if present
  f <- local_name(u)
  if (looks_excel(f)) return(f)
  fo <- old_name(u)                                                    # does not download again if step01a already downloaded the sample
  if (looks_excel(fo) && !(basename(fo) %in% shared_names)) { file.copy(fo, f); if (looks_excel(f)) return(f) }
  ok <- tryCatch({                                                     # Option A: httr
    r <- httr::GET(u, httr::user_agent(ua), httr::timeout(120), httr::write_disk(f, overwrite = TRUE))
    httr::status_code(r) == 200
  }, error = function(e) FALSE)
  if (!ok || !looks_excel(f)) {                                        # Option B: base R
    ok <- tryCatch(suppressWarnings(download.file(u, f, mode = "wb", quiet = TRUE)) == 0, error = function(e) FALSE)
  }
  Sys.sleep(0.5)                                                       # to avoid overloading the site
  if (looks_excel(f)) f else { message("Indirilemedi: ", u); NA_character_ }
}
sheet_names <- function(f) {                                           # sheet names in the file
  s <- tryCatch(readxl::excel_sheets(f), error = function(e) NULL)     # Option A: readxl
  if (is.null(s)) s <- tryCatch(openxlsx::getSheetNames(f), error = function(e) NULL)  # Option B: openxlsx
  if (is.null(s)) character(0) else to_utf8(s)
}
read_sheet_text <- function(f, s) {                                    # reads a whole sheet as text
  d <- tryCatch(suppressMessages(readxl::read_excel(f, sheet = s, col_names = FALSE, col_types = "text",
                                                    .name_repair = "minimal")), error = function(e) NULL)  # Option A
  if (is.null(d)) d <- tryCatch(openxlsx::read.xlsx(f, sheet = s, colNames = FALSE, skipEmptyRows = FALSE,
                                                    skipEmptyCols = FALSE), error = function(e) NULL)       # Option B
  if (is.null(d)) return(NULL)
  d <- as.data.frame(lapply(d, function(c) to_utf8(as.character(c))), stringsAsFactors = FALSE)
  names(d) <- paste0("V", seq_len(ncol(d)))                            # renames columns to plain V1, V2...
  d[is.na(d)] <- ""
  d
}
parse_num <- function(x) {                                             # converts numeric text to numbers safely
  x <- gsub("[ \u00a0]", "", to_utf8(x))
  thou <- grepl("^-?[0-9]{1,3}([.,][0-9]{3})+$", x)                    # thousands separators as in 1.234.567?
  x[thou] <- gsub("[.,]", "", x[thou])                                 # removes thousands separators
  x <- sub(",", ".", x, fixed = TRUE)                                  # decimal comma -> point
  suppressWarnings(as.numeric(x))
}

parse_rate <- function(x) {                                            # for ratios (such as 1.125) the thousands rule is NOT applied
  x <- gsub("[ \u00a0%]", "", to_utf8(x))
  suppressWarnings(as.numeric(sub(",", ".", x, fixed = TRUE)))
}

il_alias <- c(afyon = "afyonkarahisar", "k.maras" = "kahramanmaras", kmaras = "kahramanmaras",
              icel = "mersin", "mersin(icel)" = "mersin", "icel(mersin)" = "mersin",
              "afyon karahisar" = "afyonkarahisar", "kahraman maras" = "kahramanmaras",
              "sanli urfa" = "sanliurfa", "s.urfa" = "sanliurfa")      # different province names in older files
il_key <- function(x) {                                                # converts a province name to the standard key
  k <- trimws(gsub("[^a-z.() ]", "", safe_key(x)))
  k <- ifelse(k %in% names(il_alias), il_alias[k], k)
  gsub("[ .()]", "", k)
}

parse_il_sheet <- function(f) {                                        # extracts the province table from the "Il" sheet
  sh <- sheet_names(f)
  sk <- safe_key(sh)
  pick <- which(sk == "il")                                            # sheet named exactly "Il"
  if (!length(pick)) pick <- which(grepl("^il", sk) & !grepl("ilce", sk))  # otherwise a sheet starting with "Il" (not district)
  cand <- if (length(pick)) pick else seq_along(sh)                    # otherwise all sheets are tried
  for (i in cand) {
    d <- read_sheet_text(f, sh[i])
    if (is.null(d) || nrow(d) < 10) next
    dk <- as.data.frame(lapply(d, safe_key), stringsAsFactors = FALSE) # ASCII key table
    title <- d[1, 1]                                                   # sheet title (coverage information)
    hdr <- which(apply(dk, 1, function(r) any(grepl("^yabanci$", r)) && any(grepl("^yerli$", r))))[1]  # sub-header row
    if (is.na(hdr)) next
    top <- dk[max(1, hdr - 1), ]                                       # top header row (arrivals / overnight stays)
    grp <- character(ncol(d)); cur <- ""
    for (j in seq_len(ncol(d))) {                                      # fills merged cells to the right
      if (nzchar(top[[j]])) cur <- top[[j]]
      grp[j] <- cur
    }
    sub <- unname(unlist(dk[hdr, ]))                                   # sub-header row (foreign/domestic/total)
    col_of <- function(g, s) unname(which(grepl(g, grp) & sub == s))[1]  # finds columns by group + sub-header
    cols <- c(gelis_yabanci   = col_of("gelis", "yabanci"),  gelis_yerli   = col_of("gelis", "yerli"),
              geceleme_yabanci = col_of("geceleme", "yabanci"), geceleme_yerli = col_of("geceleme", "yerli"),
              gelis_toplam    = col_of("gelis", "toplam"),   geceleme_toplam = col_of("geceleme", "toplam"))
    rcols <- c(kalis_yabanci = col_of("kalis", "yabanci"), kalis_yerli = col_of("kalis", "yerli"),
               kalis_toplam = col_of("kalis", "toplam"),
               doluluk_yabanci = col_of("doluluk", "yabanci"), doluluk_yerli = col_of("doluluk", "yerli"),
               doluluk_toplam = col_of("doluluk", "toplam"))                # ratio columns (length of stay, occupancy %)
    if (any(is.na(cols[1:4]))) next                                    # not this sheet if the 4 basic columns are missing
    body <- d[(hdr + 1):nrow(d), , drop = FALSE]
    bk <- dk[(hdr + 1):nrow(d), 1]
    end <- which(grepl("^toplam|^genel toplam|^turkiye", bk))[1]       # TOTAL row
    tot <- if (!is.na(end)) body[end, , drop = FALSE] else NULL
    rows <- if (!is.na(end)) seq_len(end - 1) else seq_len(nrow(body))
    body <- body[rows, , drop = FALSE]
    body <- body[nzchar(body[[1]]), , drop = FALSE]                    # drops empty rows
    out <- data.frame(il = body[[1]], il_key = il_key(body[[1]]), stringsAsFactors = FALSE)
    for (nm in names(cols)) out[[nm]] <- if (is.na(cols[[nm]])) NA_real_ else parse_num(body[[cols[[nm]]]])
    for (nm in names(rcols)) out[[nm]] <- if (is.na(rcols[[nm]])) NA_real_ else parse_rate(body[[rcols[[nm]]]])  # no thousands rule for ratios
    out <- out[!is.na(out$geceleme_yerli) | !is.na(out$geceleme_yabanci), , drop = FALSE]  # drops non-numeric rows
    tot_vals <- if (is.null(tot)) rep(NA_real_, 4) else
      vapply(names(cols)[1:4], function(nm) parse_num(tot[[cols[[nm]]]]), numeric(1))
    return(list(data = out, sheet = sh[i], title = title, total = tot_vals))
  }
  NULL
}

