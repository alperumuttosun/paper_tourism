# =====================================================================
# step05: ROBUSTNESS - key parts
#   (a) Network descriptives: full network, weights divided by the number of programmes (W/N),
#       domestic side with source exclusion (Jolly / Tatil Sepeti / Setur), equal-size subsamples (200 replications)
#   (b) Main dyadic result (itinerary intensity, before similarity M0 / after M4) re-estimated with the same variants
#   (c) Programme bootstrap (200 replications): tours are resampled and the network and coefficient recomputed
#   (d) Table of shared / market-specific links (third panel of Figure 1 in step04)
#   Outputs: step05_*.csv and step05_robustness.xlsx (for the Supplementary material)
# =====================================================================
f05 <- file.path(proj_dir, "step05_dyadic_robustness.csv")
log_warn("step05", {
  if (csv_ok(f05)) message("step05 zaten yapilmis, atlaniyor.") else {
  pn <- read_csv_utf8(f01d_panel)
  ik <- sort(unique(pn$il_key)); n <- length(ik); tt <- sort(unique(pn$t))
  tl <- read_csv_utf8(file.path(proj_dir, "step02b2_tour_provinces.csv"))
  tl <- tl[!is.na(tl$iller) & tl$n_il >= 2, ]
  readM <- function(f) { x <- read_csv_utf8(file.path(proj_dir, f)); M <- as.matrix(x[, -1]); dimnames(M) <- list(x$il_key, x$il_key); M[ik, ik] }
  Dk <- readM("step02a_dist_km.csv"); Kc <- readM("step02a_W_contig.csv") > 0
  up <- which(upper.tri(Dk), arr.ind = TRUE)
  Xfe <- matrix(0, nrow(up), n); Xfe[cbind(seq_len(nrow(up)), up[, 1])] <- 1; Xfe[cbind(seq_len(nrow(up)), up[, 2])] <- 1
  build_C <- function(x) {                                             # co-occurrence matrix from a programme list
    x <- x[!duplicated(x$program), ]
    C <- matrix(0, n, n, dimnames = list(ik, ik))
    for (s in strsplit(x$iller, ";", fixed = TRUE)) { s <- intersect(s, ik); if (length(s) >= 2) C[s, s] <- C[s, s] + 1 }
    diag(C) <- 0; attr(C, "n_prog") <- nrow(x); C
  }
  gini <- function(v) { v <- sort(v); m <- length(v); if (sum(v) == 0) return(NA); (2 * sum(seq_len(m) * v) / (m * sum(v))) - (m + 1) / m }
  net_stats <- function(C, Cother) {                                   # network descriptives
    e <- C[up] > 0; eo <- Cother[up] > 0; st <- rowSums(C)
    c(n_program = attr(C, "n_prog"), n_il = sum(rowSums(C > 0) > 0), n_bag = sum(e),
      pay_komsu_olmayan = mean(!Kc[up][e]), medyan_km = median(Dk[up][e]), pay_300km_ustu = mean(Dk[up][e] > 300),
      jaccard_diger_pazar = sum(e & eo) / sum(e | eo), gini_guc = gini(st), denizli_nevsehir = C["denizli", "nevsehir"],
      denizli_nevsehir_normalize = C["denizli", "nevsehir"] / attr(C, "n_prog"))
  }
  # ---- residual correlations (same definition as step03d, year-on-year growth) ----
  kiyi <- c("adana", "antalya", "artvin", "aydin", "balikesir", "bartin", "bursa", "canakkale", "duzce", "edirne", "giresun", "hatay",
            "istanbul", "izmir", "kastamonu", "kirklareli", "kocaeli", "mersin", "mugla", "ordu", "rize", "sakarya", "samsun", "sinop",
            "tekirdag", "trabzon", "yalova", "zonguldak")
  pre <- pn[pn$year >= 2017 & pn$year <= 2019, ]
  tot <- function(v) { a <- tapply(pre[[v]], pre$il_key, sum, na.rm = TRUE); a[ik] }
  yab_pay <- tot("geceleme_yabanci") / pmax(tot("geceleme_yabanci") + tot("geceleme_yerli"), 1)
  boy <- log1p((tot("geceleme_yabanci") + tot("geceleme_yerli")) / 36)
  prof <- function(v) { a <- aggregate(pre[[v]], by = list(il = pre$il_key, ay = pre$month), FUN = function(z) sum(z, na.rm = TRUE))
    P <- matrix(0, n, 12, dimnames = list(ik, 1:12)); P[cbind(match(a$il, ik), a$ay)] <- a$x; P / pmax(rowSums(P), 1) }
  zz <- list(); SIM <- list()
  for (mk in c("yerli", "yabanci")) {
    y <- pn[[paste0("dlog_y_geceleme_", mk)]]
    d <- data.frame(y = y, il = factor(pn$il_key), ay = factor(pn$t)); ok <- is.finite(d$y)
    E <- matrix(NA_real_, n, length(tt)); E[cbind(match(pn$il_key[ok], ik), match(pn$t[ok], tt))] <- resid(lm(y ~ il + ay, data = d[ok, ]))
    zz[[mk]] <- vapply(seq_len(nrow(up)), function(p) { a <- E[up[p, 1], ]; b <- E[up[p, 2], ]; o <- is.finite(a) & is.finite(b)
      if (sum(o) >= 36) atanh(max(min(cor(a[o], b[o]), 0.999), -0.999)) else NA_real_ }, numeric(1))
    mevs <- cor(t(prof(paste0("geceleme_", mk)))); mevs[!is.finite(mevs)] <- 0
    SIM[[mk]] <- cbind(komsu = as.numeric(Kc[up]), log_uzaklik = log(Dk[up]), mevsim_benzer = mevs[up],
                       yab_pay_fark = abs(yab_pay[up[, 1]] - yab_pay[up[, 2]]),
                       kiyi_ikisi = as.numeric(ik[up[, 1]] %in% kiyi & ik[up[, 2]] %in% kiyi), buyukluk_fark = abs(boy[up[, 1]] - boy[up[, 2]]))
  }
  coef_rota <- function(C, mk) {                                       # M0 and M4 itinerary intensity coefficients
    z <- zz[[mk]]; R <- log1p(C[up]); S <- SIM[[mk]]
    f <- function(X) { o <- is.finite(z) & rowSums(!is.finite(X)) == 0; unname(lm.fit(cbind(X[o, , drop = FALSE], Xfe[o, , drop = FALSE]), z[o])$coefficients[1]) }
    c(M0 = f(cbind(R, S[, c("komsu", "log_uzaklik")])), M4 = f(cbind(R, S)))
  }
  Cfull <- list(yerli = build_C(tl[tl$pazar == "yerli", ]), yabanci = build_C(tl[tl$pazar == "yabanci", ]))
  variants <- list(tam = list(yerli = Cfull$yerli, yabanci = Cfull$yabanci))
  for (s in c("jollytur", "tatilsepeti", "setur")) variants[[paste0("yerli_", s, "_haric")]] <- list(yerli = build_C(tl[tl$pazar == "yerli" & tl$site != s, ]), yabanci = Cfull$yabanci)
  variants$yerli_gunubirlik_haric <- list(yerli = build_C(tl[tl$pazar == "yerli" & tl$gunubirlik == 0, ]), yabanci = Cfull$yabanci)
  nets <- list(); rob <- list()
  for (vn in names(variants)) {
    V <- variants[[vn]]
    for (mk in c("yerli", "yabanci")) {
      ot <- setdiff(c("yerli", "yabanci"), mk)
      nets[[length(nets) + 1]] <- data.frame(varyant = vn, pazar = mk, t(round(net_stats(V[[mk]], V[[ot]]), 4)), stringsAsFactors = FALSE)
      if (vn == "tam" || mk == "yerli") { b <- coef_rota(V[[mk]], mk)
        rob[[length(rob) + 1]] <- data.frame(varyant = vn, pazar = mk, b_M0 = round(b[["M0"]], 4), b_M4 = round(b[["M4"]], 4),
                                             azalma_yuzde = round(100 * (1 - b[["M4"]] / b[["M0"]]), 1), stringsAsFactors = FALSE) }
    }
  }
  set.seed(20261112)
  progs <- list(yerli = tl[tl$pazar == "yerli", ], yabanci = tl[tl$pazar == "yabanci", ])
  progs <- lapply(progs, function(x) x[!duplicated(x$program), ])
  n_eq <- min(vapply(progs, nrow, integer(1)))                         # equal size: number of programmes of the smaller market
  bs <- list(); eq <- list()
  for (k in 1:200) {
    Cb <- lapply(progs, function(x) { xb <- x[sample.int(nrow(x), replace = TRUE), ]; xb$program <- paste(xb$program, seq_len(nrow(xb))); build_C(xb) })  # programme bootstrap
    for (mk in c("yerli", "yabanci")) { b <- coef_rota(Cb[[mk]], mk); bs[[length(bs) + 1]] <- data.frame(tekrar = k, pazar = mk, b_M0 = b[["M0"]], b_M4 = b[["M4"]]) }
    Ce <- lapply(progs, function(x) build_C(x[sample.int(nrow(x), n_eq), ]))  # equal-size subsamples
    for (mk in c("yerli", "yabanci")) eq[[length(eq) + 1]] <- data.frame(tekrar = k, pazar = mk, t(net_stats(Ce[[mk]], Ce[[setdiff(c("yerli", "yabanci"), mk)]])))
    if (k %% 50 == 0) cat("  bootstrap:", k, "/ 200\n")
  }
  bs <- do.call(rbind, bs); eq <- do.call(rbind, eq)
  bsum <- do.call(rbind, lapply(split(bs, bs$pazar), function(d) data.frame(pazar = d$pazar[1],
    M0_ort = round(mean(d$b_M0), 4), M0_ci_alt = round(quantile(d$b_M0, 0.025), 4), M0_ci_ust = round(quantile(d$b_M0, 0.975), 4),
    M4_ort = round(mean(d$b_M4), 4), M4_ci_alt = round(quantile(d$b_M4, 0.025), 4), M4_ci_ust = round(quantile(d$b_M4, 0.975), 4),
    pay_M4_pozitif = round(mean(d$b_M4 > 0), 3), azalma_ort_yuzde = round(100 * mean(1 - d$b_M4 / d$b_M0), 1))))
  esum <- do.call(rbind, lapply(split(eq, eq$pazar), function(d) data.frame(pazar = d$pazar[1], n_program = n_eq,
    pay_komsu_olmayan = round(mean(d$pay_komsu_olmayan), 3), medyan_km = round(mean(d$medyan_km), 1), jaccard = round(mean(d$jaccard_diger_pazar), 3),
    gini_guc = round(mean(d$gini_guc), 3), denizli_nevsehir_ort = round(mean(d$denizli_nevsehir), 1),
    denizli_nevsehir_ci = paste(quantile(d$denizli_nevsehir, c(0.025, 0.975)), collapse = " - "))))
  Cy <- Cfull$yerli; Cf <- Cfull$yabanci                               # ---- shared / specific links
  ey <- Cy[up] >= 2; ef <- Cf[up] >= 2                                 # same threshold as Figure 1 (at least 2 programmes)
  ilad <- unique(pn[, c("il_key", "il")]); nm <- ilad$il[match(ik, ilad$il_key)]
  edges <- data.frame(il_i = nm[up[, 1]], il_j = nm[up[, 2]], yerli_program = Cy[up], yabanci_program = Cf[up],
                      yerli_pay = round(Cy[up] / attr(Cy, "n_prog"), 4), yabanci_pay = round(Cf[up] / attr(Cf, "n_prog"), 4),
                      sinif = ifelse(ey & ef, "ortak", ifelse(ey, "sadece_yerli", ifelse(ef, "sadece_yabanci", "yok"))),
                      uzaklik_km = round(Dk[up], 0), komsu = Kc[up], stringsAsFactors = FALSE)
  edges <- edges[edges$sinif != "yok", ]; edges <- edges[order(edges$sinif, -(edges$yerli_pay + edges$yabanci_pay)), ]
  ozet_sinif <- aggregate(cbind(n = 1, medyan_km = edges$uzaklik_km, pay_komsu = edges$komsu) ~ sinif, data = transform(edges, n = 1),
                          FUN = function(z) if (length(z) && all(z %in% c(0, 1))) sum(z) else median(z))
  ozet_sinif <- data.frame(sinif = names(table(edges$sinif)), n_bag = as.integer(table(edges$sinif)),
                           medyan_km = tapply(edges$uzaklik_km, edges$sinif, median), pay_komsu = round(tapply(edges$komsu, edges$sinif, mean), 3))
  rob <- do.call(rbind, rob); nets <- do.call(rbind, nets)
  write_csv_utf8(rob, f05)
  write_csv_utf8(nets, file.path(proj_dir, "step05_network_variants.csv"))
  write_csv_utf8(bsum, file.path(proj_dir, "step05_bootstrap_summary.csv"))
  write_csv_utf8(esum, file.path(proj_dir, "step05_equal_size_summary.csv"))
  write_csv_utf8(edges, file.path(proj_dir, "step05_edge_classes.csv"))
  write_csv_utf8(ozet_sinif, file.path(proj_dir, "step05_edge_class_summary.csv"))
  sh <- list(S4_network_variants = nets, S5_dyadic_site_robustness = rob, S6_programme_bootstrap = bsum, S7_equal_size = esum,
             S8_edge_classes_summary = ozet_sinif, S9_edge_classes = edges)
  fx <- file.path(proj_dir, "step05_robustness.xlsx")
  okx <- tryCatch({ openxlsx::write.xlsx(sh, fx, overwrite = TRUE); TRUE }, error = function(e) FALSE)  # Option A
  if (!okx) okx <- tryCatch({ writexl::write_xlsx(sh, fx); TRUE }, error = function(e) FALSE)          # Option B (CSVs already written)
  cat("step05 -> site cikarmali ve bootstrap sonuclari:\n"); print(rob, row.names = FALSE); print(bsum, row.names = FALSE); print(ozet_sinif, row.names = FALSE)
  }
