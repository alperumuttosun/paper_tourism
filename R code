title_ym <- function(t) {                                              # "(2026 EYLUL)" in the title -> year, month
  k <- safe_key(t)
  y <- if (grepl("20[0-3][0-9]", k)) as.integer(regmatches(k, regexpr("20[0-3][0-9]", k))) else NA_integer_
  tail_k <- sub(".*\\(", "", k)                                        # last part inside the brackets
  h <- names(mon_map)[vapply(names(mon_map), function(m) grepl(m, tail_k), logical(1))]
  c(year = y, month = if (length(h)) as.integer(mon_map[[h[1]]]) else NA_integer_)
}
coverage_of <- function(t) {                                           # coverage type from the title
  k <- safe_key(t)
  ifelse(grepl("mahalli|belediye", k), "belediye",
  ifelse(grepl("basit", k), "isletme_ve_basit_belgeli",
  ifelse(grepl("isletme", k), "isletme_belgeli", "belirsiz")))
}
f01b_panel <- file.path(proj_dir, "step01b_il_monthly_panel.csv")
log_warn("step01b", {
  if (csv_ok(f01b_panel) && csv_ok(file.path(proj_dir, "step01b_file_check.csv"))) {
    message("step01b zaten yapilmis, atlaniyor.")                       # if the panel exists, the 190 files are not read again
  } else {
  fc <- read_csv_utf8(f00c)
  key <- safe_key(paste(fc$text, fc$href))
  fc$tree  <- ifelse(grepl("belediye", key), "belediye", "bakanlik")   # rebuilds the tree with correct labels (fixes the 2017 error)
  fc$month <- suppressWarnings(as.integer(fc$month))
  fc$year  <- suppressWarnings(as.integer(fc$year))
  is_bulletin <- !is.na(fc$month) & !is.na(fc$year) & fc$year >= 2017 &  # selection of monthly bulletins
    grepl("\\.xlsx?(\\?|$)", fc$href, ignore.case = TRUE) &
    grepl("bulten|isletme|belediye|konaklama-aylik", key) &
    !grepl("tesisi istatistik|tesis istatistik|genelge|birim maliyet|il-ilce|yillik", key)
  bl <- fc[is_bulletin, c("text", "href", "tree", "year", "month")]
  bl <- bl[!duplicated(bl$href), ]
  bl$eklenti_id <- as.integer(sub(".*/Eklenti/(\\d+),.*", "\\1", bl$href))  # file number
  bl <- bl[order(bl$tree, bl$year, bl$month, -bl$eklenti_id), ]
  on <- basename(old_name(bl$href))
  shared_names <<- unique(on[duplicated(on)])                          # same name in different files (e.g. ekim-2019) -> do not trust the old name
  write_csv_utf8(bl, file.path(proj_dir, "step01b_bulletin_list.csv"))
  cat("step01b -> aday aylik bulten dosyasi:", nrow(bl),
      "| bakanlik:", sum(bl$tree == "bakanlik"), "| belediye:", sum(bl$tree == "belediye"), "\n")

  panel <- list(); check <- list()
  for (i in seq_len(nrow(bl))) {                                       # ALL files are read, including copies of the same month
    f <- download_once(bl$href[i])                                     # downloads once, leaves it alone if present
    err <- ""
    res <- if (is.na(f)) NULL else tryCatch(parse_il_sheet(f), error = function(e) { err <<- enc2utf8(conditionMessage(e)); NULL })
    base <- data.frame(tree = bl$tree[i], year = bl$year[i], month = bl$month[i], eklenti_id = bl$eklenti_id[i],
                       file = basename(local_name(bl$href[i])), stringsAsFactors = FALSE)
    if (is.null(res)) {
      check[[i]] <- cbind(base, status = ifelse(is.na(f), "INDIRILEMEDI", "OKUNAMADI"), error = err, sheet = "", title = "",
                          title_year = NA, title_month = NA, coverage = "", n_il = NA, n_unique_il = NA,
                          diff_gelis_yab = NA, diff_gelis_yer = NA, diff_gec_yab = NA, diff_gec_yer = NA,
                          sum_gec_yab = NA, sum_gec_yer = NA, stringsAsFactors = FALSE)
      next
    }
    d <- res$data
    ty <- title_ym(res$title)
    s <- c(sum(d$gelis_yabanci, na.rm = TRUE), sum(d$gelis_yerli, na.rm = TRUE),
           sum(d$geceleme_yabanci, na.rm = TRUE), sum(d$geceleme_yerli, na.rm = TRUE))
    dif <- s - res$total                                               # province sum - TOTAL row (should be 0)
    ok_sum <- all(!is.na(dif)) && all(abs(dif) < 1)
    ok_il  <- nrow(d) >= 75 && nrow(d) <= 81 && !anyDuplicated(d$il_key)  # some provinces are missing in the municipal series (e.g. Karaman)
    ok_ttl <- identical(unname(ty["year"]), bl$year[i]) && identical(unname(ty["month"]), bl$month[i])
    st <- if (ok_sum && ok_il && ok_ttl) "OK" else if (ok_sum && ok_il) "BASLIK_AYI_FARKLI" else "KONTROL"
    check[[i]] <- cbind(base, status = st, error = "", sheet = res$sheet, title = res$title,
                        title_year = ty[["year"]], title_month = ty[["month"]], coverage = coverage_of(res$title),
                        n_il = nrow(d), n_unique_il = length(unique(d$il_key)),
                        diff_gelis_yab = dif[1], diff_gelis_yer = dif[2], diff_gec_yab = dif[3], diff_gec_yer = dif[4],
                        sum_gec_yab = s[3], sum_gec_yer = s[4], stringsAsFactors = FALSE)
    d$tree <- bl$tree[i]; d$year <- bl$year[i]; d$month <- bl$month[i]; d$eklenti_id <- bl$eklenti_id[i]
    d$coverage <- coverage_of(res$title)
    panel[[length(panel) + 1]] <- d
    if (i %% 20 == 0) cat("  islenen dosya:", i, "/", nrow(bl), "\n")
  }
  check <- do.call(rbind, check)
  write_csv_utf8(check, file.path(proj_dir, "step01b_file_check.csv"))         # check of each file

  dup <- check[duplicated(check[, c("tree", "year", "month")]) |
               duplicated(check[, c("tree", "year", "month")], fromLast = TRUE), ]  # more than one file for the same month
  write_csv_utf8(dup, file.path(proj_dir, "step01b_duplicates.csv"))           # copies side by side (are the totals equal)

  good <- check[check$status == "OK", ]                                # only files that pass all checks
  good <- good[order(good$tree, good$year, good$month, -good$eklenti_id), ]
  good <- good[!duplicated(good[, c("tree", "year", "month")]), ]      # if there are copies, the most recently uploaded one (largest id)
  panel <- do.call(rbind, panel)
  panel <- panel[panel$eklenti_id %in% good$eklenti_id, ]
  panel <- panel[order(panel$tree, panel$year, panel$month, panel$il_key),
                 c("tree", "year", "month", "coverage", "il", "il_key", "gelis_yabanci", "gelis_yerli", "gelis_toplam",
                   "geceleme_yabanci", "geceleme_yerli", "geceleme_toplam", "eklenti_id")]
  rownames(panel) <- NULL
  write_csv_utf8(panel, file.path(proj_dir, "step01b_il_monthly_panel.csv"))   # MAIN DATA

  months_all <- expand.grid(month = 1:12, year = 2017:2026, tree = c("bakanlik", "belediye"), stringsAsFactors = FALSE)
  months_all <- months_all[!(months_all$year == 2026 & months_all$month > max(good$month[good$year == 2026 & good$tree == "bakanlik"], 0)), ]
  months_all <- months_all[!(months_all$tree == "belediye" & (months_all$year > 2022 | (months_all$year == 2022 & months_all$month > 10))), ]
  miss <- merge(months_all, cbind(good[, c("tree", "year", "month")], var = 1), all.x = TRUE)
  miss <- miss[is.na(miss$var), c("tree", "year", "month")]            # months still missing in the panel
  write_csv_utf8(if (nrow(miss)) miss else data.frame(tree = "-", year = NA, month = NA),
                 file.path(proj_dir, "step01b_missing_months.csv"))

  il_tab <- as.data.frame(table(il_key = panel$il_key, tree = panel$tree), stringsAsFactors = FALSE)  # number of months available for each province
  names(il_tab)[3] <- "n_months"
  il_tab$il_names <- vapply(seq_len(nrow(il_tab)), function(j)        # different spellings mapped to the same key
    paste(unique(panel$il[panel$il_key == il_tab$il_key[j] & panel$tree == il_tab$tree[j]]), collapse = " | "), character(1))
  write_csv_utf8(il_tab, file.path(proj_dir, "step01b_il_coverage.csv"))       # province name consistency check

  tf <- tempfile()                                                     # fingerprint (comparison across computers)
  pp <- panel[, c("tree", "year", "month", "il_key", "gelis_yabanci", "gelis_yerli", "geceleme_yabanci", "geceleme_yerli")]
  write.csv(pp, tf, row.names = FALSE)                                 # ASCII columns only -> identical bytes on every computer
  fp <- data.frame(run_time = format(Sys.time(), "%Y-%m-%d %H:%M:%S"), computer = Sys.info()[["nodename"]],
                   n_files = nrow(bl), n_ok_files = sum(check$status == "OK"), n_months_in_panel = nrow(good),
                   n_rows = nrow(panel), total_geceleme_yabanci = sum(panel$geceleme_yabanci, na.rm = TRUE),
                   total_geceleme_yerli = sum(panel$geceleme_yerli, na.rm = TRUE), md5_panel = unname(tools::md5sum(tf)))
  write_csv_utf8(fp, file.path(proj_dir, "step01b_fingerprint.csv"))
  cat("step01b -> panel satiri:", nrow(panel), "| panel ay sayisi:", nrow(good), "| eksik ay:", nrow(miss), "\n")
  print(table(check$status))                                           # file status summary
  }
})

# =====================================================================
# step01c: occupancy rate -> province x month bed capacity + coverage breaks
# Since occupancy = overnight stays / (beds x days): beds = overnight stays / (occupancy/100 x days)
# This separates "more tourists" from "new establishments entering the statistics"
# NO download: the raw_ files downloaded in step01b are used
# =====================================================================
f01c_panel <- file.path(proj_dir, "step01c_il_monthly_panel_full.csv")
log_warn("step01c", {
  if (csv_ok(f01c_panel)) message("step01c zaten yapilmis, atlaniyor.") else {
  panel <- read_csv_utf8(f01b_panel)                                   # step01b panel (validated)
  bl <- read_csv_utf8(file.path(proj_dir, "step01b_bulletin_list.csv"))
  ids <- unique(panel$eklenti_id)                                      # only files that entered the panel
  bl <- bl[bl$eklenti_id %in% ids, ]
  days_in <- function(y, m) ifelse(m == 2 & y %% 4 == 0, 29, c(31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31)[m])  # number of days in the month
  rates <- list(); rchk <- list()
  for (i in seq_len(nrow(bl))) {
    f <- local_name(bl$href[i])                                        # file already downloaded
    if (!looks_excel(f)) f <- download_once(bl$href[i])                # otherwise (other computer) downloads it once
    res <- if (is.na(f)) NULL else tryCatch(parse_il_sheet(f), error = function(e) NULL)
    if (is.null(res)) { rchk[[i]] <- data.frame(eklenti_id = bl$eklenti_id[i], status = "OKUNAMADI", n_dol = NA,
                                                med_dol = NA, max_capdiff = NA); next }
    d <- res$data
    d$eklenti_id <- bl$eklenti_id[i]
    dd <- days_in(bl$year[i], bl$month[i])
    if (sum(!is.na(d$doluluk_toplam)) && max(d$doluluk_toplam, na.rm = TRUE) <= 1.5) {  # converts a 0-1 ratio to per cent
      d[, c("doluluk_yabanci", "doluluk_yerli", "doluluk_toplam")] <- 100 * d[, c("doluluk_yabanci", "doluluk_yerli", "doluluk_toplam")]
    }
    d$yatak <- ifelse(d$doluluk_toplam > 0, d$geceleme_toplam / (d$doluluk_toplam / 100 * dd), NA)  # implied number of beds
    cap_yer <- ifelse(d$doluluk_yerli > 0, d$geceleme_yerli / (d$doluluk_yerli / 100 * dd), NA)     # same calculation from the domestic column
    cdiff <- suppressWarnings(max(abs(cap_yer / d$yatak - 1), na.rm = TRUE))  # the two calculations should agree (close to 0)
    rchk[[i]] <- data.frame(eklenti_id = bl$eklenti_id[i], status = ifelse(is.finite(cdiff) && cdiff < 0.01, "OK", "KONTROL"),
                            n_dol = sum(!is.na(d$doluluk_toplam)), med_dol = median(d$doluluk_toplam, na.rm = TRUE),
                            max_capdiff = ifelse(is.finite(cdiff), cdiff, NA))
    rates[[length(rates) + 1]] <- d[, c("eklenti_id", "il_key", "kalis_yabanci", "kalis_yerli", "kalis_toplam",
                                        "doluluk_yabanci", "doluluk_yerli", "doluluk_toplam", "yatak")]
    if (i %% 40 == 0) cat("  step01c islenen dosya:", i, "/", nrow(bl), "\n")
  }
  rates <- do.call(rbind, rates)
  rchk <- merge(bl[, c("tree", "year", "month", "eklenti_id")], do.call(rbind, rchk), by = "eklenti_id")
  write_csv_utf8(rchk[order(rchk$tree, rchk$year, rchk$month), ], file.path(proj_dir, "step01c_rate_check.csv"))

  full <- merge(panel, rates, by = c("eklenti_id", "il_key"), all.x = TRUE, sort = FALSE)  # panel + ratios + beds
  full <- full[order(full$tree, full$year, full$month, full$il_key), c(setdiff(names(panel), "eklenti_id"),
               "kalis_yabanci", "kalis_yerli", "kalis_toplam", "doluluk_yabanci", "doluluk_yerli", "doluluk_toplam", "yatak", "eklenti_id")]
  full$yatak <- round(full$yatak)
  full$flag_kalis <- as.integer(full$gelis_toplam > 0 & full$geceleme_toplam / full$gelis_toplam > 10)  # suspicious length of stay (>10 nights)
  write_csv_utf8(full, f01c_panel)                                     # MAIN DATA (wide)

  nat <- aggregate(cbind(gelis_yerli, gelis_yabanci, geceleme_yerli, geceleme_yabanci, yatak) ~ tree + year + month,
                   data = full, FUN = function(z) if (all(is.na(z))) NA_real_ else sum(z, na.rm = TRUE), na.action = na.pass)  # national monthly total
  nat <- nat[order(nat$tree, nat$year, nat$month), ]
  yoy <- function(v, g) ave(v, g, FUN = function(z) round(100 * (z / c(rep(NA, 12), head(z, -12)) - 1), 1))  # year-on-year % change
  for (v in c("geceleme_yerli", "geceleme_yabanci", "yatak")) nat[[paste0("yoy_", v)]] <- yoy(nat[[v]], nat$tree)
  write_csv_utf8(nat, file.path(proj_dir, "step01c_national_monthly.csv"))

  bk <- full[full$tree == "bakanlik", ]; bk$t <- bk$year * 12 + bk$month
  win <- function(a, b) aggregate(cbind(geceleme_yerli, geceleme_yabanci, yatak) ~ il, bk[bk$t >= a & bk$t <= b, ],
                                  FUN = function(z) if (all(is.na(z))) NA_real_ else sum(z, na.rm = TRUE), na.action = na.pass)  # 12-month province total
  jump <- function(a0, b0, a1, b1, lab) {                              # province ratio for the 12 months before/after a break
    x <- merge(win(a0, b0), win(a1, b1), by = "il", suffixes = c("_once", "_sonra"))
    data.frame(kirilma = lab, il = x$il, oran_geceleme_yerli = round(x$geceleme_yerli_sonra / x$geceleme_yerli_once, 3),
               oran_geceleme_yabanci = round(x$geceleme_yabanci_sonra / x$geceleme_yabanci_once, 3),
               oran_yatak = round(x$yatak_sonra / x$yatak_once, 3), stringsAsFactors = FALSE)
  }
  jj <- rbind(jump(2021 * 12 + 11, 2022 * 12 + 10, 2022 * 12 + 11, 2023 * 12 + 10, "2022-11 basit belge"),
              jump(2024 * 12 + 7, 2025 * 12 + 6, 2025 * 12 + 7, 2026 * 12 + 6, "2025-07"))
  write_csv_utf8(jj, file.path(proj_dir, "step01c_break_jumps.csv"))  # provinces where capacity jumped
  cat("step01c -> genis panel satiri:", nrow(full), "| oran kontrol OK:", sum(rchk$status == "OK"), "/", nrow(rchk), "\n")
  }
})

# =====================================================================
# step01d: analysis panel (Ministry + municipal combined), coverage periods,
#          break flags, monthly/yearly growth (NA in break months)
# Breaks were identified from the step01c bed series:
#   2022-09: municipal establishments start moving into the Ministry series
#   2022-11: municipal series ends (remaining establishments leave the data)
#   2025-07: +274 thousand beds in a single month (Mugla, Antalya, Istanbul, Balikesir...)
# =====================================================================
f01d_panel <- file.path(proj_dir, "step01d_analysis_panel.csv")
log_warn("step01d", {
  if (csv_ok(f01d_panel)) message("step01d zaten yapilmis, atlaniyor.") else {
  full <- read_csv_utf8(f01c_panel)                                    # step01c wide panel
  days_in <- function(y, m) ifelse(m == 2 & y %% 4 == 0, 29, c(31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31)[m])
  full$yatak_gun <- full$yatak * days_in(full$year, full$month)        # beds x days (capacity)
  v <- c("gelis_yabanci", "gelis_yerli", "geceleme_yabanci", "geceleme_yerli", "yatak", "yatak_gun")
  agg <- aggregate(full[, v], by = list(il_key = full$il_key, year = full$year, month = full$month),
                   FUN = function(z) if (all(is.na(z))) NA_real_ else sum(z, na.rm = TRUE))  # Ministry + municipal total
  nb <- aggregate(list(n_seri = full$tree), by = list(il_key = full$il_key, year = full$year, month = full$month), FUN = length)
  agg <- merge(agg, nb, by = c("il_key", "year", "month"))
  il_ad <- unique(full[full$tree == "bakanlik", c("il_key", "il")])    # province names (Turkish)
  agg <- merge(il_ad, agg, by = "il_key")
  agg$t <- agg$year * 12 + agg$month                                   # time index
  agg$date <- sprintf("%04d-%02d", agg$year, agg$month)
  agg$donem <- ifelse(agg$t <= 2022 * 12 + 8, "A_2017_2022ag",          # Ministry + municipal full coverage
               ifelse(agg$t <= 2022 * 12 + 10, "T_gecis_2022",          # transition months (September-October 2022)
               ifelse(agg$t <= 2025 * 12 + 6, "B_2022ka_2025ha",        # operation-licensed + simple-certified
                      "C_2025tem_sonrasi")))                            # expanded coverage
  agg$doluluk_yerli   <- 100 * agg$geceleme_yerli / agg$yatak_gun      # domestic intensity per bed (%)
  agg$doluluk_yabanci <- 100 * agg$geceleme_yabanci / agg$yatak_gun    # foreign intensity per bed (%)
  agg <- agg[order(agg$il_key, agg$t), ]
  lg <- function(x) log(pmax(x, 0) + 1)                                # log(1+x): safe for zero values
  lagk <- function(x, g, k) ave(x, g, FUN = function(z) c(rep(NA, k), head(z, -k)))  # k-month lag within province
  brk <- c(2022 * 12 + 9, 2022 * 12 + 11, 2025 * 12 + 7)               # break months
  for (nm in c("geceleme_yerli", "geceleme_yabanci", "gelis_yerli", "gelis_yabanci", "yatak")) {
    x <- lg(agg[[nm]])
    mom <- x - lagk(x, agg$il_key, 1)                                  # monthly log growth
    mom[agg$t %in% brk] <- NA                                          # no growth is computed in a break month
    yoy <- x - lagk(x, agg$il_key, 12)                                 # year-on-year log growth (same month)
    yoy[sapply(agg$t, function(tt) any(tt >= brk & tt < brk + 12))] <- NA  # NA for the 12 months after a break
    agg[[paste0("dlog_m_", nm)]] <- round(mom, 6)
    agg[[paste0("dlog_y_", nm)]] <- round(yoy, 6)
  }
  fl <- full[, c("il_key", "year", "month", "flag_kalis", "doluluk_toplam")]
  fl$flag_dol100 <- as.integer(!is.na(fl$doluluk_toplam) & fl$doluluk_toplam > 100)  # occupancy > 100% (extra beds etc.)
  fl <- aggregate(fl[, c("flag_kalis", "flag_dol100")], by = fl[, c("il_key", "year", "month")], FUN = max)
  agg <- merge(agg, fl, by = c("il_key", "year", "month"), all.x = TRUE)
  agg <- agg[order(agg$il_key, agg$t), c("il", "il_key", "date", "year", "month", "t", "donem", "n_seri", v,
                                         "doluluk_yerli", "doluluk_yabanci", grep("^dlog_", names(agg), value = TRUE),
                                         "flag_kalis", "flag_dol100")]
  rownames(agg) <- NULL
  write_csv_utf8(agg, f01d_panel)                                      # ANALYSIS PANEL (81 provinces x 117 months)

  seg <- aggregate(agg[, c("geceleme_yerli", "geceleme_yabanci", "yatak")], by = list(donem = agg$donem, year = agg$year, month = agg$month), sum)
  seg <- aggregate(seg[, c("geceleme_yerli", "geceleme_yabanci", "yatak")], by = list(donem = seg$donem), mean)  # coverage-period mean (monthly)
  seg[, -1] <- round(seg[, -1])
  write_csv_utf8(seg, file.path(proj_dir, "step01d_donem_ozet.csv"))
  cat("step01d -> analiz paneli:", nrow(agg), "satir |", length(unique(agg$il_key)), "il |", length(unique(agg$t)), "ay\n")
  print(table(agg$donem) / length(unique(agg$il_key)))                 # number of months in each period
  }
})

# =====================================================================
# step02a: geographic proximity matrices (81 provinces)
#   Coordinates Option A: maps::world.cities (province centre, offline CRAN data)
#              Option B: GADM province boundaries -> representative point inside the boundary
#   Matrices: great-circle distance (km), kNN (k=5), inverse distance, contiguity (shared border, if GADM is available)
# =====================================================================
f02a_dist <- file.path(proj_dir, "step02a_dist_km.csv")
log_warn("step02a", {
  if (csv_ok(f02a_dist) && csv_ok(file.path(proj_dir, "step02a_W_knn5.csv"))) message("step02a zaten yapilmis, atlaniyor.") else {
  iller <- unique(read_csv_utf8(f01d_panel)[, c("il", "il_key")])      # 81 provinces (from the step01d panel)
  iller <- iller[order(iller$il_key), ]
  merkez <- c(agri = "Karakose", hatay = "Antakya", kocaeli = "Izmit", sakarya = "Adapazari", sanliurfa = "Urfa")  # province centres whose name differs from the province

  # ---- GADM boundaries (for contiguity; if both options fail, contiguity is skipped) ----
  gadm_sf <- NULL
  gfile <- file.path(proj_dir, "raw_gadm41_TUR_1.json")                # downloaded once, saved as a file in the project folder
  if (!file.exists(gfile) || file.info(gfile)$size < 1e4) {
    for (u in c("https://geodata.ucdavis.edu/gadm/gadm4.1/json/gadm41_TUR_1.json",
                "https://geodata.ucdavis.edu/gadm/gadm4.1/json/gadm41_TUR_1.json.zip")) {   # Option A: direct download
      tf <- tempfile()
      ok <- tryCatch(suppressWarnings(download.file(u, tf, mode = "wb", quiet = TRUE)) == 0, error = function(e) FALSE)
      if (!ok || !file.exists(tf) || file.info(tf)$size < 1e4) next
      if (identical(readBin(tf, "raw", 2), as.raw(c(0x50, 0x4B)))) {   # unzips to a temporary folder if zipped
        ex <- utils::unzip(tf, exdir = tempdir()); js <- ex[grepl("\\.json$", ex)][1]
        if (!is.na(js)) file.copy(js, gfile, overwrite = TRUE)
      } else file.copy(tf, gfile, overwrite = TRUE)
      if (file.exists(gfile) && file.info(gfile)$size > 1e4) break
    }
  }
  if (requireNamespace("sf", quietly = TRUE)) {
    if (file.exists(gfile) && file.info(gfile)$size > 1e4)
      gadm_sf <- tryCatch(sf::st_read(gfile, quiet = TRUE), error = function(e) NULL)
    if (is.null(gadm_sf) && requireNamespace("geodata", quietly = TRUE))  # Option B: geodata package (temporary folder)
      gadm_sf <- tryCatch(sf::st_as_sf(geodata::gadm("TUR", level = 1, path = tempdir(), version = "4.1")), error = function(e) NULL)
  }
  if (!is.null(gadm_sf)) {
    gal <- c(kinkkale = "kirikkale", zinguldak = "zonguldak", kmaras = "kahramanmaras", afyon = "afyonkarahisar")  # GADM spelling differences
    gk <- il_key(gadm_sf$NAME_1); gk <- ifelse(gk %in% names(gal), gal[gk], gk)
    miss <- setdiff(gk, iller$il_key)
    for (m in miss) { a <- agrep(m, iller$il_key, max.distance = 0.2, value = TRUE); if (length(a) == 1) gk[gk == m] <- a }  # approximate match
    gadm_sf$il_key <- gk
    if (!all(iller$il_key %in% gk) || anyDuplicated(gk)) { message("GADM il adlari eslesmedi, GADM kullanilmiyor"); gadm_sf <- NULL }
    else gadm_sf <- gadm_sf[match(iller$il_key, gadm_sf$il_key), ]
  }

  # ---- Coordinates ----
  co <- NULL
  if (!requireNamespace("maps", quietly = TRUE)) try(install.packages("maps"), silent = TRUE)  # small CRAN package
  if (requireNamespace("maps", quietly = TRUE)) {                      # Option A
    e <- new.env(); utils::data("world.cities", package = "maps", envir = e)  # data set in the package
    wc <- e$world.cities
    wc <- wc[wc$country.etc == "Turkey", ]
    wc <- wc[order(-wc$pop), ]; wc <- wc[!duplicated(wc$name), ]       # the largest of towns with the same name
    nm <- ifelse(iller$il_key %in% names(merkez), merkez[iller$il_key], NA)
    wk <- il_key(wc$name)
    idx <- ifelse(is.na(nm), match(iller$il_key, wk), match(nm, wc$name))
    if (!any(is.na(idx))) co <- data.frame(iller, lat = wc$lat[idx], lon = wc$long[idx],
                                           kaynak = paste0("maps::world.cities (", wc$name[idx], ")"), stringsAsFactors = FALSE)
    else message("world.cities'te bulunamayan iller: ", paste(iller$il_key[is.na(idx)], collapse = ", "))
  }
  if (is.null(co) && !is.null(gadm_sf)) {                              # Option B: GADM representative point
    pt <- sf::st_coordinates(suppressWarnings(sf::st_point_on_surface(sf::st_make_valid(gadm_sf))))
    co <- data.frame(iller, lat = pt[, 2], lon = pt[, 1], kaynak = "GADM point_on_surface", stringsAsFactors = FALSE)
  }
  if (is.null(co)) stop("Koordinat bulunamadi (maps paketi ve GADM ikisi de olmadi)")

  # ---- Distances and W matrices ----
  hav <- function(la1, lo1, la2, lo2) {                                # great-circle distance (km), haversine
    r <- pi / 180; a <- sin((la2 - la1) * r / 2)^2 + cos(la1 * r) * cos(la2 * r) * sin((lo2 - lo1) * r / 2)^2
    2 * 6371 * asin(pmin(1, sqrt(a)))
  }
  n <- nrow(co)
  D <- outer(seq_len(n), seq_len(n), function(i, j) hav(co$lat[i], co$lon[i], co$lat[j], co$lon[j]))
  dimnames(D) <- list(co$il_key, co$il_key)
  rowstd <- function(W) { s <- rowSums(W); W / ifelse(s == 0, 1, s) } # row standardisation
  Wk <- matrix(0, n, n, dimnames = dimnames(D))
  for (i in seq_len(n)) Wk[i, order(D[i, ])[2:6]] <- 1                 # 5 nearest provinces (excluding itself)
  Wk <- rowstd(Wk)
  Wi <- 1 / D; diag(Wi) <- 0; Wi <- rowstd(Wi)                         # inverse distance
  mat_df <- function(M) data.frame(il_key = rownames(M), round(M, 6), check.names = FALSE)
  write_csv_utf8(co, file.path(proj_dir, "step02a_il_coords.csv"))
  write_csv_utf8(mat_df(D), f02a_dist)
  write_csv_utf8(mat_df(Wk), file.path(proj_dir, "step02a_W_knn5.csv"))
  write_csv_utf8(mat_df(Wi), file.path(proj_dir, "step02a_W_invdist.csv"))

  Wc <- NULL
  if (!is.null(gadm_sf)) {                                             # shared-border contiguity
    g2 <- sf::st_make_valid(gadm_sf)
    nb <- tryCatch(if (requireNamespace("spdep", quietly = TRUE)) spdep::poly2nb(g2, queen = TRUE, snap = 1e-3) else NULL,
                   error = function(e) NULL)                           # Option A: spdep
    Wc <- matrix(0, n, n, dimnames = dimnames(D))
    if (!is.null(nb)) { for (i in seq_len(n)) if (nb[[i]][1] != 0) Wc[i, nb[[i]]] <- 1 }
    else { tt <- sf::st_intersects(sf::st_buffer(g2, 0.005)); for (i in seq_len(n)) Wc[i, setdiff(tt[[i]], i)] <- 1 }  # Option B: sf
    write_csv_utf8(mat_df(rowstd(Wc)), file.path(proj_dir, "step02a_W_contig.csv"))
  }

  nn <- t(sapply(seq_len(n), function(i) co$il[order(D[i, ])[2:6]]))   # 5 nearest provinces of each province (for checking)
  chk <- data.frame(il = co$il, lat = co$lat, lon = co$lon, en_yakin_5 = apply(nn, 1, paste, collapse = " | "),
                    yakin1_km = round(apply(D, 1, function(r) sort(r)[2]), 1),
                    n_komsu = if (is.null(Wc)) NA else rowSums(Wc),
                    komsular = if (is.null(Wc)) "" else apply(Wc, 1, function(r) paste(co$il[r > 0], collapse = " | ")),
                    stringsAsFactors = FALSE)
  write_csv_utf8(chk, file.path(proj_dir, "step02a_check.csv"))
  cat("step02a -> koordinat kaynagi:", sub(" \\(.*", "", co$kaynak[1]), "| komsuluk matrisi:", ifelse(is.null(Wc), "YOK (GADM indirilemedi)", "VAR"), "\n")
  cat("  ornek: Denizli-Nevsehir", round(D["denizli", "nevsehir"]), "km | Istanbul-Ankara", round(D["istanbul", "ankara"]), "km\n")
  }
})

# =====================================================================
# step02b0: DISCOVERY step for tour sites (preparation of the itinerary matrix)
#   Purpose: fetch the HTML of the listing and sample tour detail pages of each site,
#   so that the parser can be written on real HTML. All HTML is stored in ONE file.
#   Domestic itineraries: Jolly, Setur, Tatil Sepeti | International: On The Go, TourRadar, kimkim
#   robots.txt is checked; a page is not downloaded if not allowed. 2 s between requests.
# =====================================================================
f02b0 <- file.path(proj_dir, "step02b0_site_discovery.csv")
log_warn("step02b0", {
  done02b0 <- csv_ok(f02b0) && any(suppressWarnings(as.numeric(read_csv_utf8(f02b0)$status)) == 200, na.rm = TRUE)  # at least one page downloaded?
  if (done02b0) message("step02b0 zaten yapilmis, atlaniyor.") else {
  seeds <- data.frame(stringsAsFactors = FALSE,
    site = c("jollytur", "jollytur", "setur", "setur", "tatilsepeti", "tatilsepeti", "onthegotours", "tourradar", "kimkim"),
    pazar = c("yerli", "yerli", "yerli", "yerli", "yerli", "yerli", "yabanci", "yabanci", "yabanci"),
    url = c("https://www.jollytur.com/yurtici-turlar",
            "https://www.jollytur.com/yurtici-turlar?Sayfa=2",
            "https://www.setur.com.tr/yurtici-kultur-turlari",
            "https://www.setur.com.tr/ucakli-kultur-turlari",
            "https://www.tatilsepeti.com/kultur-turlari",
            "https://www.tatilsepeti.com/kapadokya-konya-ve-pamukkale-turu-tr-133977",
            "https://www.onthegotours.com/Turkey",
            "https://www.tourradar.com/d/turkey",
            "https://www.kimkim.com/d/turkey/tours"),
    detay = c("jollytur\\.com/[a-z0-9-]*(turu|tur)[a-z0-9-]*$", "jollytur\\.com/[a-z0-9-]*(turu|tur)[a-z0-9-]*$",
              "setur\\.com\\.tr/[a-z0-9-]*-turu[a-z0-9-]*$", "setur\\.com\\.tr/[a-z0-9-]*-turu[a-z0-9-]*$",
              "tatilsepeti\\.com/[a-z0-9-]*-tr-[0-9]+$", "tatilsepeti\\.com/[a-z0-9-]*-tr-[0-9]+$",
              "onthegotours\\.com/(.*/)?Turkey/[A-Za-z0-9-]+-[0-9]+-days$", "tourradar\\.com/t/[0-9]+$",
              "kimkim\\.com/c/[a-z0-9-]+$"))
  get_html <- function(u) {                                            # page HTML (Option A httr, Option B base R)
    r <- tryCatch(httr::GET(u, httr::user_agent(ua), httr::timeout(60)), error = function(e) NULL)
    if (!is.null(r)) return(list(status = httr::status_code(r),
                                 html = if (httr::status_code(r) == 200) raw_to_text(httr::content(r, as = "raw")) else ""))
    tf <- tempfile(fileext = ".html")
    ok <- tryCatch(suppressWarnings(download.file(u, tf, mode = "wb", quiet = TRUE)) == 0, error = function(e) FALSE)
    if (ok && file.exists(tf)) list(status = 200, html = raw_to_text(readBin(tf, "raw", file.info(tf)$size)))
    else list(status = NA, html = "")
  }
  robots_ok <- function(u) {                                           # does robots.txt allow it
    a <- tryCatch(if (requireNamespace("robotstxt", quietly = TRUE)) robotstxt::paths_allowed(u, user_agent = "*", warn = FALSE) else NA,
                  error = function(e) NA)                              # Option A: robotstxt package
    if (!is.na(a)) return(a)
    host <- sub("^(https?://[^/]+).*", "\\1", u); path <- sub("^https?://[^/]+", "", u); if (!nzchar(path)) path <- "/"
    rb <- get_html(paste0(host, "/robots.txt"))                        # Option B: reads robots.txt manually
    if (is.na(rb$status) || rb$status != 200) return(TRUE)             # if there is no robots.txt, access is assumed to be allowed
    L <- strsplit(rb$html, "\r?\n")[[1]]; L <- trimws(sub("#.*", "", L))
    ua_i <- which(grepl("^user-agent:\\s*\\*$", tolower(L)))           # "User-agent: *" block
    if (!length(ua_i)) return(TRUE)
    blk <- L[(ua_i[1] + 1):length(L)]; stop_i <- which(grepl("^user-agent:", tolower(blk)))[1]
    if (!is.na(stop_i)) blk <- blk[seq_len(stop_i - 1)]
    dis <- trimws(sub("^disallow:", "", blk[grepl("^disallow:", tolower(blk))], ignore.case = TRUE))
    dis <- dis[nzchar(dis)]
    !any(vapply(dis, function(d) startsWith(path, sub("\\*.*$", "", d)), logical(1)))
  }
  il_pat <- unique(safe_key(read_csv_utf8(f01d_panel)$il))             # 81 province names (ASCII, lower case)
  count_il <- function(txt) {                                          # number of different province names in the page text
    k <- safe_key(gsub("<[^>]+>", " ", txt))
    sum(vapply(il_pat, function(p) grepl(paste0("\\b", p, "\\b"), k), logical(1)))
  }
  store <- list(); rows <- list()
  fetch <- function(site, pazar, tip, u) {
    rok <- robots_ok(u); Sys.sleep(2)
    res <- if (isTRUE(rok)) get_html(u) else list(status = NA, html = "")
    Sys.sleep(2)
    store[[u]] <<- res$html
    rows[[length(rows) + 1]] <<- data.frame(site = site, pazar = pazar, tip = tip, url = u, robots_izin = rok,
      status = res$status, n_karakter = nchar(res$html, type = "bytes"), n_il_adi = if (nzchar(res$html)) count_il(res$html) else NA,
      stringsAsFactors = FALSE)
    res$html
  }
  for (i in seq_len(nrow(seeds))) {
    h <- fetch(seeds$site[i], seeds$pazar[i], "liste", seeds$url[i])
    if (!nzchar(h)) next
    L <- tryCatch(parse_raw(h), error = function(e) NULL)              # links on the page
    if (is.null(L)) next
    host <- sub("^(https?://[^/]+).*", "\\1", seeds$url[i])
    hr <- sub("[?#].*$", "", ifelse(grepl("^https?://", L$href), L$href, paste0(host, ifelse(grepl("^/", L$href), "", "/"), L$href)))
    det <- unique(hr[grepl(seeds$detay[i], hr, perl = TRUE)])          # links to tour detail pages
    det <- setdiff(det, sub("[?#].*$", "", seeds$url))                # extracts listing pages
    det <- det[order(!grepl("[0-9]", sub(".*/", "", det)))]            # links ending in a number (real tours) first
    rows[[length(rows)]]$n_detay_link <- length(det)
    rows[[length(rows)]]$ornek_link <- paste(head(det, 3), collapse = " | ")
    for (u in head(setdiff(det, names(store)), 3)) fetch(seeds$site[i], seeds$pazar[i], "detay", u)  # 3 sample detail pages from each listing
  }
  rows <- lapply(rows, function(r) { if (is.null(r$n_detay_link)) r$n_detay_link <- NA; if (is.null(r$ornek_link)) r$ornek_link <- ""; r })
  out <- do.call(rbind, rows)
  saveRDS(store, file.path(proj_dir, "raw_step02b0_html.rds"))         # ALL HTML in one file
  write_csv_utf8(out, f02b0)
  cat("step02b0 -> sayfa:", nrow(out), "| basarili (200):", sum(out$status == 200, na.rm = TRUE),
      "| robots izin yok:", sum(out$robots_izin %in% FALSE), "\n")
  }
})

# =====================================================================
# step02b1: COLLECTION of tour programmes (domestic: Jolly, Setur, Tatil Sepeti | international: TourRadar)
#   Only route information is kept for each tour (day-by-day route / places visited / provinces)
#   RESUMES WHERE IT STOPPED: if interrupted, a re-run skips pages already downloaded
#   Expected time on the first run 30-45 min (1.5 s between requests, follows robots.txt)
# =====================================================================
utf8_keep <- function(x) {                                             # converts to UTF-8 but KEEPS line breaks
  y <- iconv(x, from = "UTF-8", to = "UTF-8", sub = "")
  bad <- is.na(y); if (any(bad)) y[bad] <- iconv(x[bad], from = "windows-1254", to = "UTF-8", sub = "")
  y[is.na(y)] <- ""; Encoding(y) <- "UTF-8"; y
}
dec_ent <- function(x) {                                               # decodes HTML character codes (&#x130; &#252; &amp;)
  x <- utf8_keep(x)
  m <- gregexpr("&#[xX]?[0-9A-Fa-f]+;", x)
  regmatches(x, m) <- lapply(regmatches(x, m), function(v) vapply(v, function(e) {
    n <- sub("^&#([xX]?[0-9A-Fa-f]+);$", "\\1", e)
    cp <- if (grepl("^[xX]", n)) strtoi(substring(n, 2), 16L) else suppressWarnings(as.integer(n))
    if (is.na(cp)) "" else intToUtf8(cp)
  }, character(1)))
  for (p in list(c("&amp;", "&"), c("&quot;", "\""), c("&lt;", "<"), c("&gt;", ">"), c("&apos;", "'"), c("&nbsp;", " "),
                 c("&rsquo;", "'"), c("&lsquo;", "'"), c("&ndash;", "-"), c("&mdash;", "-"), c("&hellip;", "...")))
    x <- gsub(p[1], p[2], x, fixed = TRUE)
  x
}
html_lines <- function(h) {                                            # HTML -> clean text lines
  h <- gsub("(?s)<script.*?</script>|<style.*?</style>|<!--.*?-->", " ", h, perl = TRUE)
  h <- gsub("(?i)<br\\s*/?>|</p>|</li>|</h[1-6]>|</div>|</tr>", "\n", h, perl = TRUE)
  h <- gsub("<[^>]+>", " ", h)
  L <- strsplit(dec_ent(h), "\n", fixed = TRUE)[[1]]
  L <- trimws(gsub("[ \t\r\u00a0]+", " ", L))
  L[nzchar(L)]
}
json_unesc <- function(x) {                                            # decodes escapes such as \u00e7 inside JSON
  if (is.na(x)) return(x)
  m <- gregexpr("\\\\u[0-9A-Fa-f]{4}", x)
  regmatches(x, m) <- lapply(regmatches(x, m), function(v) vapply(v, function(e) intToUtf8(strtoi(substring(e, 3), 16L)), character(1)))
  gsub("\\\\(.)", "\\1", x)
}
rx1 <- function(h, p) { m <- regmatches(h, regexpr(p, h, perl = TRUE)); if (length(m)) sub(p, "\\1", m, perl = TRUE) else NA_character_ }
ld_blocks <- function(h) {                                             # JSON-LD blocks
  x <- regmatches(h, gregexpr("(?s)<script[^>]*application/ld\\+json[^>]*>(.*?)</script>", h, perl = TRUE))[[1]]
  x <- sub("(?s)^<script[^>]*>(.*)</script>$", "\\1", x, perl = TRUE)
  lapply(x, function(j) tryCatch(jsonlite::fromJSON(sub(";\\s*$", "", trimws(j)), simplifyVector = FALSE), error = function(e) NULL))
}
ld_name <- function(h, type) {
  for (b in ld_blocks(h)) if (is.list(b) && identical(b[["@type"]], type) && !is.null(b$name)) return(to_utf8(b$name))
  NA_character_
}
extract_tour <- function(site, u, h) {                                 # tour information and day-by-day route by site type
  days <- data.frame(gun = integer(0), rota = character(0), noktalar = character(0), stringsAsFactors = FALSE)
  title <- NA_character_; origin <- NA_character_; extra <- NA_character_; tip <- NA_character_
  if (site == "jollytur") {                                            # "1.Gun Tur Guzergahi Istanbul Nevsehir"
    title <- ld_name(h, "LodgingBusiness")
    L <- html_lines(h)
    i <- grep("^[0-9]+\\.\\s*G\u00fcn\\s*Tur G\u00fczergah\u0131", L)
    if (length(i)) {
      nk <- vapply(i, function(k) if (k < length(L) && grepl("^G\u00fcn\u00fcn Gezi Noktalar\u0131", L[k + 1]))
        sub("^G\u00fcn\u00fcn Gezi Noktalar\u0131\\s*:?\\s*", "", L[k + 1]) else "", character(1))
      days <- data.frame(gun = as.integer(sub("\\..*$", "", L[i])),
                         rota = sub("^[0-9]+\\.\\s*G\u00fcn\\s*Tur G\u00fczergah\u0131\\s*", "", L[i]), noktalar = nk, stringsAsFactors = FALSE)
    }
  } else if (site == "tatilsepeti") {                                  # "1. Gun" + next line: places visited
    title <- ld_name(h, "LodgingBusiness")
    L <- html_lines(h)
    i <- grep("^[0-9]+\\.\\s*G\u00fcn$", L); i <- i[i < length(L)]
    if (length(i)) days <- data.frame(gun = as.integer(sub("\\..*$", "", L[i])), rota = L[i + 1], noktalar = "", stringsAsFactors = FALSE)
  } else if (site == "setur") {                                        # "cities" list in the page data (province names)
    title <- json_unesc(rx1(h, "\\\\\"initialData\\\\\":\\{\\\\\"id\\\\\":[0-9]+,\\\\\"name\\\\\":\\\\\"(.*?)\\\\\""))
    tip <- rx1(h, "\\\\\"type\\\\\":\\\\\"([A-Za-z]+)\\\\\",\\\\\"secure")
    seg <- rx1(h, "\\\\\"cities\\\\\":\\[(.*?)\\]")
    cities <- if (is.na(seg)) character(0) else vapply(sub(".*\\\\\"value\\\\\":\\\\\"(.*?)\\\\\".*", "\\1",
                 regmatches(seg, gregexpr("\\\\\"value\\\\\":\\\\\"(.*?)\\\\\"", seg, perl = TRUE))[[1]], perl = TRUE), json_unesc, character(1))
    extra <- json_unesc(rx1(h, "\\\\\"placesToGo\\\\\":\\\\\"(.*?)\\\\\""))
    if (length(cities)) days <- data.frame(gun = 0L, rota = paste(cities, collapse = ", "), noktalar = ifelse(is.na(extra), "", extra), stringsAsFactors = FALSE)
  } else if (site == "tourradar") {                                    # JSON-LD TouristTrip itinerary
    for (b in ld_blocks(h)) if (is.list(b) && identical(b[["@type"]], "TouristTrip")) {
      title <- to_utf8(b$name); origin <- if (!is.null(b$tripOrigin$name)) to_utf8(b$tripOrigin$name) else NA
      it <- b$itinerary$itemListElement
      if (length(it)) days <- data.frame(gun = vapply(it, function(e) as.integer(if (is.null(e$position)) NA else e$position), integer(1)),
                                         rota = vapply(it, function(e) to_utf8(if (is.null(e$item$name)) "" else e$item$name), character(1)),
                                         noktalar = vapply(it, function(e) { d <- if (is.null(e$item$description)) "" else e$item$description
                                           to_utf8(sub(".*Landmarks\\s*", "", d)) }, character(1)), stringsAsFactors = FALSE)
    }
  }
  if (is.na(origin) && !is.na(title)) origin <- rx1(title, "(?i)([^\\s]+)\\s+\u00c7\u0131k\u0131\u015fl\u0131")  # "X Cikisli" (departure city)
  list(tur = data.frame(site = site, url = u, baslik = title, kalkis = origin, tip = tip, ek_bilgi = extra,
                        n_gun = nrow(days), stringsAsFactors = FALSE),
       gun = if (nrow(days)) cbind(site = site, url = u, days, stringsAsFactors = FALSE) else NULL)
}
list_links <- function(site, h) {                                      # tour detail links on the listing page
  grab <- function(p, pre) { a <- regmatches(h, gregexpr(p, h, perl = TRUE))[[1]]; if (!length(a)) return(character(0))
    paste0(pre, unique(sub(p, "\\1", a, perl = TRUE))) }
  if (site == "jollytur") grab("data-url=\"(/[^\"]+)\"", "https://www.jollytur.com")
  else if (site == "tatilsepeti") grab("href=\"(/[a-z0-9-]+-tr-[0-9]+)\"", "https://www.tatilsepeti.com")
  else if (site == "setur") grab("href=\"(/[a-z0-9-]*-turu[a-z0-9-]*)\"", "https://www.setur.com.tr")
  else if (site == "tourradar") {
    ids <- rx1(h, "toursIDs'\\] = \\[([0-9, ]+)\\]")
    ids <- if (is.na(ids)) character(0) else trimws(strsplit(ids, ",")[[1]])
    unique(c(if (length(ids)) paste0("https://www.tourradar.com/t/", ids), grab("href=\"(/t/[0-9]+)\"", "https://www.tourradar.com")))
  } else character(0)
}
robots_cache <- new.env()
robots_allow <- function(u) {                                          # robots.txt (read once per site)
  host <- sub("^(https?://[^/]+).*", "\\1", u); path <- sub("^https?://[^/]+", "", u); if (!nzchar(path)) path <- "/"
  if (is.null(robots_cache[[host]])) {
    r <- tryCatch(httr::GET(paste0(host, "/robots.txt"), httr::user_agent(ua), httr::timeout(30)), error = function(e) NULL)
    txt <- if (!is.null(r) && httr::status_code(r) == 200) raw_to_text(httr::content(r, as = "raw")) else ""
    L <- trimws(sub("#.*", "", strsplit(utf8_keep(txt), "\r?\n")[[1]]))
    ua_i <- which(grepl("^user-agent:\\s*\\*$", tolower(L))); dis <- character(0)
    if (length(ua_i)) { blk <- L[(ua_i[1] + 1):length(L)]; st <- which(grepl("^user-agent:", tolower(blk)))[1]
      if (!is.na(st)) blk <- blk[seq_len(st - 1)]
      dis <- trimws(sub("^disallow:", "", blk[grepl("^disallow:", tolower(blk))], ignore.case = TRUE)); dis <- dis[nzchar(dis)] }
    robots_cache[[host]] <- dis
  }
  dis <- robots_cache[[host]]
  !any(vapply(dis, function(d) { d0 <- sub("\\*.*$", "", d); nzchar(d0) && startsWith(path, d0) }, logical(1)))
}
get_page <- function(u) {                                              # page (Option A httr, Option B base R), 1.5 s wait
  Sys.sleep(1.5)
  r <- tryCatch(httr::GET(u, httr::user_agent(ua), httr::timeout(60)), error = function(e) NULL)
  if (!is.null(r)) return(list(status = httr::status_code(r), html = if (httr::status_code(r) == 200) raw_to_text(httr::content(r, as = "raw")) else ""))
  tf <- tempfile(fileext = ".html")
  ok <- tryCatch(suppressWarnings(download.file(u, tf, mode = "wb", quiet = TRUE)) == 0, error = function(e) FALSE)
  if (ok && file.exists(tf)) list(status = 200L, html = raw_to_text(readBin(tf, "raw", file.info(tf)$size))) else list(status = NA_integer_, html = "")
}

f02b1_tours <- file.path(proj_dir, "step02b1_tours.csv")
f02b1_cache <- file.path(proj_dir, "raw_step02b1_cache.rds")              # intermediate save (to resume where it stopped)
log_warn("step02b1", {
  cache <- if (file.exists(f02b1_cache)) readRDS(f02b1_cache) else list(list_done = character(0), links = data.frame(site = character(0), pazar = character(0), url = character(0), stringsAsFactors = FALSE), detail = list(), complete = FALSE)
  if (isTRUE(cache$complete) && csv_ok(f02b1_tours)) message("step02b1 zaten yapilmis, atlaniyor.") else {
  plan <- list(                                                        # site, market, listing pages, maximum number of detail pages
    list(site = "jollytur", pazar = "yerli", lists = paste0("https://www.jollytur.com/yurtici-turlar?Sayfa=", 1:25), maxd = 450),
    list(site = "tatilsepeti", pazar = "yerli", lists = paste0("https://www.tatilsepeti.com/kultur-turlari?sayfa=", 1:12), maxd = 350),
    list(site = "setur", pazar = "yerli", lists = paste0("https://www.setur.com.tr/", c("yurtici-kultur-turlari", "ucakli-kultur-turlari",
         "kapadokya-turlari", "mardin-turlari", "likya-turlari", "dogu-anadolu-turlari", "seb-i-arus-turlari", "karadeniz-turlari",
         "gap-turlari", "turistik-dogu-ekspresi-turlari", "butik-turlar")), maxd = 150),
    list(site = "tourradar", pazar = "yabanci", lists = c(paste0("https://www.tourradar.com/d/turkey?page=", 1:12),
         paste0("https://www.tourradar.com/", c("n/turkey-7-day", "n/turkey-10-day", "n/turkey-2-week", "i/turkey-in-depth-cultural",
         "i/turkey-fully-guided", "i/turkey-coach-bus", "i/turkey-private", "i/turkey-adventure", "i/turkey-hiking-trekking",
         "i/turkey-self-guided", "i/turkey-family", "l/d-budget-turkey", "l/d-luxury-turkey", "c/small-group-tours-turkey",
         "v/region-western-turkey", "v/region-eastern-turkey", "a/turkey-tours-istanbul", "a/turkey-tours-antalya"))), maxd = 300))
  logs <- list()
  for (p in plan) {                                                    # ---- 1) listing pages -> tour links
    n_new_zero <- 0
    for (lu in p$lists) {
      if (lu %in% cache$list_done) next
      if (!robots_allow(lu)) { cache$list_done <- c(cache$list_done, lu); next }
      pg <- get_page(lu)
      l <- if (identical(pg$status, 200L) || identical(pg$status, 200)) list_links(p$site, pg$html) else character(0)
      new <- setdiff(l, cache$links$url)
      if (length(new)) cache$links <- rbind(cache$links, data.frame(site = p$site, pazar = p$pazar, url = new, stringsAsFactors = FALSE))
      cache$list_done <- c(cache$list_done, lu)
      n_new_zero <- if (length(new)) 0 else n_new_zero + 1
      if (grepl("[?&](Sayfa|sayfa|page)=", lu) && n_new_zero >= 2) {   # stops paging after 2 consecutive pages without new tours
        rest <- p$lists[grepl("[?&](Sayfa|sayfa|page)=", p$lists) & !(p$lists %in% cache$list_done)]
        cache$list_done <- c(cache$list_done, rest)
      }
    }
    saveRDS(cache, f02b1_cache)
    cat("  ", p$site, "-> bulunan tur linki:", sum(cache$links$site == p$site), "\n")
  }
  todo <- cache$links[!(cache$links$url %in% names(cache$detail)), ]   # ---- 2) tour detail pages
  todo <- do.call(rbind, lapply(split(todo, todo$site), function(d) {
    mx <- vapply(plan, function(p) if (p$site == d$site[1]) p$maxd else NA_real_, numeric(1)); mx <- mx[!is.na(mx)][1]
    done_n <- sum(names(cache$detail) %in% cache$links$url[cache$links$site == d$site[1]])
    head(d, max(0, mx - done_n)) }))
  if (!is.null(todo) && nrow(todo)) {
    cat("  indirilecek tur sayfasi:", nrow(todo), "(yaklasik", round(nrow(todo) * 2.3 / 60), "dk)\n")
    for (k in seq_len(nrow(todo))) {
      u <- todo$url[k]
      if (!robots_allow(u)) { cache$detail[[u]] <- list(status = "robots", tur = NULL, gun = NULL); next }
      pg <- get_page(u)
      ex <- if (!is.na(pg$status) && pg$status == 200) tryCatch(extract_tour(todo$site[k], u, pg$html), error = function(e) NULL) else NULL
      cache$detail[[u]] <- list(status = pg$status, tur = ex$tur, gun = ex$gun)
      if (k %% 20 == 0) { saveRDS(cache, f02b1_cache); cat("    tur sayfasi:", k, "/", nrow(todo), "\n") }
    }
  }
  cache$complete <- TRUE
  saveRDS(cache, f02b1_cache)

  tours <- do.call(rbind, lapply(cache$detail, function(d) d$tur))     # ---- 3) outputs
  days  <- do.call(rbind, lapply(cache$detail, function(d) d$gun))
  tours <- merge(cache$links, tours, by = c("site", "url"), all.y = TRUE)
  st <- data.frame(url = names(cache$detail), status = vapply(cache$detail, function(d) as.character(d$status), character(1)), stringsAsFactors = FALSE)
  lg <- merge(cache$links, st, by = "url", all.x = TRUE)
  lg <- aggregate(list(n_link = lg$url), by = list(site = lg$site), FUN = length)
  lg$n_indirilen <- vapply(lg$site, function(s0) sum(st$status == "200" & st$url %in% cache$links$url[cache$links$site == s0]), integer(1))
  lg$n_rotali <- vapply(lg$site, function(s0) sum(tours$site == s0 & tours$n_gun > 0, na.rm = TRUE), integer(1))
  write_csv_utf8(tours, f02b1_tours)
  write_csv_utf8(days, file.path(proj_dir, "step02b1_tour_days.csv"))
  write_csv_utf8(lg, file.path(proj_dir, "step02b1_crawl_log.csv"))
  cat("step02b1 -> tur:", nrow(tours), "| rotasi okunan:", sum(tours$n_gun > 0, na.rm = TRUE), "| gun satiri:", nrow(days), "\n")
  print(lg)
  }
})

