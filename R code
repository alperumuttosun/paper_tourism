# =====================================================================
# step03a: SPILLOVER models - space-time panel regression
#   g_it = province effect + month effect + rho*g_i,t-1 + bG*(W_geo g)_t-1 + bR*(W_itinerary g)_t-1 + e
#   g: year-on-year log growth (same month, no seasonality); 12 months after a break are already NA (step01d)
#   Month fixed effects absorb all national shocks (COVID, earthquake, exchange rate) -> remaining inter-provincial spillover
#   Standard errors clustered by province. Option A: sandwich package, Option B: manual calculation
# =====================================================================
f03a <- file.path(proj_dir, "step03a_slx_results.csv")
log_warn("step03a", {
  if (csv_ok(f03a)) message("step03a zaten yapilmis, atlaniyor.") else {
  pn <- read_csv_utf8(f01d_panel)
  ik <- sort(unique(pn$il_key)); tt <- sort(unique(pn$t))
  readW <- function(f) { M <- as.matrix(read_csv_utf8(file.path(proj_dir, f))[, -1]); rn <- read_csv_utf8(file.path(proj_dir, f))$il_key
    dimnames(M) <- list(rn, rn); M[ik, ik] }                           # province order as in the panel
  Ws <- list(knn5 = readW("step02a_W_knn5.csv"), komsu = readW("step02a_W_contig.csv"), ters_uzak = readW("step02a_W_invdist.csv"),
             rota_yerli = readW("step02b2_W_route_yerli.csv"), rota_yabanci = readW("step02b2_W_route_yabanci.csv"))
  wlag <- function(W, y) {                                             # W*y, reweighted after dropping missing neighbours
    G <- matrix(NA_real_, length(ik), length(tt), dimnames = list(ik, as.character(tt)))
    G[cbind(match(pn$il_key, ik), match(pn$t, tt))] <- y
    M <- !is.na(G); G0 <- G; G0[!M] <- 0
    num <- W %*% G0; den <- W %*% (M * 1)
    out <- ifelse(den > 0, num / den, NA)
    out[rowSums(W) == 0, ] <- 0                                        # provinces outside the itinerary network: 0 (absorbed by the province effect)
    lagm <- cbind(NA, out[, -ncol(out), drop = FALSE])                 # one-month lag
    lagm[cbind(match(pn$il_key, ik), match(pn$t, tt))]
  }
  own_lag <- function(y) { G <- matrix(NA_real_, length(ik), length(tt)); G[cbind(match(pn$il_key, ik), match(pn$t, tt))] <- y
    L <- cbind(NA, G[, -ncol(G), drop = FALSE]); L[cbind(match(pn$il_key, ik), match(pn$t, tt))] }
  clus_se <- function(fit, cl) {                                       # province-clustered standard error
    if (requireNamespace("sandwich", quietly = TRUE))                  # Option A
      return(sqrt(diag(sandwich::vcovCL(fit, cluster = cl, type = "HC1"))))
    X <- model.matrix(fit); e <- resid(fit); XtXi <- solve(crossprod(X))  # Option B: manual CR1
    meat <- Reduce(`+`, lapply(split(seq_along(e), cl), function(ix) { s <- crossprod(X[ix, , drop = FALSE], e[ix]); s %*% t(s) }))
    G <- length(unique(cl)); n <- length(e); k <- ncol(X)
    sqrt(diag(XtXi %*% meat %*% XtXi) * G / (G - 1) * (n - 1) / (n - k))
  }
  specs <- list(                                                       # model name -> W matrices used
    M1_cografi = c("knn5"), M2_rota = c("rota"), M3_ikisi = c("knn5", "rota"),
    M4_komsu_rota = c("komsu", "rota"), M5_tersuzak_rota = c("ters_uzak", "rota"), M6_plasebo_diger_rota = c("knn5", "rota_diger"))
  uye <- list(rota_yerli = rowSums(Ws$rota_yerli) > 0, rota_yabanci = rowSums(Ws$rota_yabanci) > 0)  # provinces on the itinerary network
  fit_one <- function(d, v, fe_extra) {                                 # single model: province + month (+ network member x month) fixed effects
    f <- as.formula(paste("y ~ ylag +", paste(v, collapse = " + "), "+ il + ay", if (length(fe_extra)) paste("+", paste(fe_extra, collapse = " + ")) else ""))
    lm(f, data = d)
  }
  res <- list(); cors <- list(); perm <- list()
  set.seed(20261111)                                                   # makes the permutation test reproducible
  for (mk in c("yerli", "yabanci")) {
    other <- setdiff(c("yerli", "yabanci"), mk)
    for (oc in c("dlog_y_geceleme_", "dlog_y_gelis_")) {
      yv <- paste0(oc, mk); y <- pn[[yv]]
      lagv <- list(knn5 = wlag(Ws$knn5, y), komsu = wlag(Ws$komsu, y), ters_uzak = wlag(Ws$ters_uzak, y),
                   rota = wlag(Ws[[paste0("rota_", mk)]], y), rota_diger = wlag(Ws[[paste0("rota_", other)]], y))
      ii <- match(pn$il_key, ik)
      d0 <- data.frame(y = y, ylag = own_lag(y), il = factor(pn$il_key), ay = factor(pn$t), lagv,
                       fe_rota = factor(paste(uye[[paste0("rota_", mk)]][ii], pn$t)),      # itinerary network member x month
                       fe_rota_diger = factor(paste(uye[[paste0("rota_", other)]][ii], pn$t)))
      cm <- suppressWarnings(cor(d0[, names(lagv)], use = "pairwise.complete.obs"))
      cors[[paste(mk, oc)]] <- data.frame(pazar = mk, sonuc = yv, w1 = rep(rownames(cm), ncol(cm)), w2 = rep(colnames(cm), each = nrow(cm)),
                                          r = round(as.vector(cm), 3), stringsAsFactors = FALSE)
      for (fe_mode in c("il_ay", "il_ay_agxay")) {                     # agxay: separate month effects for network members (control for common tourism shocks)
        for (sn in names(specs)) {
          v <- specs[[sn]]
          rv <- intersect(v, c("rota", "rota_diger"))
          fe_extra <- if (fe_mode == "il_ay_agxay" && length(rv)) paste0("fe_", rv) else character(0)
          d <- d0[complete.cases(d0[, c("y", "ylag", v)]), ]
          fit <- fit_one(d, v, fe_extra)
          se <- clus_se(fit, d$il)
          for (term in c("ylag", v)) {
            b <- coef(fit)[[term]]; s <- se[[term]]
            res[[length(res) + 1]] <- data.frame(pazar = mk, sonuc = yv, sabit_etki = fe_mode, model = sn, terim = term,
              tahmin = round(b, 4), se = round(s, 4), t = round(b / s, 2),
              p = signif(2 * pt(-abs(b / s), df = length(unique(d$il)) - 1), 3), n = nrow(d), n_il = length(unique(d$il)),
              r2 = round(summary(fit)$r.squared, 3), stringsAsFactors = FALSE)
          }
        }
      }
      if (oc == "dlog_y_geceleme_") {                                  # PERMUTATION test: provinces on the itinerary network are shuffled
        Wr <- Ws[[paste0("rota_", mk)]]; mem <- which(uye[[paste0("rota_", mk)]])
        v <- c("knn5", "rota"); d <- d0[complete.cases(d0[, c("y", "ylag", v)]), ]
        fit <- fit_one(d, v, "fe_rota"); t_obs <- coef(fit)[["rota"]] / clus_se(fit, d$il)[["rota"]]
        tp <- numeric(0)
        for (k in 1:199) {                                             # same network structure, random allocation of which province is linked to which
          pm <- seq_along(ik); pm[mem] <- sample(mem)
          Wp <- Wr[pm, pm]; dimnames(Wp) <- dimnames(Wr)
          dp <- d0; dp$rota <- wlag(Wp, y); dp <- dp[complete.cases(dp[, c("y", "ylag", v)]), ]
          fp <- fit_one(dp, v, "fe_rota")
          tp <- c(tp, coef(fp)[["rota"]] / clus_se(fp, dp$il)[["rota"]])
        }
        perm[[mk]] <- data.frame(pazar = mk, sonuc = yv, model = "M3_ikisi + agxay", t_gozlenen = round(t_obs, 2),
                                 perm_p_tek_yonlu = round((1 + sum(tp >= t_obs)) / (1 + length(tp)), 3),
                                 perm_t_ortalama = round(mean(tp), 2), perm_t_95 = round(quantile(tp, 0.95), 2), n_perm = length(tp),
                                 stringsAsFactors = FALSE)
        cat("  permutasyon bitti:", mk, "\n")
      }
    }
  }
  res <- do.call(rbind, res)
  write_csv_utf8(res, f03a)
  write_csv_utf8(do.call(rbind, cors), file.path(proj_dir, "step03a_wlag_correlations.csv"))
  write_csv_utf8(do.call(rbind, perm), file.path(proj_dir, "step03a_permutation.csv"))
  key3 <- res[res$model %in% c("M3_ikisi", "M6_plasebo_diger_rota") & res$terim != "ylag" & grepl("geceleme", res$sonuc),
              c("pazar", "sabit_etki", "model", "terim", "tahmin", "se", "p")]
  cat("step03a -> model sayisi:", length(unique(paste(res$pazar, res$sonuc, res$model))), "\n"); print(key3, row.names = FALSE)
  }
})

# =====================================================================
# step03b: LOCAL SHOCK test - 6 February 2023 earthquakes (11 provinces)
#   Question: does the tourism loss in provinces not directly hit depend on being linked to the
#         disaster provinces by ITINERARIES (e.g. Mardin, Batman: GAP tour) or on GEOGRAPHIC proximity?
#   Model (disaster provinces are dropped from the sample):
#     log(overnight stays)_it = province x period + province x calendar month + month + bR*(ItinExposure_i x Post_t) + bG*(GeoExposure_i x Post_t)
#     province x period: absorbs coverage breaks | province x calendar month: province-specific seasonality | month: national shocks
#   Exposure: share of a province's itinerary/geographic weights that falls on the disaster provinces (within the W row sum)
#   Placebo: same model with a fake earthquake date (February 2019) -> no effect expected
# =====================================================================
f03b <- file.path(proj_dir, "step03b_quake_did.csv")
log_warn("step03b", {
  if (csv_ok(f03b)) message("step03b zaten yapilmis, atlaniyor.") else {
  pn <- read_csv_utf8(f01d_panel)
  ik <- sort(unique(pn$il_key))
  readW <- function(f) { x <- read_csv_utf8(file.path(proj_dir, f)); M <- as.matrix(x[, -1]); dimnames(M) <- list(x$il_key, x$il_key); M[ik, ik] }
  Ws <- list(knn5 = readW("step02a_W_knn5.csv"), komsu = readW("step02a_W_contig.csv"),
             rota_yerli = readW("step02b2_W_route_yerli.csv"), rota_yabanci = readW("step02b2_W_route_yabanci.csv"))
  Q <- c("kahramanmaras", "hatay", "adiyaman", "malatya", "gaziantep", "osmaniye", "diyarbakir", "sanliurfa", "adana", "kilis", "elazig")  # official disaster area
  expo <- data.frame(il_key = ik, deprem_ili = ik %in% Q, lapply(Ws, function(W) round(rowSums(W[, Q, drop = FALSE]), 4)), stringsAsFactors = FALSE)
  il_ad <- unique(pn[, c("il_key", "il")]); expo <- merge(il_ad, expo, by = "il_key")
  write_csv_utf8(expo[order(-expo$rota_yerli), ], file.path(proj_dir, "step03b_exposure.csv"))  # exposure of each province

  clus_se <- function(fit, cl) {                                       # province-clustered SE (Option A sandwich, Option B manual)
    if (requireNamespace("sandwich", quietly = TRUE)) return(sqrt(diag(sandwich::vcovCL(fit, cluster = cl, type = "HC1"))))
    X <- model.matrix(fit); X <- X[, !is.na(coef(fit)), drop = FALSE]; e <- resid(fit); XtXi <- solve(crossprod(X))
    meat <- Reduce(`+`, lapply(split(seq_along(e), cl), function(ix) { s <- crossprod(X[ix, , drop = FALSE], e[ix]); s %*% t(s) }))
    G <- length(unique(cl)); n <- length(e); k <- ncol(X)
    v <- sqrt(diag(XtXi %*% meat %*% XtXi) * G / (G - 1) * (n - 1) / (n - k)); names(v) <- colnames(X); v
  }
  covid <- pn$t >= 2020 * 12 + 3 & pn$t <= 2021 * 12 + 6               # the most severe COVID period is left out of the sample
  base <- pn[!(pn$il_key %in% Q) & !covid & pn$t <= 2025 * 12 + 6, ]   # disaster provinces and period C (after 2025-07) excluded
  base <- merge(base, expo[, c("il_key", "knn5", "komsu", "rota_yerli", "rota_yabanci")], by = "il_key")
  base$il_donem <- factor(paste(base$il_key, base$donem)); base$il_takvim <- factor(paste(base$il_key, base$month)); base$ay <- factor(base$t)
  runs <- list(gercek = list(t0 = 2023 * 12 + 2, drop_after = Inf), plasebo_2019 = list(t0 = 2019 * 12 + 2, drop_after = 2023 * 12 + 1))
  res <- list(); es <- list()
  for (rn in names(runs)) {
    t0 <- runs[[rn]]$t0
    d0 <- base[base$t <= runs[[rn]]$drop_after, ]
    d0$sonra <- as.integer(d0$t >= t0 & d0$t < t0 + 12)                # 12 months after the shock
    d0 <- d0[!(d0$t >= t0 + 12 & d0$t < t0 + 24), ]                    # the second year is dropped (clean comparison)
    for (mk in c("yerli", "yabanci")) {
      for (oc in c("geceleme_", "doluluk_")) {
        d <- d0; d$y <- log(pmax(d[[paste0(oc, mk)]], 0) + if (oc == "geceleme_") 1 else 0.1)
        d$R <- d[[paste0("rota_", mk)]] * d$sonra; d$G <- d$knn5 * d$sonra; d$K <- d$komsu * d$sonra
        d <- d[is.finite(d$y), ]
        for (sp in c("rota", "cografi", "ikisi", "ikisi_komsu")) {
          v <- switch(sp, rota = "R", cografi = "G", ikisi = c("R", "G"), ikisi_komsu = c("R", "K"))
          fit <- lm(as.formula(paste("y ~", paste(v, collapse = " + "), "+ il_donem + il_takvim + ay")), data = d)
          se <- clus_se(fit, d$il_key)
          for (term in v) {
            b <- coef(fit)[[term]]; s <- se[[term]]
            res[[length(res) + 1]] <- data.frame(deneme = rn, pazar = mk, sonuc = paste0("log_", oc, mk), model = sp,
              terim = c(R = "rota_maruz_x_sonra", G = "knn5_maruz_x_sonra", K = "komsu_maruz_x_sonra")[[term]],
              tahmin = round(b, 4), se = round(s, 4), p = signif(2 * pt(-abs(b / s), df = length(unique(d$il_key)) - 1), 3),
              n = nrow(d), n_il = length(unique(d$il_key)), stringsAsFactors = FALSE)
          }
        }
        if (rn == "gercek" && oc == "geceleme_") {                     # event study: 3-month bins (-12..+12 months)
          d$et <- d$t - t0
          bins <- cut(d$et, breaks = c(-Inf, -13, -10, -7, -4, -1, 2, 5, 8, 11, Inf), labels = c("dis", "m12_m10", "m9_m7", "m6_m4", "m3_m1", "p0_p2", "p3_p5", "p6_p8", "p9_p11", "dis2"))
          d$bin <- as.character(bins); d$bin[d$bin %in% c("dis", "dis2")] <- "ref"   # reference: outside the window
          for (bb in setdiff(unique(d$bin), "ref")) { d[[paste0("R_", bb)]] <- d[[paste0("rota_", mk)]] * (d$bin == bb); d[[paste0("G_", bb)]] <- d$knn5 * (d$bin == bb) }
          vv <- grep("^(R|G)_", names(d), value = TRUE)
          fit <- lm(as.formula(paste("y ~", paste(vv, collapse = " + "), "+ il_donem + il_takvim + ay")), data = d)
          se <- clus_se(fit, d$il_key)
          es[[mk]] <- data.frame(pazar = mk, terim = vv, maruziyet = ifelse(grepl("^R_", vv), "rota", "knn5"), donem = sub("^(R|G)_", "", vv),
                                 tahmin = round(coef(fit)[vv], 4), se = round(se[vv], 4), stringsAsFactors = FALSE)
        }
      }
    }
  }
  res <- do.call(rbind, res); es <- do.call(rbind, es)
  ord <- c("m12_m10", "m9_m7", "m6_m4", "m3_m1", "p0_p2", "p3_p5", "p6_p8", "p9_p11")
  es <- es[order(es$pazar, es$maruziyet, match(es$donem, ord)), ]
  write_csv_utf8(res, f03b)
  write_csv_utf8(es, file.path(proj_dir, "step03b_quake_eventstudy.csv"))
  cat("step03b -> ana sonuclar (model 'ikisi', log geceleme):\n")
  print(res[res$model == "ikisi" & grepl("geceleme", res$sonuc), c("deneme", "pazar", "terim", "tahmin", "se", "p", "n_il")], row.names = FALSE)
  }
})

# =====================================================================
# step03c: DYADIC DESIGN - itinerary test on province pairs
#   1) Residual growth e_it for each province: y ~ province + month (removes national shocks)
#   2) Correlation rho_ij for each province pair (at least 36 common months), Fisher z
#   3) z_ij = a_i + a_j + bR*itin_ij + bG*contig_ij + g*log(distance_ij)
#      a_i, a_j (province fixed effects): absorb a province's general tendency to co-move with all others,
#      i.e. the common network-level shock -> remaining question: do linked pairs in the SAME network co-move more?
#   4) Inference: permutations (999): (a) label shuffling among network members, (b) among all provinces,
#      (c) degree-preserving rewiring. Also the Pesaran CD test and lagged (lead-lag) correlation
# =====================================================================
f03c <- file.path(proj_dir, "step03c_dyadic_results.csv")
log_warn("step03c", {
  if (csv_ok(f03c)) message("step03c zaten yapilmis, atlaniyor.") else {
  pn <- read_csv_utf8(f01d_panel)
  ik <- sort(unique(pn$il_key)); n <- length(ik); tt <- sort(unique(pn$t))
  readM <- function(f) { x <- read_csv_utf8(file.path(proj_dir, f)); M <- as.matrix(x[, -1]); dimnames(M) <- list(x$il_key, x$il_key); M[ik, ik] }
  C <- list(yerli = readM("step02b2_C_route_yerli.csv"), yabanci = readM("step02b2_C_route_yabanci.csv"))  # raw co-occurrence counts
  Dk <- readM("step02a_dist_km.csv"); Kc <- readM("step02a_W_contig.csv") > 0
  up <- which(upper.tri(Dk), arr.ind = TRUE)                           # 3240 province pairs (i<j)
  Xfe <- matrix(0, nrow(up), n); Xfe[cbind(seq_len(nrow(up)), up[, 1])] <- 1; Xfe[cbind(seq_len(nrow(up)), up[, 2])] <- 1  # province fixed effects (a_i + a_j for the pair)
  resid_mat <- function(y, fe_formula) {                               # province x month residual matrix
    d <- data.frame(y = y, il = factor(pn$il_key), ay = factor(pn$t), il_takvim = factor(paste(pn$il_key, pn$month)))
    ok <- is.finite(d$y); fit <- lm(fe_formula, data = d[ok, ])
    E <- matrix(NA_real_, n, length(tt)); E[cbind(match(pn$il_key[ok], ik), match(pn$t[ok], tt))] <- resid(fit); E
  }
  pair_cor <- function(E, lagj = 0) {                                  # pair correlation (lagj=1: j one month earlier)
    Ej <- if (lagj == 0) E else cbind(NA, E[, -ncol(E), drop = FALSE])
    r <- nobs <- numeric(nrow(up))
    for (p in seq_len(nrow(up))) { a <- E[up[p, 1], ]; b <- Ej[up[p, 2], ]; ok <- is.finite(a) & is.finite(b)
      nobs[p] <- sum(ok); r[p] <- if (nobs[p] >= 36) cor(a[ok], b[ok]) else NA }
    list(r = r, n = nobs)
  }
  cd_test <- function(E) {                                             # Pesaran CD (unbalanced panel version)
    pc <- pair_cor(E); ok <- !is.na(pc$r)
    sqrt(2 / (n * (n - 1))) * sum(sqrt(pc$n[ok]) * pc$r[ok])
  }
  fitb <- function(z, X, term = 1) {                                    # fast least squares: only the required coefficient
    ok <- is.finite(z) & rowSums(!is.finite(X)) == 0
    f <- lm.fit(cbind(X[ok, , drop = FALSE], Xfe[ok, , drop = FALSE]), z[ok]); unname(f$coefficients[term])
  }
  rewire <- function(A, nswap) {                                       # degree-preserving rewiring (double edge swap)
    E <- which(upper.tri(A) & A > 0, arr.ind = TRUE); w <- A[E]; m <- nrow(E)
    for (s in seq_len(nswap)) {
      k <- sample.int(m, 2); a <- E[k[1], 1]; b <- E[k[1], 2]; c2 <- E[k[2], 1]; d <- E[k[2], 2]
      if (runif(1) < 0.5) { tmp <- c2; c2 <- d; d <- tmp }
      if (length(unique(c(a, b, c2, d))) < 4) next
      if (A[a, d] > 0 || A[c2, b] > 0) next                            # no multiple edges
      A[a, b] <- A[b, a] <- 0; A[c2, d] <- A[d, c2] <- 0; A[a, d] <- A[d, a] <- 1; A[c2, b] <- A[b, c2] <- 1
      E[k[1], ] <- sort(c(a, d)); E[k[2], ] <- sort(c(c2, b))
    }
    B <- matrix(0, nrow(A), ncol(A), dimnames = dimnames(A)); B[E] <- sample(w); B + t(B)  # weights assigned to the new edges at random
  }
  set.seed(20261111)
  res <- list(); cdl <- list(); pairs_out <- list(); permd <- list()
  for (mk in c("yerli", "yabanci")) {
    other <- setdiff(c("yerli", "yabanci"), mk)
    Cm <- C[[mk]]; Co <- C[[other]]; mem <- which(rowSums(Cm) > 0)
    for (oc in c("dlog_y_geceleme_", "dlog_m_geceleme_")) {
      y <- pn[[paste0(oc, mk)]]
      E <- if (oc == "dlog_y_geceleme_") resid_mat(y, y ~ il + ay) else resid_mat(y, y ~ il_takvim + ay)  # province-specific seasonality for monthly growth
      pc <- pair_cor(E); z <- atanh(pmax(pmin(pc$r, 0.999), -0.999))
      pl <- pair_cor(E, lagj = 1); pl2 <- pair_cor(E[, ], lagj = 1)
      rb <- as.numeric(Cm[up] > 0); ri <- log1p(Cm[up]); rob <- as.numeric(Co[up] > 0)
      kc <- as.numeric(Kc[up]); ld <- log(Dk[up])
      both_mem <- as.numeric(up[, 1] %in% mem & up[, 2] %in% mem)
      sonuc <- paste0(oc, mk)
      if (oc == "dlog_y_geceleme_") pairs_out[[mk]] <- data.frame(pazar = mk, il_i = ik[up[, 1]], il_j = ik[up[, 2]], rho = round(pc$r, 4),
          n_ay = pc$n, rota_sayi = Cm[up], diger_rota_sayi = Co[up], komsu = kc, uzaklik_km = round(Dk[up], 1), stringsAsFactors = FALSE)
      specs <- list(D1_rota = cbind(rota = rb), D2_rota_cografi = cbind(rota = rb, komsu = kc, log_uzaklik = ld),
                    D3_plasebo_yarisi = cbind(rota = rb, diger_rota = rob, komsu = kc, log_uzaklik = ld),
                    D4_yogunluk = cbind(rota_log1p = ri, komsu = kc, log_uzaklik = ld),
                    D5_sadece_ag_ici = cbind(rota = rb, komsu = kc, log_uzaklik = ld))
      for (sn in names(specs)) {
        X <- specs[[sn]]; zz <- z
        if (sn == "D5_sadece_ag_ici") zz[both_mem == 0] <- NA          # only pairs with both ends on the network
        ok <- is.finite(zz)
        d <- data.frame(z = zz[ok], X[ok, , drop = FALSE], Xfe[ok, , drop = FALSE])
        fit <- lm(z ~ . - 1 + 0, data = d)                             # includes province fixed effects (no intercept)
        se <- if (requireNamespace("sandwich", quietly = TRUE)) sqrt(diag(sandwich::vcovHC(fit, type = "HC1"))) else summary(fit)$coefficients[, 2]
        for (tm in colnames(X)) res[[length(res) + 1]] <- data.frame(pazar = mk, sonuc = sonuc, model = sn, terim = tm,
          tahmin = round(coef(fit)[[tm]], 4), se_hc1 = round(se[[tm]], 4), n_cift = sum(ok), stringsAsFactors = FALSE)
      }
      Xm <- cbind(rota = rb, komsu = kc, log_uzaklik = ld)            # ---- permutations (main model D2)
      b_obs <- fitb(z, Xm)
      Xl <- cbind(rota = rb, komsu = kc, log_uzaklik = ld, z_es = z)   # lagged: residual of j one month earlier, controlling for the contemporaneous correlation
      zl <- atanh(pmax(pmin(pl$r, 0.999), -0.999)); b_lag <- fitb(zl, Xl)
      bq_mem <- bq_all <- br <- numeric(999)
      for (k in 1:999) {
        pm <- seq_len(n); pm[mem] <- sample(mem); P <- Cm[pm, pm]; Xp <- Xm; Xp[, 1] <- as.numeric(P[up] > 0); bq_mem[k] <- fitb(z, Xp)
        pa <- sample.int(n); P <- Cm[pa, pa]; Xp[, 1] <- as.numeric(P[up] > 0); bq_all[k] <- fitb(z, Xp)
        P <- rewire((Cm > 0) * 1, nswap = 10 * sum(Cm[up] > 0)); Xp[, 1] <- as.numeric(P[up] > 0); br[k] <- fitb(z, Xp)
      }
      pv <- function(b, bp) round((1 + sum(bp >= b)) / (1 + length(bp)), 4)  # one-sided (itinerary link -> more co-movement)
      permd[[length(permd) + 1]] <- data.frame(pazar = mk, sonuc = sonuc, model = "D2_rota_cografi", b_rota = round(b_obs, 4),
        p_qap_ag_ici = pv(b_obs, bq_mem), p_qap_tum = pv(b_obs, bq_all), p_yeniden_baglama = pv(b_obs, br),
        perm_ort_ag_ici = round(mean(bq_mem), 4), perm_95_ag_ici = round(quantile(bq_mem, 0.95), 4),
        b_rota_gecikmeli = round(b_lag, 4), n_perm = 999, stringsAsFactors = FALSE)
      cdl[[length(cdl) + 1]] <- data.frame(pazar = mk, sonuc = sonuc, cd_il_ay = round(cd_test(E), 2),
        ort_rho = round(mean(pc$r, na.rm = TRUE), 4), ort_rho_rota_bagli = round(mean(pc$r[rb == 1], na.rm = TRUE), 4),
        ort_rho_bagsiz_ag_ici = round(mean(pc$r[rb == 0 & both_mem == 1], na.rm = TRUE), 4),
        ort_rho_ag_disi = round(mean(pc$r[both_mem == 0], na.rm = TRUE), 4), stringsAsFactors = FALSE)
      cat("  bitti:", mk, oc, "| b_rota =", round(b_obs, 4), "| p (ag ici QAP) =", tail(permd, 1)[[1]]$p_qap_ag_ici, "\n")
    }
  }
  res <- do.call(rbind, res); permd <- do.call(rbind, permd)
  write_csv_utf8(res, f03c)
  write_csv_utf8(permd, file.path(proj_dir, "step03c_permutation.csv"))
  write_csv_utf8(do.call(rbind, cdl), file.path(proj_dir, "step03c_cd_and_means.csv"))
  write_csv_utf8(do.call(rbind, pairs_out), file.path(proj_dir, "step03c_pairs.csv"))
  cat("step03c -> permutasyon ozeti:\n"); print(permd, row.names = FALSE)
  }
})

# =====================================================================
# step03d: MECHANISM test - itinerary link or destination SIMILARITY?
#   Same dyadic model (pair correlation with province effects) + pairwise similarity variables:
#     mevsim_benzer : correlation of 12-month overnight-stay profiles (2017-2019, period without breaks)
#     yab_pay_fark  : difference in the foreign share of overnight stays (absolute, 2017-2019)
#     kiyi_ikisi    : both provinces have a sea coast
#     buyukluk_fark : difference in log mean overnight stays (absolute)
#   Question: does the coefficient on itinerary intensity (log(1 + number of programmes)) vanish once similarity is added?
#   Permutations (999): within-network labels, all provinces, degree-preserving rewiring (for M0 and M4)
# =====================================================================
f03d <- file.path(proj_dir, "step03d_mechanism_results.csv")
log_warn("step03d", {
  if (csv_ok(f03d)) message("step03d zaten yapilmis, atlaniyor.") else {
  pn <- read_csv_utf8(f01d_panel)
  ik <- sort(unique(pn$il_key)); n <- length(ik); tt <- sort(unique(pn$t))
  readM <- function(f) { x <- read_csv_utf8(file.path(proj_dir, f)); M <- as.matrix(x[, -1]); dimnames(M) <- list(x$il_key, x$il_key); M[ik, ik] }
  C <- list(yerli = readM("step02b2_C_route_yerli.csv"), yabanci = readM("step02b2_C_route_yabanci.csv"))
  Dk <- readM("step02a_dist_km.csv"); Kc <- readM("step02a_W_contig.csv") > 0
  up <- which(upper.tri(Dk), arr.ind = TRUE)
  Xfe <- matrix(0, nrow(up), n); Xfe[cbind(seq_len(nrow(up)), up[, 1])] <- 1; Xfe[cbind(seq_len(nrow(up)), up[, 2])] <- 1
  kiyi <- c("adana", "antalya", "artvin", "aydin", "balikesir", "bartin", "bursa", "canakkale", "duzce", "edirne", "giresun", "hatay",
            "istanbul", "izmir", "kastamonu", "kirklareli", "kocaeli", "mersin", "mugla", "ordu", "rize", "sakarya", "samsun", "sinop",
            "tekirdag", "trabzon", "yalova", "zonguldak")                # the 28 provinces with a sea coast
  pre <- pn[pn$year >= 2017 & pn$year <= 2019, ]                       # period without breaks, before COVID
  prof <- function(v) {                                                # 12-month share profile per province
    a <- aggregate(pre[[v]], by = list(il = pre$il_key, ay = pre$month), FUN = function(z) sum(z, na.rm = TRUE))
    P <- matrix(0, n, 12, dimnames = list(ik, 1:12)); P[cbind(match(a$il, ik), a$ay)] <- a$x
    P / pmax(rowSums(P), 1)
  }
  tot <- function(v) { a <- tapply(pre[[v]], pre$il_key, sum, na.rm = TRUE); a[ik] }
  yab_pay <- tot("geceleme_yabanci") / pmax(tot("geceleme_yabanci") + tot("geceleme_yerli"), 1)
  boy <- log1p((tot("geceleme_yabanci") + tot("geceleme_yerli")) / 36)
  resid_mat <- function(y, fe_formula) {
    d <- data.frame(y = y, il = factor(pn$il_key), ay = factor(pn$t), il_takvim = factor(paste(pn$il_key, pn$month)))
    ok <- is.finite(d$y); fit <- lm(fe_formula, data = d[ok, ])
    E <- matrix(NA_real_, n, length(tt)); E[cbind(match(pn$il_key[ok], ik), match(pn$t[ok], tt))] <- resid(fit); E
  }
  pair_z <- function(E) vapply(seq_len(nrow(up)), function(p) { a <- E[up[p, 1], ]; b <- E[up[p, 2], ]; ok <- is.finite(a) & is.finite(b)
    if (sum(ok) >= 36) atanh(max(min(cor(a[ok], b[ok]), 0.999), -0.999)) else NA_real_ }, numeric(1))
  fitb <- function(z, X) { ok <- is.finite(z) & rowSums(!is.finite(X)) == 0
    unname(lm.fit(cbind(X[ok, , drop = FALSE], Xfe[ok, , drop = FALSE]), z[ok])$coefficients[1]) }
  rewire <- function(A, nswap) {                                       # degree-preserving rewiring
    E <- which(upper.tri(A) & A > 0, arr.ind = TRUE); w <- A[E]; m <- nrow(E); B01 <- (A > 0) * 1
    for (s in seq_len(nswap)) {
      k <- sample.int(m, 2); a <- E[k[1], 1]; b <- E[k[1], 2]; c2 <- E[k[2], 1]; d <- E[k[2], 2]
      if (runif(1) < 0.5) { tmp <- c2; c2 <- d; d <- tmp }
      if (length(unique(c(a, b, c2, d))) < 4 || B01[a, d] > 0 || B01[c2, b] > 0) next
      B01[a, b] <- B01[b, a] <- 0; B01[c2, d] <- B01[d, c2] <- 0; B01[a, d] <- B01[d, a] <- 1; B01[c2, b] <- B01[b, c2] <- 1
      E[k[1], ] <- sort(c(a, d)); E[k[2], ] <- sort(c(c2, b))
    }
    B <- matrix(0, nrow(A), ncol(A), dimnames = dimnames(A)); B[E] <- sample(w); B + t(B)
  }
  set.seed(20261112)
  res <- list(); permd <- list(); sim_out <- list()
  for (mk in c("yerli", "yabanci")) {
    other <- setdiff(c("yerli", "yabanci"), mk); Cm <- C[[mk]]; Co <- C[[other]]; mem <- which(rowSums(Cm) > 0)
    P <- prof(paste0("geceleme_", mk)); mevs <- cor(t(P)); mevs[!is.finite(mevs)] <- 0
    cov <- cbind(komsu = as.numeric(Kc[up]), log_uzaklik = log(Dk[up]))
    sim <- cbind(mevsim_benzer = mevs[up], yab_pay_fark = abs(yab_pay[up[, 1]] - yab_pay[up[, 2]]),
                 kiyi_ikisi = as.numeric(ik[up[, 1]] %in% kiyi & ik[up[, 2]] %in% kiyi), buyukluk_fark = abs(boy[up[, 1]] - boy[up[, 2]]))
    sim_out[[mk]] <- data.frame(pazar = mk, il_i = ik[up[, 1]], il_j = ik[up[, 2]], round(sim, 4), rota_sayi = Cm[up], stringsAsFactors = FALSE)
    cs <- suppressWarnings(cor(cbind(rota_log1p = log1p(Cm[up]), diger_rota_log1p = log1p(Co[up]), sim)))
    for (oc in c("dlog_y_geceleme_", "dlog_m_geceleme_")) {
      y <- pn[[paste0(oc, mk)]]
      E <- if (oc == "dlog_y_geceleme_") resid_mat(y, y ~ il + ay) else resid_mat(y, y ~ il_takvim + ay)
      z <- pair_z(E); sonuc <- paste0(oc, mk)
      R <- log1p(Cm[up]); Ro <- log1p(Co[up])
      specs <- list(M0_rota = cbind(rota_log1p = R, cov), M1_mevsim = cbind(rota_log1p = R, cov, sim[, "mevsim_benzer", drop = FALSE]),
                    M2_yabpay = cbind(rota_log1p = R, cov, sim[, "yab_pay_fark", drop = FALSE]),
                    M3_kiyi = cbind(rota_log1p = R, cov, sim[, "kiyi_ikisi", drop = FALSE]),
                    M4_tum_benzerlik = cbind(rota_log1p = R, cov, sim),
                    M5_tum_benzerlik_diger_rota = cbind(rota_log1p = R, diger_rota_log1p = Ro, cov, sim))
      for (sn in names(specs)) {
        X <- specs[[sn]]; ok <- is.finite(z) & rowSums(!is.finite(X)) == 0
        d <- data.frame(z = z[ok], X[ok, , drop = FALSE], Xfe[ok, , drop = FALSE])
        fit <- lm(z ~ . - 1 + 0, data = d)
        se <- if (requireNamespace("sandwich", quietly = TRUE)) sqrt(diag(sandwich::vcovHC(fit, type = "HC1"))) else summary(fit)$coefficients[, 2]
        for (tm in colnames(X)) res[[length(res) + 1]] <- data.frame(pazar = mk, sonuc = sonuc, model = sn, terim = tm,
          tahmin = round(coef(fit)[[tm]], 4), se_hc1 = round(se[[tm]], 4), t = round(coef(fit)[[tm]] / se[[tm]], 2), n_cift = sum(ok), stringsAsFactors = FALSE)
      }
      for (sn in c("M0_rota", "M4_tum_benzerlik")) {                   # permutation: itinerary intensity coefficient
        X <- specs[[sn]]; b_obs <- fitb(z, X); bq_mem <- bq_all <- br <- numeric(999)
        for (k in 1:999) {
          pm <- seq_len(n); pm[mem] <- sample(mem); Xp <- X; Xp[, 1] <- log1p(Cm[pm, pm][up]); bq_mem[k] <- fitb(z, Xp)
          pa <- sample.int(n); Xp[, 1] <- log1p(Cm[pa, pa][up]); bq_all[k] <- fitb(z, Xp)
          Xp[, 1] <- log1p(rewire(Cm, 10 * sum(Cm[up] > 0))[up]); br[k] <- fitb(z, Xp)
        }
        pv <- function(b, bp) round((1 + sum(bp >= b)) / (1 + length(bp)), 4)
        permd[[length(permd) + 1]] <- data.frame(pazar = mk, sonuc = sonuc, model = sn, b_rota_log1p = round(b_obs, 4),
          p_qap_ag_ici = pv(b_obs, bq_mem), p_qap_tum = pv(b_obs, bq_all), p_yeniden_baglama = pv(b_obs, br), n_perm = 999, stringsAsFactors = FALSE)
        cat("  bitti:", mk, oc, sn, "| b =", round(b_obs, 4), "| p ag ici =", tail(permd, 1)[[1]]$p_qap_ag_ici, "\n")
      }
    }
    write_csv_utf8(data.frame(pazar = mk, degisken = rownames(cs), round(cs, 3), check.names = FALSE),
                   file.path(proj_dir, paste0("step03d_similarity_cor_", mk, ".csv")))  # relation between itineraries and similarity
  }
  res <- do.call(rbind, res); permd <- do.call(rbind, permd)
  write_csv_utf8(res, f03d)
  write_csv_utf8(permd, file.path(proj_dir, "step03d_permutation.csv"))
  write_csv_utf8(do.call(rbind, sim_out), file.path(proj_dir, "step03d_pair_similarity.csv"))
  cat("step03d -> rota yogunlugu: benzerlik oncesi (M0) / sonrasi (M4):\n")
  print(res[res$terim == "rota_log1p" & res$model %in% c("M0_rota", "M4_tum_benzerlik", "M5_tum_benzerlik_diger_rota"), c("pazar", "sonuc", "model", "tahmin", "se_hc1", "t")], row.names = FALSE)
  print(permd, row.names = FALSE)
  }
})

