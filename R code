# =====================================================================
# step06: DYADIC PERMUTATION - robust procedures (Dekker, Krackhardt & Snijders 2007)
#   Why: in step03c/03d the RAW itinerary matrix was permuted and the statistic was the COEFFICIENT.
#          Dekker et al. (2007): the most robust MRQAP procedures are Freedman-Lane and DSP; the statistic should be t.
#   Model (each market x growth measure): z_ij = a_i + a_j + b*X_ij + controls
#     D2 : X = itinerary tie (0/1),            controls = contiguity + log distance
#     M0 : X = log(1 + shared programmes),     controls = contiguity + log distance
#     M4 : X = log(1 + shared programmes),     controls = contiguity + log distance + 4 similarity measures
#   DSP : X is residualised on the controls (incl. province effects); the RESIDUAL matrix is permuted by province labels
#   FL  : z is residualised on the controls; the z RESIDUAL matrix is permuted (Freedman-Lane)
#   Permutation: (a) among provinces on the itinerary network, (b) among all provinces; 999 replications; one-sided p (t >= t_observed)
#   Outputs: step06_dyadic_permutation_robust.csv + step06_permutation_robust.xlsx
# =====================================================================
f06 <- file.path(proj_dir, "step06_dyadic_permutation_robust.csv")
log_warn("step06", {
  if (csv_ok(f06)) message("step06 zaten yapilmis, atlaniyor.") else {
  pn <- read_csv_utf8(f01d_panel)                                       # analysis panel (step01d)
  ik <- sort(unique(pn$il_key)); n <- length(ik); tt <- sort(unique(pn$t))  # 81 provinces, months
  readM <- function(f) { x <- read_csv_utf8(file.path(proj_dir, f)); M <- as.matrix(x[, -1]); dimnames(M) <- list(x$il_key, x$il_key); M[ik, ik] }  # reads a matrix
  C <- list(yerli = readM("step02b2_C_route_yerli.csv"), yabanci = readM("step02b2_C_route_yabanci.csv"))  # raw numbers of shared programmes
  Dk <- readM("step02a_dist_km.csv"); Kc <- readM("step02a_W_contig.csv") > 0  # distance and contiguity
  up <- which(upper.tri(Dk), arr.ind = TRUE)                            # 3240 province pairs
  Xfe <- matrix(0, nrow(up), n); Xfe[cbind(seq_len(nrow(up)), up[, 1])] <- 1; Xfe[cbind(seq_len(nrow(up)), up[, 2])] <- 1  # a_i + a_j
  kiyi <- c("adana", "antalya", "artvin", "aydin", "balikesir", "bartin", "bursa", "canakkale", "duzce", "edirne", "giresun", "hatay",
            "istanbul", "izmir", "kastamonu", "kirklareli", "kocaeli", "mersin", "mugla", "ordu", "rize", "sakarya", "samsun", "sinop",
            "tekirdag", "trabzon", "yalova", "zonguldak")                 # the 28 provinces with a sea coast (same as step03d)
  pre <- pn[pn$year >= 2017 & pn$year <= 2019, ]                        # similarity period (same as step03d)
  prof <- function(v) { a <- aggregate(pre[[v]], by = list(il = pre$il_key, ay = pre$month), FUN = function(z) sum(z, na.rm = TRUE))
    P <- matrix(0, n, 12, dimnames = list(ik, 1:12)); P[cbind(match(a$il, ik), a$ay)] <- a$x; P / pmax(rowSums(P), 1) }  # 12-month share profile
  tot <- function(v) { a <- tapply(pre[[v]], pre$il_key, sum, na.rm = TRUE); a[ik] }  # 2017-2019 total
  yab_pay <- tot("geceleme_yabanci") / pmax(tot("geceleme_yabanci") + tot("geceleme_yerli"), 1)  # foreign share
  boy <- log1p((tot("geceleme_yabanci") + tot("geceleme_yerli")) / 36)  # size (log monthly mean)
  resid_mat <- function(y, fe_formula) {                                # province x month residual growth matrix
    d <- data.frame(y = y, il = factor(pn$il_key), ay = factor(pn$t), il_takvim = factor(paste(pn$il_key, pn$month)))
    ok <- is.finite(d$y); fit <- lm(fe_formula, data = d[ok, ])
    E <- matrix(NA_real_, n, length(tt)); E[cbind(match(pn$il_key[ok], ik), match(pn$t[ok], tt))] <- resid(fit); E }
  pair_z <- function(E) vapply(seq_len(nrow(up)), function(p) { a <- E[up[p, 1], ]; b <- E[up[p, 2], ]; ok <- is.finite(a) & is.finite(b)
    if (sum(ok) >= 36) atanh(max(min(cor(a[ok], b[ok]), 0.999), -0.999)) else NA_real_ }, numeric(1))  # Fisher z (same as step03c)
  to_mat <- function(v) { M <- matrix(0, n, n); M[up] <- v; M + t(M) }  # pair vector -> symmetric matrix
  perm_vec <- function(M, pm) M[pm, pm][up]                             # pair vector from the matrix with permuted province labels
  t_fwl <- function(rx, ez, df) {                                       # t via FWL: rx = residual of X, ez = residual of z
    b <- sum(rx * ez) / sum(rx^2); e <- ez - b * rx; s2 <- sum(e^2) / df; b / sqrt(s2 / sum(rx^2)) }
  t_lm <- function(z, X, Z) { f <- lm.fit(cbind(X, Z), z); e <- f$residuals; df <- length(z) - f$rank   # Option B: direct lm.fit
    XtX <- crossprod(cbind(X, Z)); v <- tryCatch(solve(XtX)[1, 1], error = function(e) NA); f$coefficients[1] / sqrt(sum(e^2) / df * v) }
  set.seed(20261113)                                                    # reproducible permutations
  R <- 999; res <- list()
  for (mk in c("yerli", "yabanci")) {
    Cm <- C[[mk]]; mem <- which(rowSums(Cm) > 0)                        # provinces on the itinerary network
    P <- prof(paste0("geceleme_", mk)); mevs <- cor(t(P)); mevs[!is.finite(mevs)] <- 0  # seasonality similarity
    sim <- cbind(mevsim_benzer = mevs[up], yab_pay_fark = abs(yab_pay[up[, 1]] - yab_pay[up[, 2]]),
                 kiyi_ikisi = as.numeric(ik[up[, 1]] %in% kiyi & ik[up[, 2]] %in% kiyi), buyukluk_fark = abs(boy[up[, 1]] - boy[up[, 2]]))  # 4 similarity measures
    geo <- cbind(komsu = as.numeric(Kc[up]), log_uzaklik = log(Dk[up]))  # geographic controls
    for (oc in c("dlog_y_geceleme_", "dlog_m_geceleme_")) {
      y <- pn[[paste0(oc, mk)]]
      E <- if (oc == "dlog_y_geceleme_") resid_mat(y, y ~ il + ay) else resid_mat(y, y ~ il_takvim + ay)  # same residuals as step03c/03d
      z <- pair_z(E); ok <- is.finite(z)                                # z available for all pairs (at least 36 common months)
      specs <- list(D2_rota_cografi = list(x = as.numeric(Cm[up] > 0), Z = geo),
                    M0_rota = list(x = log1p(Cm[up]), Z = geo),
                    M4_tum_benzerlik = list(x = log1p(Cm[up]), Z = cbind(geo, sim)))
      for (sn in names(specs)) {
        x <- specs[[sn]]$x; Z <- cbind(specs[[sn]]$Z, Xfe)              # controls + province effects
        qz <- qr(Z[ok, , drop = FALSE])                                 # Option A: QR once (fast)
        use_qr <- qz$rank == ncol(Z)                                    # Option B if not of full rank
        df <- sum(ok) - qz$rank - 1
        rx <- qr.resid(qz, x[ok]); ez <- qr.resid(qz, z[ok])            # FWL residuals
        t_obs <- if (use_qr) t_fwl(rx, ez, df) else t_lm(z[ok], x[ok], Z[ok, , drop = FALSE])
        b_obs <- sum(rx * ez) / sum(rx^2)                               # coefficient (should equal step03c/03d)
        RX <- to_mat(qr.resid(qr(Z), x))                                # DSP: residual of X for all pairs -> matrix
        fitz <- z; fitz[ok] <- z[ok] - ez                                # FL: fitted values of the reduced model
        EZ <- to_mat(ifelse(ok, z - fitz, 0))                           # FL: residual of z -> matrix
        tp <- matrix(NA_real_, R, 4, dimnames = list(NULL, c("dsp_ag_ici", "dsp_tum", "fl_ag_ici", "fl_tum")))
        for (k in seq_len(R)) {
          pm_a <- seq_len(n); pm_a[mem] <- sample(mem)                  # (a) among network members
          pm_b <- sample.int(n)                                         # (b) among all provinces
          for (j in 1:2) {
            pm <- if (j == 1) pm_a else pm_b
            rxp <- qr.resid(qz, perm_vec(RX, pm)[ok])                   # DSP: permuted residual of X, residualised again
            tp[k, j] <- t_fwl(rxp, ez, df)
            ezp <- qr.resid(qz, perm_vec(EZ, pm)[ok])                   # FL: z* = fitted + permuted residual
            tp[k, j + 2] <- t_fwl(rx, ezp, df)
          }
        }
        pv <- function(v) round((1 + sum(v >= t_obs, na.rm = TRUE)) / (1 + sum(is.finite(v))), 4)  # one-sided p
        res[[length(res) + 1]] <- data.frame(pazar = mk, sonuc = paste0(oc, mk), model = sn, b = round(b_obs, 4), t_ols = round(t_obs, 2),
          p_dsp_ag_ici = pv(tp[, 1]), p_dsp_tum = pv(tp[, 2]), p_fl_ag_ici = pv(tp[, 3]), p_fl_tum = pv(tp[, 4]),
          n_cift = sum(ok), n_perm = R, yontem_t = ifelse(use_qr, "QR (Yol A)", "lm.fit (Yol B)"), stringsAsFactors = FALSE)
        cat("  step06:", mk, oc, sn, "| b =", round(b_obs, 4), "| t =", round(t_obs, 2), "\n")
      }
    }
  }
  res <- do.call(rbind, res)
  old <- rbind(transform(read_csv_utf8(file.path(proj_dir, "step03c_permutation.csv"))[, c("pazar", "sonuc", "model", "p_qap_ag_ici", "p_qap_tum", "p_yeniden_baglama")]),
               read_csv_utf8(file.path(proj_dir, "step03d_permutation.csv"))[, c("pazar", "sonuc", "model", "p_qap_ag_ici", "p_qap_tum", "p_yeniden_baglama")])  # earlier (raw) p-values
  names(old)[4:6] <- c("p_ham_ag_ici", "p_ham_tum", "p_ham_yeniden_baglama")
  res <- merge(res, old, by = c("pazar", "sonuc", "model"), all.x = TRUE, sort = FALSE)  # side by side for comparison
  write_csv_utf8(res, f06)
  fx <- file.path(proj_dir, "step06_permutation_robust.xlsx")
  okx <- tryCatch({ openxlsx::write.xlsx(list(S_dyadic_perm_robust = res), fx, overwrite = TRUE); TRUE }, error = function(e) FALSE)  # Option A
  if (!okx) okx <- tryCatch({ writexl::write_xlsx(list(S_dyadic_perm_robust = res), fx); TRUE }, error = function(e) FALSE)          # Option B (CSV already written)
  cat("step06 -> saglam permutasyon p degerleri (DSP / Freedman-Lane, t istatistigi):\n")
  print(res[, c("pazar", "sonuc", "model", "b", "t_ols", "p_dsp_ag_ici", "p_dsp_tum", "p_fl_ag_ici", "p_fl_tum", "p_ham_ag_ici")], row.names = FALSE)
  }
})

# =====================================================================
# step07: ROBUSTNESS PACKAGE
#   (a) Panel timing: year-on-year growth with lags of 1 / 3 / 6 / 12 months (12 = non-overlapping window),
#       month-on-month growth (province x calendar month + month effects), provinces on the itinerary network only
#       -> each without / with network x month effects; permutation test (199) for the network x month version
#   (b) Dyadic sensitivity (M0 and M4, DSP permutation 999):
#       at least 60 common months, raw correlation instead of Fisher z, holiday/Easter months excluded for monthly growth,
#       coastal coding: both provinces coastal + only one province coastal
#   (c) Descriptives: months used, exposure counts, number of reweightings for missing neighbours,
#       foreign-share difference for linked/unlinked pairs within the network, official coverage change in the bulletins
#   Outputs: step07_panel_timing.csv, step07_dyadic_sensitivity.csv, step07_diagnostics.csv, step07_robustness2.xlsx
# =====================================================================
f07 <- file.path(proj_dir, "step07_dyadic_sensitivity.csv")
log_warn("step07", {
  if (csv_ok(f07)) message("step07 zaten yapilmis, atlaniyor.") else {
  pn <- read_csv_utf8(f01d_panel)                                       # analysis panel
  ik <- sort(unique(pn$il_key)); n <- length(ik); tt <- sort(unique(pn$t))  # provinces and months
  readM <- function(f) { x <- read_csv_utf8(file.path(proj_dir, f)); M <- as.matrix(x[, -1]); dimnames(M) <- list(x$il_key, x$il_key); M[ik, ik] }
  Ws <- list(knn5 = readM("step02a_W_knn5.csv"), rota_yerli = readM("step02b2_W_route_yerli.csv"), rota_yabanci = readM("step02b2_W_route_yabanci.csv"))  # W matrices
  C <- list(yerli = readM("step02b2_C_route_yerli.csv"), yabanci = readM("step02b2_C_route_yabanci.csv"))  # raw numbers of shared programmes
  Dk <- readM("step02a_dist_km.csv"); Kc <- readM("step02a_W_contig.csv") > 0  # distance, contiguity
  uye <- list(yerli = rowSums(C$yerli) > 0, yabanci = rowSums(C$yabanci) > 0)  # network members
  ii <- match(pn$il_key, ik); jj <- match(pn$t, tt)                     # panel row -> matrix position
  to_grid <- function(y) { G <- matrix(NA_real_, n, length(tt)); G[cbind(ii, jj)] <- y; G }  # province x month matrix
  lag_cols <- function(G, k) cbind(matrix(NA_real_, n, k), G[, seq_len(ncol(G) - k), drop = FALSE])  # k-month lag
  wlag_k <- function(W, y, k) {                                         # W*y, lagged k months (same rule as step03a)
    G <- to_grid(y); M <- !is.na(G); G0 <- G; G0[!M] <- 0
    num <- W %*% G0; den <- W %*% (M * 1); out <- ifelse(den > 0, num / den, NA)
    out[rowSums(W) == 0, ] <- 0                                         # province outside the network: 0 (absorbed by the province effect)
    lag_cols(out, k)[cbind(ii, jj)] }
  own_k <- function(y, k) lag_cols(to_grid(y), k)[cbind(ii, jj)]        # own growth, lagged k months
  clus_se <- function(fit, cl) {                                        # province-clustered SE
    if (requireNamespace("sandwich", quietly = TRUE)) return(sqrt(diag(sandwich::vcovCL(fit, cluster = cl, type = "HC1"))))  # Option A
    X <- model.matrix(fit); X <- X[, !is.na(coef(fit)), drop = FALSE]; e <- resid(fit); XtXi <- solve(crossprod(X))       # Option B: manual CR1
    meat <- Reduce(`+`, lapply(split(seq_along(e), cl), function(ix) { s <- crossprod(X[ix, , drop = FALSE], e[ix]); s %*% t(s) }))
    G <- length(unique(cl)); nn <- length(e); k <- ncol(X)
    v <- sqrt(diag(XtXi %*% meat %*% XtXi) * G / (G - 1) * (nn - 1) / (nn - k)); names(v) <- colnames(X); v }
  set.seed(20261114)                                                    # reproducible permutations

  # ---- (a) panel timing ----
  pres <- list()
  for (mk in c("yerli", "yabanci")) {
    Wr <- Ws[[paste0("rota_", mk)]]; mem <- which(uye[[mk]])
    specs <- list(yillik_k1 = list(v = "dlog_y_geceleme_", k = 1, fe = "il", sadece_ag = FALSE),
                  yillik_k3 = list(v = "dlog_y_geceleme_", k = 3, fe = "il", sadece_ag = FALSE),
                  yillik_k6 = list(v = "dlog_y_geceleme_", k = 6, fe = "il", sadece_ag = FALSE),
                  yillik_k12 = list(v = "dlog_y_geceleme_", k = 12, fe = "il", sadece_ag = FALSE),
                  aylik_k1 = list(v = "dlog_m_geceleme_", k = 1, fe = "il_takvim", sadece_ag = FALSE),
                  yillik_k1_sadece_ag = list(v = "dlog_y_geceleme_", k = 1, fe = "il", sadece_ag = TRUE))
    for (sn in names(specs)) {
      sp <- specs[[sn]]; y <- pn[[paste0(sp$v, mk)]]
      d0 <- data.frame(y = y, ylag = own_k(y, sp$k), knn5 = wlag_k(Ws$knn5, y, sp$k), rota = wlag_k(Wr, y, sp$k),
                       il = factor(pn$il_key), il_takvim = factor(paste(pn$il_key, pn$month)), ay = factor(pn$t),
                       fe_rota = factor(paste(uye[[mk]][ii], pn$t)), uye = uye[[mk]][ii])
      if (sp$sadece_ag) d0 <- d0[d0$uye, ]                              # provinces on the itinerary network only
      d <- d0[complete.cases(d0[, c("y", "ylag", "knn5", "rota")]), ]
      for (fe_mode in c("il_ay", "il_ay_agxay")) {
        fe_txt <- paste(sp$fe, "+ ay", if (fe_mode == "il_ay_agxay" && !sp$sadece_ag) "+ fe_rota" else "")  # network x month (network-only sample: month effect = network effect)
        f <- as.formula(paste("y ~ ylag + knn5 + rota +", fe_txt))
        fit <- lm(f, data = d); se <- clus_se(fit, d$il)
        b <- coef(fit)[["rota"]]; s <- se[["rota"]]
        p_perm <- NA_real_
        if (fe_mode == "il_ay_agxay") {                                 # permutation: labels of network members are shuffled
          rows <- as.integer(rownames(d))                                # sample rows (within d0)
          mm <- model.matrix(as.formula(paste("~ ylag + knn5 +", fe_txt)), data = d)  # all regressors except the itinerary lag
          qz <- qr(mm); ey <- qr.resid(qz, d$y); K <- qz$rank + 1; G <- length(unique(d$il)); N <- nrow(d)
          t_fwl <- function(rv) { r1 <- qr.resid(qz, rv); bb <- sum(r1 * ey) / sum(r1^2); e <- ey - bb * r1   # FWL: itinerary coefficient and
            sc <- rowsum(r1 * e, as.character(d$il)); v <- sum(sc^2) / sum(r1^2)^2 * G / (G - 1) * (N - 1) / (N - K); bb / sqrt(v) }  # province-clustered t (fast)
          t_obs <- t_fwl(d$rota); tp <- numeric(0)
          for (r in 1:199) {
            pm <- seq_len(n); pm[mem] <- sample(mem); Wp <- Wr[pm, pm]; dimnames(Wp) <- dimnames(Wr)
            rp <- wlag_k(Wp, y, sp$k)[if (sp$sadece_ag) uye[[mk]][ii] else TRUE][match(rownames(d), rownames(d0))]  # same rows
            tp <- c(tp, if (all(is.finite(rp))) t_fwl(rp) else NA)
          }
          p_perm <- round((1 + sum(tp >= t_obs, na.rm = TRUE)) / (1 + sum(is.finite(tp))), 3)
        }
        pres[[length(pres) + 1]] <- data.frame(pazar = mk, model = sn, sabit_etki = fe_mode, gecikme_ay = sp$k,
          b_rota = round(b, 4), se_rota = round(s, 4), p_rota = signif(2 * pt(-abs(b / s), df = length(unique(d$il)) - 1), 3),
          b_knn5 = round(coef(fit)[["knn5"]], 4), se_knn5 = round(se[["knn5"]], 4), p_perm_199 = p_perm,
          n = nrow(d), n_il = length(unique(d$il)), stringsAsFactors = FALSE)
        cat("  step07 panel:", mk, sn, fe_mode, "| b =", round(b, 4), "\n")
      }
    }
  }
  pres <- do.call(rbind, pres)

  # ---- (b) dyadic sensitivity ----
  up <- which(upper.tri(Dk), arr.ind = TRUE)
  Xfe <- matrix(0, nrow(up), n); Xfe[cbind(seq_len(nrow(up)), up[, 1])] <- 1; Xfe[cbind(seq_len(nrow(up)), up[, 2])] <- 1
  kiyi <- c("adana", "antalya", "artvin", "aydin", "balikesir", "bartin", "bursa", "canakkale", "duzce", "edirne", "giresun", "hatay",
            "istanbul", "izmir", "kastamonu", "kirklareli", "kocaeli", "mersin", "mugla", "ordu", "rize", "sakarya", "samsun", "sinop",
            "tekirdag", "trabzon", "yalova", "zonguldak")                 # the 28 coastal provinces
  pre <- pn[pn$year >= 2017 & pn$year <= 2019, ]
  prof <- function(v) { a <- aggregate(pre[[v]], by = list(il = pre$il_key, ay = pre$month), FUN = function(z) sum(z, na.rm = TRUE))
    P <- matrix(0, n, 12, dimnames = list(ik, 1:12)); P[cbind(match(a$il, ik), a$ay)] <- a$x; P / pmax(rowSums(P), 1) }
  tot <- function(v) { a <- tapply(pre[[v]], pre$il_key, sum, na.rm = TRUE); a[ik] }
  yab_pay <- tot("geceleme_yabanci") / pmax(tot("geceleme_yabanci") + tot("geceleme_yerli"), 1)
  boy <- log1p((tot("geceleme_yabanci") + tot("geceleme_yerli")) / 36)
  resid_mat <- function(y, fe_formula) {
    d <- data.frame(y = y, il = factor(pn$il_key), ay = factor(pn$t), il_takvim = factor(paste(pn$il_key, pn$month)))
    ok <- is.finite(d$y); fit <- lm(fe_formula, data = d[ok, ])
    E <- matrix(NA_real_, n, length(tt)); E[cbind(match(pn$il_key[ok], ik), match(pn$t[ok], tt))] <- resid(fit); E }
  pair_stat <- function(E, min_ay = 36, fisher = TRUE) vapply(seq_len(nrow(up)), function(p) {   # pair correlation
    a <- E[up[p, 1], ]; b <- E[up[p, 2], ]; ok <- is.finite(a) & is.finite(b)
    if (sum(ok) < min_ay) return(NA_real_); r <- cor(a[ok], b[ok]); if (fisher) atanh(max(min(r, 0.999), -0.999)) else r }, numeric(1))
  hol <- list(                                                          # first days of the religious holidays and Easter (2017-2026)
    ramazan = as.Date(c("2017-06-25", "2018-06-15", "2019-06-04", "2020-05-24", "2021-05-13", "2022-05-02", "2023-04-21", "2024-04-10", "2025-03-30", "2026-03-20")),
    kurban = as.Date(c("2017-09-01", "2018-08-21", "2019-08-11", "2020-07-31", "2021-07-20", "2022-07-09", "2023-06-28", "2024-06-16", "2025-06-06", "2026-05-27")),
    paskalya = as.Date(c("2017-04-16", "2018-04-01", "2019-04-21", "2020-04-12", "2021-04-04", "2022-04-17", "2023-04-09", "2024-03-31", "2025-04-20", "2026-04-05")))
  hol_t <- function(dd, span) { s <- unique(c(as.numeric(format(dd, "%Y")) * 12 + as.numeric(format(dd, "%m")),
                                              as.numeric(format(dd + span, "%Y")) * 12 + as.numeric(format(dd + span, "%m")))); unique(c(s, s + 1)) }  # holiday month and the following month (monthly growth)
  dsp_test <- function(z, x, Z, mem, R = 999) {                         # DSP permutation (same as step06)
    ok <- is.finite(z) & is.finite(x) & rowSums(!is.finite(Z)) == 0
    qz <- qr(Z[ok, , drop = FALSE]); df <- sum(ok) - qz$rank - 1
    rx <- qr.resid(qz, x[ok]); ez <- qr.resid(qz, z[ok])
    tf <- function(r1) { b <- sum(r1 * ez) / sum(r1^2); e <- ez - b * r1; b / sqrt(sum(e^2) / df / sum(r1^2)) }
    t_obs <- tf(rx); b_obs <- sum(rx * ez) / sum(rx^2)
    RXv <- rep(NA_real_, length(x)); RXv[ok] <- rx; RX <- matrix(0, n, n); RX[up] <- ifelse(is.na(RXv), 0, RXv); RX <- RX + t(RX)
    tp <- matrix(NA_real_, R, 2)
    for (k in seq_len(R)) {
      pa <- seq_len(n); pa[mem] <- sample(mem); pb <- sample.int(n)
      tp[k, 1] <- tf(qr.resid(qz, RX[pa, pa][up][ok])); tp[k, 2] <- tf(qr.resid(qz, RX[pb, pb][up][ok]))
    }
    c(b = b_obs, t = t_obs, p_dsp_ag_ici = (1 + sum(tp[, 1] >= t_obs)) / (1 + R), p_dsp_tum = (1 + sum(tp[, 2] >= t_obs)) / (1 + R), n_cift = sum(ok)) }
  dres <- list(); diag_fs <- list()
  for (mk in c("yerli", "yabanci")) {
    Cm <- C[[mk]]; mem <- which(uye[[mk]])
    P <- prof(paste0("geceleme_", mk)); mevs <- cor(t(P)); mevs[!is.finite(mevs)] <- 0
    ki <- ik[up[, 1]] %in% kiyi; kj <- ik[up[, 2]] %in% kiyi
    sim <- cbind(mevsim_benzer = mevs[up], yab_pay_fark = abs(yab_pay[up[, 1]] - yab_pay[up[, 2]]),
                 kiyi_ikisi = as.numeric(ki & kj), buyukluk_fark = abs(boy[up[, 1]] - boy[up[, 2]]))
    sim_bir <- cbind(sim, kiyi_biri = as.numeric(xor(ki, kj)))         # only one province coastal (additional coding)
    geo <- cbind(komsu = as.numeric(Kc[up]), log_uzaklik = log(Dk[up]))
    x <- log1p(Cm[up])
    bm <- up[, 1] %in% mem & up[, 2] %in% mem                           # both ends on the network
    fsd <- sim[, "yab_pay_fark"]
    diag_fs[[mk]] <- data.frame(pazar = mk, olcu = c("yab_pay_fark_bagli_ag_ici", "yab_pay_fark_bagsiz_ag_ici"),
                                deger = round(c(mean(fsd[bm & Cm[up] > 0]), mean(fsd[bm & Cm[up] == 0])), 3), stringsAsFactors = FALSE)
    E_y <- resid_mat(pn[[paste0("dlog_y_geceleme_", mk)]], y ~ il + ay)
    E_m <- resid_mat(pn[[paste0("dlog_m_geceleme_", mk)]], y ~ il_takvim + ay)
    hmon <- c(hol_t(hol$ramazan, 3), hol_t(hol$kurban, 4), if (mk == "yabanci") hol_t(hol$paskalya, 1))  # months to exclude
    E_mh <- E_m; E_mh[, tt %in% hmon] <- NA                              # holiday/Easter month and the following month excluded
    vars <- list(ana_yillik = list(E = E_y, min = 36, fz = TRUE), ana_aylik = list(E = E_m, min = 36, fz = TRUE),
                 yillik_min60 = list(E = E_y, min = 60, fz = TRUE), aylik_min60 = list(E = E_m, min = 60, fz = TRUE),
                 yillik_ham_r = list(E = E_y, min = 36, fz = FALSE), aylik_ham_r = list(E = E_m, min = 36, fz = FALSE),
                 aylik_tatil_haric = list(E = E_mh, min = 36, fz = TRUE))
    for (vn in names(vars)) {
      v <- vars[[vn]]; z <- pair_stat(v$E, v$min, v$fz)
      for (sn in c("M0_rota", "M4_tum_benzerlik", "M4_kiyi_iki_kodlu")) {
        if (sn == "M4_kiyi_iki_kodlu" && !(vn %in% c("ana_yillik", "ana_aylik"))) next
        Z <- cbind(geo, if (sn == "M4_tum_benzerlik") sim else if (sn == "M4_kiyi_iki_kodlu") sim_bir else NULL, Xfe)
        r <- dsp_test(z, x, Z, mem)
        dres[[length(dres) + 1]] <- data.frame(pazar = mk, varyant = vn, model = sn, b = round(r[["b"]], 4), t_ols = round(r[["t"]], 2),
          p_dsp_ag_ici = round(r[["p_dsp_ag_ici"]], 3), p_dsp_tum = round(r[["p_dsp_tum"]], 3), n_cift = r[["n_cift"]],
          n_ay_dislanan = if (vn == "aylik_tatil_haric") sum(tt %in% hmon) else 0, stringsAsFactors = FALSE)
      }
      cat("  step07 ikili:", mk, vn, "\n")
    }
  }
  dres <- do.call(rbind, dres)

  # ---- (c) descriptives ----
  used <- pn[is.finite(pn$dlog_y_geceleme_yerli), ]
  m_used <- sort(unique(used$t)); m_lag <- m_used[(m_used - 1) %in% m_used]  # months used in the lagged model
  lab_t <- function(v) sprintf("%04d-%02d", (v - 1) %/% 12, (v - 1) %% 12 + 1)
  expo <- read_csv_utf8(file.path(proj_dir, "step03b_exposure.csv")); expo <- expo[!expo$deprem_ili, ]
  mis <- vapply(c("yerli", "yabanci"), function(mk) {                    # number of observations with a missing neighbour but a non-missing own value
    y <- pn[[paste0("dlog_y_geceleme_", mk)]]; G <- to_grid(y); M <- !is.na(G); W <- Ws[[paste0("rota_", mk)]]
    sum(((W > 0) %*% (!M) * 1) > 0 & M & rowSums(W) > 0) }, numeric(1))
  fc <- read_csv_utf8(file.path(proj_dir, "step01b_file_check.csv")); fc <- fc[fc$tree == "bakanlik", ]
  fc <- fc[order(fc$year, fc$month), ]; chg <- which(c(FALSE, fc$coverage[-1] != fc$coverage[-nrow(fc)]))
  diagn <- rbind(
    data.frame(pazar = "-", olcu = "panel_yillik_kullanilan_ay_sayisi", deger = as.character(length(m_lag))),
    data.frame(pazar = "-", olcu = "panel_yillik_kullanilan_aylar", deger = paste(lab_t(m_lag), collapse = ";")),
    data.frame(pazar = c("yerli", "yabanci"), olcu = "deprem_rota_maruziyeti_pozitif_il",
               deger = as.character(c(sum(expo$rota_yerli > 0), sum(expo$rota_yabanci > 0)))),
    data.frame(pazar = c("yerli", "yabanci"), olcu = "deprem_rota_maruziyeti_ortalama_pozitif",
               deger = as.character(round(c(mean(expo$rota_yerli[expo$rota_yerli > 0]), mean(expo$rota_yabanci[expo$rota_yabanci > 0])), 3))),
    data.frame(pazar = c("yerli", "yabanci"), olcu = "eksik_komsu_ile_yeniden_agirliklandirilan_gozlem", deger = as.character(mis)),
    data.frame(pazar = "-", olcu = "bulten_kapsam_degisikligi", deger = if (length(chg)) paste(sprintf("%04d-%02d: %s -> %s", fc$year[chg], fc$month[chg], fc$coverage[chg - 1], fc$coverage[chg]), collapse = "; ") else "yok"),
    transform(do.call(rbind, diag_fs), deger = as.character(deger)), stringsAsFactors = FALSE)
  write_csv_utf8(pres, file.path(proj_dir, "step07_panel_timing.csv"))
  write_csv_utf8(dres, f07)
  write_csv_utf8(diagn, file.path(proj_dir, "step07_diagnostics.csv"))
  sh <- list(panel_timing = pres, dyadic_sensitivity = dres, diagnostics = diagn)
  fx <- file.path(proj_dir, "step07_robustness2.xlsx")
  okx <- tryCatch({ openxlsx::write.xlsx(sh, fx, overwrite = TRUE); TRUE }, error = function(e) FALSE)   # Option A
  if (!okx) okx <- tryCatch({ writexl::write_xlsx(sh, fx); TRUE }, error = function(e) FALSE)           # Option B (CSVs already written)
  cat("step07 -> panel zamanlamasi ve ikili duyarlilik:\n")
  print(pres[, c("pazar", "model", "sabit_etki", "b_rota", "se_rota", "p_rota", "p_perm_199", "n")], row.names = FALSE)
  print(dres, row.names = FALSE); print(diagn[diagn$olcu != "panel_yillik_kullanilan_aylar", ], row.names = FALSE)
  }
})

# =====================================================================
# step08: ROBUSTNESS TEST EXCLUDING THE PANDEMIC
#   Pandemic window: March 2020 - December 2021
#   Year-on-year growth: observations with month t OR month t-12 in the window are excluded (i.e. March 2020 - December 2022)
#   Month-on-month growth: observations with month t in the window are excluded
#   (a) Panel: year-on-year growth, 1-month lag, province+month and province+month+network x month; permutation (199) for the network x month version
#   (b) Dyadic: year-on-year and month-on-month growth, M0 (itinerary + geography) and M4 (+ 4 similarity measures), DSP permutation (999)
#   Outputs: step08_pandemic.csv, step08_pandemic.xlsx
# =====================================================================
f08 <- file.path(proj_dir, "step08_pandemic.csv")
log_warn("step08", {
  if (csv_ok(f08)) message("step08 zaten yapilmis, atlaniyor.") else {
  pn <- read_csv_utf8(f01d_panel)                                       # analysis panel
  ik <- sort(unique(pn$il_key)); n <- length(ik); tt <- sort(unique(pn$t))  # provinces and months (t = year*12 + month)
  readM <- function(f) { x <- read_csv_utf8(file.path(proj_dir, f)); M <- as.matrix(x[, -1]); dimnames(M) <- list(x$il_key, x$il_key); M[ik, ik] }  # reads a matrix
  Ws <- list(knn5 = readM("step02a_W_knn5.csv"), rota_yerli = readM("step02b2_W_route_yerli.csv"), rota_yabanci = readM("step02b2_W_route_yabanci.csv"))  # W matrices
  C <- list(yerli = readM("step02b2_C_route_yerli.csv"), yabanci = readM("step02b2_C_route_yabanci.csv"))  # numbers of shared programmes
  Dk <- readM("step02a_dist_km.csv"); Kc <- readM("step02a_W_contig.csv") > 0  # distance and contiguity
  uye <- list(yerli = rowSums(C$yerli) > 0, yabanci = rowSums(C$yabanci) > 0)  # network members
  ii <- match(pn$il_key, ik); jj <- match(pn$t, tt)                     # panel row -> matrix position
  to_grid <- function(y) { G <- matrix(NA_real_, n, length(tt)); G[cbind(ii, jj)] <- y; G }  # province x month matrix
  lag_cols <- function(G, k) cbind(matrix(NA_real_, n, k), G[, seq_len(ncol(G) - k), drop = FALSE])  # k-month shift
  wlag_k <- function(W, y, k) {                                         # W*y, lagged k months (same rule as step03a/step07)
    G <- to_grid(y); M <- !is.na(G); G0 <- G; G0[!M] <- 0
    num <- W %*% G0; den <- W %*% (M * 1); out <- ifelse(den > 0, num / den, NA)
    out[rowSums(W) == 0, ] <- 0                                         # province outside the network: 0 (absorbed by the province effect)
    lag_cols(out, k)[cbind(ii, jj)] }
  own_k <- function(y, k) lag_cols(to_grid(y), k)[cbind(ii, jj)]        # own growth, lagged k months
  clus_se <- function(fit, cl) {                                        # province-clustered SE
    if (requireNamespace("sandwich", quietly = TRUE)) return(sqrt(diag(sandwich::vcovCL(fit, cluster = cl, type = "HC1"))))  # Option A
    X <- model.matrix(fit); X <- X[, !is.na(coef(fit)), drop = FALSE]; e <- resid(fit); XtXi <- solve(crossprod(X))       # Option B: manual CR1
    meat <- Reduce(`+`, lapply(split(seq_along(e), cl), function(ix) { s <- crossprod(X[ix, , drop = FALSE], e[ix]); s %*% t(s) }))
    G <- length(unique(cl)); nn <- length(e); k <- ncol(X)
    v <- sqrt(diag(XtXi %*% meat %*% XtXi) * G / (G - 1) * (nn - 1) / (nn - k)); names(v) <- colnames(X); v }
  lab_t <- function(v) sprintf("%04d-%02d", (v - 1) %/% 12, (v - 1) %% 12 + 1)  # month number -> "YYYY-MM"
  p_bas <- 2020 * 12 + 3; p_son <- 2021 * 12 + 12                       # pandemic window: 2020-03 ... 2021-12
  pand_y <- (pn$t >= p_bas & pn$t <= p_son) | (pn$t - 12 >= p_bas & pn$t - 12 <= p_son)  # year-on-year growth: t or t-12 in the window
  pand_m <- pn$t >= p_bas & pn$t <= p_son                               # month-on-month growth: t in the window
  set.seed(20261115)                                                    # reproducible permutations
  out <- list()

  # ---- (a) panel: year-on-year growth, 1-month lag ----
  for (mk in c("yerli", "yabanci")) {
    Wr <- Ws[[paste0("rota_", mk)]]; mem <- which(uye[[mk]])
    y <- pn[[paste0("dlog_y_geceleme_", mk)]]; y[pand_y] <- NA         # pandemic observations excluded
    d0 <- data.frame(y = y, ylag = own_k(y, 1), knn5 = wlag_k(Ws$knn5, y, 1), rota = wlag_k(Wr, y, 1),
                     il = factor(pn$il_key), ay = factor(pn$t), fe_rota = factor(paste(uye[[mk]][ii], pn$t)))
    d <- d0[complete.cases(d0[, c("y", "ylag", "knn5", "rota")]), ]   # complete observations
    for (fe_mode in c("il_ay", "il_ay_agxay")) {
      fe_txt <- if (fe_mode == "il_ay") "il + ay" else "il + ay + fe_rota"  # fixed effects
      fit <- lm(as.formula(paste("y ~ ylag + knn5 + rota +", fe_txt)), data = d); se <- clus_se(fit, d$il)
      b <- coef(fit)[["rota"]]; s <- se[["rota"]]; p_perm <- NA_real_
      if (fe_mode == "il_ay_agxay") {                                   # node-label permutation (among network members)
        mm <- model.matrix(as.formula(paste("~ ylag + knn5 +", fe_txt)), data = d)  # regressors other than the itinerary lag
        qz <- qr(mm); ey <- qr.resid(qz, d$y); K <- qz$rank + 1; G <- length(unique(d$il)); N <- nrow(d)
        t_fwl <- function(rv) { r1 <- qr.resid(qz, rv); bb <- sum(r1 * ey) / sum(r1^2); e <- ey - bb * r1   # FWL coefficient
          sc <- rowsum(r1 * e, as.character(d$il)); v <- sum(sc^2) / sum(r1^2)^2 * G / (G - 1) * (N - 1) / (N - K); bb / sqrt(v) }  # province-clustered t
        t_obs <- t_fwl(d$rota); tp <- rep(NA_real_, 199)
        for (r in 1:199) {
          pm <- seq_len(n); pm[mem] <- sample(mem); Wp <- Wr[pm, pm]; dimnames(Wp) <- dimnames(Wr)  # labels are shuffled
          rp <- wlag_k(Wp, y, 1)[as.integer(rownames(d))]                 # same sample rows
          if (all(is.finite(rp))) tp[r] <- t_fwl(rp)
        }
        p_perm <- round((1 + sum(tp >= t_obs, na.rm = TRUE)) / (1 + sum(is.finite(tp))), 3)  # one-sided p
      }
      out[[length(out) + 1]] <- data.frame(tasarim = "panel", pazar = mk, buyume = "yillik", model = fe_mode,
        b = round(b, 4), se = round(s, 4), p_perm = p_perm, p_dsp_ag_ici = NA, p_dsp_tum = NA,
        n_gozlem = nrow(d), n_ay = length(unique(d$ay)), stringsAsFactors = FALSE)
      cat("  step08 panel:", mk, fe_mode, "| b =", round(b, 4), "| se =", round(s, 4), "| p_perm =", p_perm, "\n")
    }
  }

  # ---- (b) dyadic: province-pair correlations ----
  up <- which(upper.tri(Dk), arr.ind = TRUE)                            # 3240 province pairs
  Xfe <- matrix(0, nrow(up), n); Xfe[cbind(seq_len(nrow(up)), up[, 1])] <- 1; Xfe[cbind(seq_len(nrow(up)), up[, 2])] <- 1  # province effects
  kiyi <- c("adana", "antalya", "artvin", "aydin", "balikesir", "bartin", "bursa", "canakkale", "duzce", "edirne", "giresun", "hatay",
            "istanbul", "izmir", "kastamonu", "kirklareli", "kocaeli", "mersin", "mugla", "ordu", "rize", "sakarya", "samsun", "sinop",
            "tekirdag", "trabzon", "yalova", "zonguldak")                 # the 28 coastal provinces
  pre <- pn[pn$year >= 2017 & pn$year <= 2019, ]                        # similarity measures 2017-2019 (same as the main analysis)
  prof <- function(v) { a <- aggregate(pre[[v]], by = list(il = pre$il_key, ay = pre$month), FUN = function(z) sum(z, na.rm = TRUE))
    P <- matrix(0, n, 12, dimnames = list(ik, 1:12)); P[cbind(match(a$il, ik), a$ay)] <- a$x; P / pmax(rowSums(P), 1) }  # seasonal profile
  tot <- function(v) { a <- tapply(pre[[v]], pre$il_key, sum, na.rm = TRUE); a[ik] }  # province totals
  yab_pay <- tot("geceleme_yabanci") / pmax(tot("geceleme_yabanci") + tot("geceleme_yerli"), 1)  # foreign share
  boy <- log1p((tot("geceleme_yabanci") + tot("geceleme_yerli")) / 36)  # size (log monthly mean)
  resid_mat <- function(y, fe_formula) {                                # fixed-effect residuals, province x month matrix
    d <- data.frame(y = y, il = factor(pn$il_key), ay = factor(pn$t), il_takvim = factor(paste(pn$il_key, pn$month)))
    ok <- is.finite(d$y); fit <- lm(fe_formula, data = d[ok, ])
    E <- matrix(NA_real_, n, length(tt)); E[cbind(match(pn$il_key[ok], ik), match(pn$t[ok], tt))] <- resid(fit); E }
  pair_stat <- function(E, min_ay = 36) {                               # Fisher z and number of common months
    zz <- numeric(nrow(up)); na <- integer(nrow(up))
    for (p in seq_len(nrow(up))) { a <- E[up[p, 1], ]; b <- E[up[p, 2], ]; ok <- is.finite(a) & is.finite(b); na[p] <- sum(ok)
      zz[p] <- if (sum(ok) < min_ay) NA_real_ else atanh(max(min(cor(a[ok], b[ok]), 0.999), -0.999)) }
    list(z = zz, n_ay = na) }
  dsp_test <- function(z, x, Z, mem, R = 999) {                         # DSP permutation (same as step06/step07)
    ok <- is.finite(z) & is.finite(x) & rowSums(!is.finite(Z)) == 0
    qz <- qr(Z[ok, , drop = FALSE]); df <- sum(ok) - qz$rank - 1
    rx <- qr.resid(qz, x[ok]); ez <- qr.resid(qz, z[ok])                # x and z are purged of the controls + province effects
    tf <- function(r1) { b <- sum(r1 * ez) / sum(r1^2); e <- ez - b * r1; b / sqrt(sum(e^2) / df / sum(r1^2)) }  # t-statistic
    t_obs <- tf(rx); b_obs <- sum(rx * ez) / sum(rx^2); se_obs <- b_obs / t_obs
    RXv <- rep(NA_real_, length(x)); RXv[ok] <- rx; RX <- matrix(0, n, n); RX[up] <- ifelse(is.na(RXv), 0, RXv); RX <- RX + t(RX)
    tp <- matrix(NA_real_, R, 2)
    for (k in seq_len(R)) {
      pa <- seq_len(n); pa[mem] <- sample(mem); pb <- sample.int(n)      # within network / all provinces
      tp[k, 1] <- tf(qr.resid(qz, RX[pa, pa][up][ok])); tp[k, 2] <- tf(qr.resid(qz, RX[pb, pb][up][ok]))
    }
    c(b = b_obs, se = se_obs, p1 = (1 + sum(tp[, 1] >= t_obs)) / (1 + R), p2 = (1 + sum(tp[, 2] >= t_obs)) / (1 + R), n_cift = sum(ok)) }
  for (mk in c("yerli", "yabanci")) {
    Cm <- C[[mk]]; mem <- which(uye[[mk]])
    P <- prof(paste0("geceleme_", mk)); mevs <- cor(t(P)); mevs[!is.finite(mevs)] <- 0  # seasonality similarity
    sim <- cbind(mevsim_benzer = mevs[up], yab_pay_fark = abs(yab_pay[up[, 1]] - yab_pay[up[, 2]]),
                 kiyi_ikisi = as.numeric(ik[up[, 1]] %in% kiyi & ik[up[, 2]] %in% kiyi), buyukluk_fark = abs(boy[up[, 1]] - boy[up[, 2]]))
    geo <- cbind(komsu = as.numeric(Kc[up]), log_uzaklik = log(Dk[up])) # geographic controls
    x <- log1p(Cm[up])                                                  # itinerary intensity ln(1 + c)
    yy <- pn[[paste0("dlog_y_geceleme_", mk)]]; yy[pand_y] <- NA        # year-on-year growth, pandemic excluded
    ym <- pn[[paste0("dlog_m_geceleme_", mk)]]; ym[pand_m] <- NA        # month-on-month growth, pandemic excluded
    vars <- list(yillik = resid_mat(yy, y ~ il + ay), aylik = resid_mat(ym, y ~ il_takvim + ay))
    for (vn in names(vars)) {
      ps <- pair_stat(vars[[vn]])
      for (sn in c("M0_rota", "M4_tum_benzerlik")) {
        Z <- cbind(geo, if (sn == "M4_tum_benzerlik") sim else NULL, Xfe)
        r <- dsp_test(ps$z, x, Z, mem)
        out[[length(out) + 1]] <- data.frame(tasarim = "ikili", pazar = mk, buyume = vn, model = sn,
          b = round(r[["b"]], 4), se = round(r[["se"]], 4), p_perm = NA, p_dsp_ag_ici = round(r[["p1"]], 3), p_dsp_tum = round(r[["p2"]], 3),
          n_gozlem = r[["n_cift"]], n_ay = median(ps$n_ay), stringsAsFactors = FALSE)
        cat("  step08 ikili:", mk, vn, sn, "| b =", round(r[["b"]], 4), "| p_dsp =", round(r[["p1"]], 3), "/", round(r[["p2"]], 3), "\n")
      }
    }
  }
  res <- do.call(rbind, out)
  aylar <- data.frame(olcu = c("pandemi_penceresi", "yillik_dislanan_aylar"),
                      deger = c(paste(lab_t(p_bas), "-", lab_t(p_son)), paste(lab_t(p_bas), "-", lab_t(p_son + 12))), stringsAsFactors = FALSE)
  write_csv_utf8(res, f08)
  sh <- list(pandemic = res, aylar = aylar)
  fx <- file.path(proj_dir, "step08_pandemic.xlsx")
  okx <- tryCatch({ openxlsx::write.xlsx(sh, fx, overwrite = TRUE); TRUE }, error = function(e) FALSE)   # Option A
  if (!okx) okx <- tryCatch({ writexl::write_xlsx(sh, fx); TRUE }, error = function(e) FALSE)           # Option B (CSV already written)
  cat("step08 -> pandemi haric sonuclar:\n"); print(res, row.names = FALSE)
  }
})

# =====================================================================
# step09: LEAD-LAG INFERENCE + CONSISTENT DEDUPLICATION OF THE INTERNATIONAL NETWORK
#   (a) Lead-lag: residual of i with the residual of j one month earlier and vice versa; the mean Fisher z of the two directions
#       is the dependent variable; the contemporaneous z is controlled for; HC1 SE + DSP permutation (999), year-on-year and month-on-month growth
#   (b) International network: TourRadar programmes are deduplicated by province set only, as for the domestic network;
#       network statistics + dyadic model (M0 intensity, M4 + 4 similarity measures), DSP (999)
#   (c) Gini coefficient: over 81 provinces and over network provinces only (both markets + deduplicated international network)
#   Outputs: step09_inference.csv (regressions), step09_network_stats.csv (network statistics)
# =====================================================================
f09a <- file.path(proj_dir, "step09_inference.csv")
f09b <- file.path(proj_dir, "step09_network_stats.csv")
log_warn("step09", {
  if (csv_ok(f09a) && csv_ok(f09b)) message("step09 zaten yapilmis, atlaniyor.") else {
  pn <- read_csv_utf8(f01d_panel)                                       # analysis panel
  ik <- sort(unique(pn$il_key)); n <- length(ik); tt <- sort(unique(pn$t))  # provinces and months
  readM <- function(f) { x <- read_csv_utf8(file.path(proj_dir, f)); M <- as.matrix(x[, -1]); dimnames(M) <- list(x$il_key, x$il_key); M[ik, ik] }  # reads a matrix
  C <- list(yerli = readM("step02b2_C_route_yerli.csv"), yabanci = readM("step02b2_C_route_yabanci.csv"))  # numbers of shared programmes
  Dk <- readM("step02a_dist_km.csv"); Kc <- readM("step02a_W_contig.csv") > 0  # distance and contiguity
  up <- which(upper.tri(Dk), arr.ind = TRUE)                            # 3240 province pairs
  Xfe <- matrix(0, nrow(up), n); Xfe[cbind(seq_len(nrow(up)), up[, 1])] <- 1; Xfe[cbind(seq_len(nrow(up)), up[, 2])] <- 1  # province effects
  geo <- cbind(komsu = as.numeric(Kc[up]), log_uzaklik = log(Dk[up]))  # geographic controls
  resid_mat <- function(y, fe_formula) {                                # fixed-effect residuals, province x month matrix
    d <- data.frame(y = y, il = factor(pn$il_key), ay = factor(pn$t), il_takvim = factor(paste(pn$il_key, pn$month)))
    ok <- is.finite(d$y); fit <- lm(fe_formula, data = d[ok, ])
    E <- matrix(NA_real_, n, length(tt)); E[cbind(match(pn$il_key[ok], ik), match(pn$t[ok], tt))] <- resid(fit); E }
  fz <- function(a, b, min_ay = 36) { ok <- is.finite(a) & is.finite(b)  # Fisher z for two series (too few months: NA)
    if (sum(ok) < min_ay) NA_real_ else atanh(max(min(cor(a[ok], b[ok]), 0.999), -0.999)) }
  lagc <- function(E) cbind(NA_real_, E[, -ncol(E), drop = FALSE])      # shift back by one month
  pair_z <- function(E) {                                               # contemporaneous, i<-j, j<-i and the mean of both directions
    El <- lagc(E); z0 <- z1 <- z2 <- numeric(nrow(up))
    for (p in seq_len(nrow(up))) { i <- up[p, 1]; j <- up[p, 2]
      z0[p] <- fz(E[i, ], E[j, ]); z1[p] <- fz(E[i, ], El[j, ]); z2[p] <- fz(E[j, ], El[i, ]) }
    list(z = z0, z_ij = z1, z_ji = z2, z_ll = (z1 + z2) / 2) }
  hc1 <- function(z, X, term) {                                         # HC1 standard error (province effects included)
    ok <- is.finite(z) & rowSums(!is.finite(X)) == 0
    d <- data.frame(z = z[ok], X[ok, , drop = FALSE], Xfe[ok, , drop = FALSE]); fit <- lm(z ~ . - 1 + 0, data = d)
    se <- if (requireNamespace("sandwich", quietly = TRUE)) sqrt(diag(sandwich::vcovHC(fit, type = "HC1")))[[term]] else {  # Option A
      X1 <- model.matrix(fit); X1 <- X1[, !is.na(coef(fit)), drop = FALSE]; e <- resid(fit); XtXi <- solve(crossprod(X1))      # Option B: manual HC1
      V <- XtXi %*% crossprod(X1 * e) %*% XtXi * nrow(X1) / (nrow(X1) - ncol(X1)); sqrt(diag(V))[[term]] }
    c(b = unname(coef(fit)[[term]]), se = unname(se)) }
  dsp_test <- function(z, x, Z, mem, R = 999) {                         # DSP permutation (same as step06-08)
    ok <- is.finite(z) & is.finite(x) & rowSums(!is.finite(Z)) == 0
    qz <- qr(Z[ok, , drop = FALSE]); df <- sum(ok) - qz$rank - 1
    rx <- qr.resid(qz, x[ok]); ez <- qr.resid(qz, z[ok])                # x and z are purged of the controls + province effects
    tf <- function(r1) { b <- sum(r1 * ez) / sum(r1^2); e <- ez - b * r1; b / sqrt(sum(e^2) / df / sum(r1^2)) }  # t-statistic
    t_obs <- tf(rx)
    RXv <- rep(NA_real_, length(x)); RXv[ok] <- rx; RX <- matrix(0, n, n); RX[up] <- ifelse(is.na(RXv), 0, RXv); RX <- RX + t(RX)
    tp <- matrix(NA_real_, R, 2)
    for (k in seq_len(R)) {
      pa <- seq_len(n); pa[mem] <- sample(mem); pb <- sample.int(n)      # within network / all provinces
      tp[k, 1] <- tf(qr.resid(qz, RX[pa, pa][up][ok])); tp[k, 2] <- tf(qr.resid(qz, RX[pb, pb][up][ok]))
    }
    c(p1 = (1 + sum(tp[, 1] >= t_obs)) / (1 + R), p2 = (1 + sum(tp[, 2] >= t_obs)) / (1 + R), n_cift = sum(ok)) }
  kiyi <- c("adana", "antalya", "artvin", "aydin", "balikesir", "bartin", "bursa", "canakkale", "duzce", "edirne", "giresun", "hatay",
            "istanbul", "izmir", "kastamonu", "kirklareli", "kocaeli", "mersin", "mugla", "ordu", "rize", "sakarya", "samsun", "sinop",
            "tekirdag", "trabzon", "yalova", "zonguldak")                 # the 28 coastal provinces
  pre <- pn[pn$year >= 2017 & pn$year <= 2019, ]                        # similarity measures 2017-2019 (same as the main analysis)
  prof <- function(v) { a <- aggregate(pre[[v]], by = list(il = pre$il_key, ay = pre$month), FUN = function(z) sum(z, na.rm = TRUE))
    P <- matrix(0, n, 12, dimnames = list(ik, 1:12)); P[cbind(match(a$il, ik), a$ay)] <- a$x; P / pmax(rowSums(P), 1) }  # seasonal profile
  tot <- function(v) { a <- tapply(pre[[v]], pre$il_key, sum, na.rm = TRUE); a[ik] }  # province totals
  yab_pay <- tot("geceleme_yabanci") / pmax(tot("geceleme_yabanci") + tot("geceleme_yerli"), 1)  # foreign share
  boy <- log1p((tot("geceleme_yabanci") + tot("geceleme_yerli")) / 36)  # size
  sim_mat <- function(mk) { P <- prof(paste0("geceleme_", mk)); mevs <- cor(t(P)); mevs[!is.finite(mevs)] <- 0
    cbind(mevsim_benzer = mevs[up], yab_pay_fark = abs(yab_pay[up[, 1]] - yab_pay[up[, 2]]),
          kiyi_ikisi = as.numeric(ik[up[, 1]] %in% kiyi & ik[up[, 2]] %in% kiyi), buyukluk_fark = abs(boy[up[, 1]] - boy[up[, 2]])) }

  # ---- (b) consistently deduplicated international network ----
  tp0 <- read_csv_utf8(file.path(proj_dir, "step02b2_tour_provinces.csv"))  # programme -> list of provinces
  nil <- suppressWarnings(as.numeric(tp0$n_il)); nil[!is.finite(nil)] <- 0
  yb <- tp0[tp0$pazar == "yabanci" & nil >= 2, ]                        # international programmes visiting at least two provinces
  kumeler <- unique(as.character(yb$iller))                             # unique by province set only
  Cu <- matrix(0, n, n, dimnames = list(ik, ik))
  for (s in kumeler) { v <- intersect(strsplit(s, ";", fixed = TRUE)[[1]], ik)   # provinces in the set
    if (length(v) >= 2) { pr <- t(combn(v, 2)); Cu[pr] <- Cu[pr] + 1; Cu[pr[, 2:1, drop = FALSE]] <- Cu[pr[, 2:1, drop = FALSE]] + 1 } }
  gini <- function(v) { v <- sort(v); m <- length(v); if (sum(v) == 0) return(NA_real_); sum((2 * seq_len(m) - m - 1) * v) / (m * sum(v)) }
  netstat <- function(Cm, ad, n_prog) { gu <- rowSums(Cm); bag <- Cm[up] > 0   # network statistics
    data.frame(ag = ad, n_program = n_prog, n_il = sum(gu > 0), n_bagli_cift = sum(bag),
      denizli_nevsehir = Cm["denizli", "nevsehir"], denizli_nevsehir_pay = round(Cm["denizli", "nevsehir"] / n_prog, 3),
      gini_81_il = round(gini(gu), 3), gini_ag_ici = round(gini(gu[gu > 0]), 3),
      medyan_uzaklik_km = round(median(Dk[up][bag]), 0), pay_komsu_olmayan = round(mean(!Kc[up][bag]), 3), stringsAsFactors = FALSE) }
  n_yerli <- length(unique(tp0$program[tp0$pazar == "yerli" & nil >= 2]))  # number of domestic programmes (160 expected)
  stats <- rbind(netstat(C$yerli, "yerli", n_yerli), netstat(C$yabanci, "yabanci_mevcut", nrow(yb)),
                 netstat(Cu, "yabanci_il_kumesi_tekil", length(kumeler)))
  stats$jaccard_yerli <- round(sapply(list(C$yerli, C$yabanci, Cu), function(M) sum(M[up] > 0 & C$yerli[up] > 0) / sum(M[up] > 0 | C$yerli[up] > 0)), 3)  # overlap with the domestic network
  cat("step09 ag istatistikleri:\n"); print(stats, row.names = FALSE)

  # ---- (a) + (b) regressions ----
  set.seed(20261116)                                                    # reproducible permutations
  out <- list()
  for (mk in c("yerli", "yabanci")) {
    mem <- which(rowSums(C[[mk]]) > 0)
    y_y <- pn[[paste0("dlog_y_geceleme_", mk)]]; y_m <- pn[[paste0("dlog_m_geceleme_", mk)]]
    vars <- list(yillik = resid_mat(y_y, y ~ il + ay), aylik = resid_mat(y_m, y ~ il_takvim + ay))
    for (vn in names(vars)) {
      pz <- pair_z(vars[[vn]])
      # (a) lead-lag: tie (0/1) and intensity, contemporaneous z controlled for
      for (xv in c("bag", "yogunluk")) {
        x <- if (xv == "bag") as.numeric(C[[mk]][up] > 0) else log1p(C[[mk]][up])
        Z <- cbind(geo, z_es = pz$z, Xfe)
        h <- hc1(pz$z_ll, cbind(x = x, geo, z_es = pz$z), "x")          # mean of both directions
        h1 <- hc1(pz$z_ij, cbind(x = x, geo, z_es = pz$z), "x")         # one direction (for comparison with the main dyadic table)
        r <- dsp_test(pz$z_ll, x, Z, mem)
        out[[length(out) + 1]] <- data.frame(bolum = "oncul_gecikmeli", pazar = mk, ag = mk, buyume = vn, model = paste0("LL_", xv),
          b = round(h[["b"]], 4), se_hc1 = round(h[["se"]], 4), p_dsp_ag_ici = round(r[["p1"]], 3), p_dsp_tum = round(r[["p2"]], 3),
          b_tek_yon = round(h1[["b"]], 4), n_cift = r[["n_cift"]], stringsAsFactors = FALSE)
        cat("  step09 oncul-gecikmeli:", mk, vn, xv, "| b =", round(h[["b"]], 4), "| se =", round(h[["se"]], 4),
            "| p =", round(r[["p1"]], 3), "/", round(r[["p2"]], 3), "\n")
      }
      # (b) consistently deduplicated international network (international market only)
      if (mk == "yabanci") {
        memu <- which(rowSums(Cu) > 0); x <- log1p(Cu[up]); sim <- sim_mat(mk)
        for (sn in c("M0_rota", "M4_tum_benzerlik")) {
          Xc <- cbind(x = x, geo, if (sn == "M4_tum_benzerlik") sim else NULL)
          h <- hc1(pz$z, Xc, "x"); r <- dsp_test(pz$z, x, cbind(Xc[, -1, drop = FALSE], Xfe), memu)
          out[[length(out) + 1]] <- data.frame(bolum = "tekil_ag", pazar = mk, ag = "yabanci_il_kumesi_tekil", buyume = vn, model = sn,
            b = round(h[["b"]], 4), se_hc1 = round(h[["se"]], 4), p_dsp_ag_ici = round(r[["p1"]], 3), p_dsp_tum = round(r[["p2"]], 3),
            b_tek_yon = NA, n_cift = r[["n_cift"]], stringsAsFactors = FALSE)
          cat("  step09 tekil ag:", vn, sn, "| b =", round(h[["b"]], 4), "| se =", round(h[["se"]], 4),
              "| p =", round(r[["p1"]], 3), "/", round(r[["p2"]], 3), "\n")
        }
      }
    }
  }
  res <- do.call(rbind, out)
  write_csv_utf8(res, f09a); write_csv_utf8(stats, f09b)              # CSV only (no xlsx written)
  cat("step09 -> sonuclar:\n"); print(res, row.names = FALSE)
  }
})

# =====================================================================
# step10: INTERNATIONAL MONTHLY LEAD-LAG ASSOCIATION - HOLIDAY/EASTER MONTHS EXCLUDED
#   In step09 the lead-lag intensity coefficient was significant for international month-on-month growth.
#   The same test is repeated excluding the holiday definition of step07 (month of the Ramadan and Sacrifice holidays + next month, Easter month + next month).
#   Because a one-month lagged series is used, an observation is dropped if t or t-1 is a holiday month.
#   Output: step10_leadlag_holiday.csv
# =====================================================================
f10 <- file.path(proj_dir, "step10_leadlag_holiday.csv")
log_warn("step10", {
  if (csv_ok(f10)) message("step10 zaten yapilmis, atlaniyor.") else {
  pn <- read_csv_utf8(f01d_panel)                                       # analysis panel
  ik <- sort(unique(pn$il_key)); n <- length(ik); tt <- sort(unique(pn$t))  # provinces and months (t = year*12 + month)
  readM <- function(f) { x <- read_csv_utf8(file.path(proj_dir, f)); M <- as.matrix(x[, -1]); dimnames(M) <- list(x$il_key, x$il_key); M[ik, ik] }  # reads a matrix
  Cm <- readM("step02b2_C_route_yabanci.csv")                           # numbers of shared international programmes
  Dk <- readM("step02a_dist_km.csv"); Kc <- readM("step02a_W_contig.csv") > 0  # distance and contiguity
  up <- which(upper.tri(Dk), arr.ind = TRUE)                            # 3240 province pairs
  Xfe <- matrix(0, nrow(up), n); Xfe[cbind(seq_len(nrow(up)), up[, 1])] <- 1; Xfe[cbind(seq_len(nrow(up)), up[, 2])] <- 1  # province effects
  geo <- cbind(komsu = as.numeric(Kc[up]), log_uzaklik = log(Dk[up]))  # geographic controls
  mem <- which(rowSums(Cm) > 0)                                         # network members
  d <- data.frame(y = pn$dlog_m_geceleme_yabanci, il_takvim = factor(paste(pn$il_key, pn$month)), ay = factor(pn$t))
  ok <- is.finite(d$y); fit <- lm(y ~ il_takvim + ay, data = d[ok, ]) # month-on-month growth residuals (same as step06/07/09)
  E <- matrix(NA_real_, n, length(tt)); E[cbind(match(pn$il_key[ok], ik), match(pn$t[ok], tt))] <- resid(fit)
  hol <- list(                                                          # first days of the religious holidays and Easter (same as step07)
    ramazan = as.Date(c("2017-06-25", "2018-06-15", "2019-06-04", "2020-05-24", "2021-05-13", "2022-05-02", "2023-04-21", "2024-04-10", "2025-03-30", "2026-03-20")),
    kurban = as.Date(c("2017-09-01", "2018-08-21", "2019-08-11", "2020-07-31", "2021-07-20", "2022-07-09", "2023-06-28", "2024-06-16", "2025-06-06", "2026-05-27")),
    paskalya = as.Date(c("2017-04-16", "2018-04-01", "2019-04-21", "2020-04-12", "2021-04-04", "2022-04-17", "2023-04-09", "2024-03-31", "2025-04-20", "2026-04-05")))
  hol_t <- function(dd, span) { s <- unique(c(as.numeric(format(dd, "%Y")) * 12 + as.numeric(format(dd, "%m")),
                                              as.numeric(format(dd + span, "%Y")) * 12 + as.numeric(format(dd + span, "%m")))); unique(c(s, s + 1)) }  # holiday month and the following month
  hmon <- c(hol_t(hol$ramazan, 3), hol_t(hol$kurban, 4), hol_t(hol$paskalya, 1))  # months to exclude
  Eh <- E; Eh[, tt %in% hmon] <- NA                                      # holiday months excluded
  fz <- function(a, b, min_ay = 36) { ok <- is.finite(a) & is.finite(b)  # Fisher z (too few months: NA)
    if (sum(ok) < min_ay) NA_real_ else atanh(max(min(cor(a[ok], b[ok]), 0.999), -0.999)) }
  pair_z <- function(E) {                                               # contemporaneous and mean of both directions (same as step09)
    El <- cbind(NA_real_, E[, -ncol(E), drop = FALSE]); z0 <- z1 <- z2 <- numeric(nrow(up)); na <- integer(nrow(up))
    for (p in seq_len(nrow(up))) { i <- up[p, 1]; j <- up[p, 2]
      z0[p] <- fz(E[i, ], E[j, ]); z1[p] <- fz(E[i, ], El[j, ]); z2[p] <- fz(E[j, ], El[i, ])
      na[p] <- sum(is.finite(E[i, ]) & is.finite(El[j, ])) }
    list(z = z0, z_ll = (z1 + z2) / 2, n_ay = na) }
  hc1 <- function(z, X) {                                               # HC1 standard error, for the first column
    okk <- is.finite(z) & rowSums(!is.finite(X)) == 0
    dd <- data.frame(z = z[okk], X[okk, , drop = FALSE], Xfe[okk, , drop = FALSE]); f <- lm(z ~ . - 1 + 0, data = dd)
    se <- if (requireNamespace("sandwich", quietly = TRUE)) sqrt(diag(sandwich::vcovHC(f, type = "HC1")))[["x"]] else {  # Option A
      X1 <- model.matrix(f); X1 <- X1[, !is.na(coef(f)), drop = FALSE]; e <- resid(f); XtXi <- solve(crossprod(X1))       # Option B: manual HC1
      V <- XtXi %*% crossprod(X1 * e) %*% XtXi * nrow(X1) / (nrow(X1) - ncol(X1)); sqrt(diag(V))[["x"]] }
    c(b = unname(coef(f)[["x"]]), se = unname(se)) }
  dsp_test <- function(z, x, Z, R = 999) {                              # DSP permutation (same as step06-09)
    okk <- is.finite(z) & is.finite(x) & rowSums(!is.finite(Z)) == 0
    qz <- qr(Z[okk, , drop = FALSE]); df <- sum(okk) - qz$rank - 1
    rx <- qr.resid(qz, x[okk]); ez <- qr.resid(qz, z[okk])
    tf <- function(r1) { b <- sum(r1 * ez) / sum(r1^2); e <- ez - b * r1; b / sqrt(sum(e^2) / df / sum(r1^2)) }
    t_obs <- tf(rx); RXv <- rep(NA_real_, length(x)); RXv[okk] <- rx
    RX <- matrix(0, n, n); RX[up] <- ifelse(is.na(RXv), 0, RXv); RX <- RX + t(RX); tp <- matrix(NA_real_, R, 2)
    for (k in seq_len(R)) { pa <- seq_len(n); pa[mem] <- sample(mem); pb <- sample.int(n)  # within network / all provinces
      tp[k, 1] <- tf(qr.resid(qz, RX[pa, pa][up][okk])); tp[k, 2] <- tf(qr.resid(qz, RX[pb, pb][up][okk])) }
    c(p1 = (1 + sum(tp[, 1] >= t_obs)) / (1 + R), p2 = (1 + sum(tp[, 2] >= t_obs)) / (1 + R), n_cift = sum(okk)) }
  set.seed(20261117)                                                    # reproducible permutations
  out <- list()
  for (vn in c("tum_aylar", "tatil_haric")) {
    pz <- pair_z(if (vn == "tum_aylar") E else Eh)
    for (xv in c("bag", "yogunluk")) {
      x <- if (xv == "bag") as.numeric(Cm[up] > 0) else log1p(Cm[up])
      h <- hc1(pz$z_ll, cbind(x = x, geo, z_es = pz$z)); r <- dsp_test(pz$z_ll, x, cbind(geo, z_es = pz$z, Xfe))
      out[[length(out) + 1]] <- data.frame(pazar = "yabanci", buyume = "aylik", varyant = vn, model = paste0("LL_", xv),
        b = round(h[["b"]], 4), se_hc1 = round(h[["se"]], 4), p_dsp_ag_ici = round(r[["p1"]], 3), p_dsp_tum = round(r[["p2"]], 3),
        n_cift = r[["n_cift"]], medyan_ortak_ay = median(pz$n_ay), n_ay_dislanan = if (vn == "tatil_haric") sum(tt %in% hmon) else 0,
        stringsAsFactors = FALSE)
      cat("  step10:", vn, xv, "| b =", round(h[["b"]], 4), "| se =", round(h[["se"]], 4), "| p =", round(r[["p1"]], 3), "/", round(r[["p2"]], 3), "\n")
    }
  }
  res <- do.call(rbind, out); write_csv_utf8(res, f10)                  # CSV only
  cat("step10 -> sonuclar:\n"); print(res, row.names = FALSE)
  }
})

# =====================================================================
# step11: PERIOD SPLIT
#   Aim 1 - "mechanical association" objection: similarity measures are computed from 2017-2019 (as in the main analysis);
#            co-movement (pair correlation) is computed ONLY from months after 2022 -> the two measures share no month.
#            The itinerary intensity coefficient is compared between M0 (itinerary + geography) and M4 (+ 4 similarity measures).
#            Additional late-period model M4_gec: similarity from 2023-2024 (contemporaneous measure) -> helps to tell whether
#            the attenuation is "mechanical" or due to an "outdated 2017-2019 measure".
#   Aim 2 - "does the 2026 network represent the past" objection: the M0 coefficient is estimated separately for the early (2017-01..2020-02)
#            and late (2022-01 onwards) periods; the difference (late - early z) is also tested with DSP.
#   Periods: month-on-month growth  early 2017-02..2020-02, late 2022-01..2026-09
#             year-on-year growth early 2018-01..2020-02, late 2023-01.. (so that t-12 is also after the pandemic)
#   Residuals are computed with separate fixed effects in each period; minimum common months: monthly 30, yearly 18.
#   HC1 SE (Option A: sandwich, Option B: manual) + DSP permutation (999), within network and all provinces.
#   Output: step11_period_split.csv (CSV only)
# =====================================================================
f11 <- file.path(proj_dir, "step11_period_split.csv")
log_warn("step11", {
  if (csv_ok(f11)) message("step11 zaten yapilmis, atlaniyor.") else {
  pn <- read_csv_utf8(f01d_panel)                                       # analysis panel
  ik <- sort(unique(pn$il_key)); n <- length(ik); tt <- sort(unique(pn$t))  # provinces and months (t = year*12 + month)
  readM <- function(f) { x <- read_csv_utf8(file.path(proj_dir, f)); M <- as.matrix(x[, -1]); dimnames(M) <- list(x$il_key, x$il_key); M[ik, ik] }  # reads a matrix
  C <- list(yerli = readM("step02b2_C_route_yerli.csv"), yabanci = readM("step02b2_C_route_yabanci.csv"))  # numbers of shared programmes
  Dk <- readM("step02a_dist_km.csv"); Kc <- readM("step02a_W_contig.csv") > 0  # distance and contiguity
  up <- which(upper.tri(Dk), arr.ind = TRUE)                            # 3240 province pairs
  Xfe <- matrix(0, nrow(up), n); Xfe[cbind(seq_len(nrow(up)), up[, 1])] <- 1; Xfe[cbind(seq_len(nrow(up)), up[, 2])] <- 1  # province effects
  geo <- cbind(komsu = as.numeric(Kc[up]), log_uzaklik = log(Dk[up]))  # geographic controls
  kiyi <- c("adana", "antalya", "artvin", "aydin", "balikesir", "bartin", "bursa", "canakkale", "duzce", "edirne", "giresun", "hatay",
            "istanbul", "izmir", "kastamonu", "kirklareli", "kocaeli", "mersin", "mugla", "ordu", "rize", "sakarya", "samsun", "sinop",
            "tekirdag", "trabzon", "yalova", "zonguldak")                 # the 28 coastal provinces (same as step03d)
  sim_make <- function(yil, mk) {                                       # 4 similarity measures from the given years
    pre <- pn[pn$year %in% yil, ]; n_ay <- 12 * length(yil)              # similarity period
    prof <- function(v) { a <- aggregate(pre[[v]], by = list(il = pre$il_key, ay = pre$month), FUN = function(z) sum(z, na.rm = TRUE))
      P <- matrix(0, n, 12, dimnames = list(ik, 1:12)); P[cbind(match(a$il, ik), a$ay)] <- a$x; P / pmax(rowSums(P), 1) }  # seasonal profile
    tot <- function(v) { a <- tapply(pre[[v]], pre$il_key, sum, na.rm = TRUE); a <- a[ik]; a[is.na(a)] <- 0; a }  # province totals
    yab_pay <- tot("geceleme_yabanci") / pmax(tot("geceleme_yabanci") + tot("geceleme_yerli"), 1)  # foreign share
    boy <- log1p((tot("geceleme_yabanci") + tot("geceleme_yerli")) / n_ay)  # size (log monthly mean)
    P <- prof(paste0("geceleme_", mk)); mevs <- cor(t(P)); mevs[!is.finite(mevs)] <- 0  # seasonality similarity
    cbind(mevsim_benzer = mevs[up], yab_pay_fark = abs(yab_pay[up[, 1]] - yab_pay[up[, 2]]),
          kiyi_ikisi = as.numeric(ik[up[, 1]] %in% kiyi & ik[up[, 2]] %in% kiyi), buyukluk_fark = abs(boy[up[, 1]] - boy[up[, 2]])) }
  resid_mat <- function(y, fe_formula) {                                # fixed-effect residuals, province x month matrix
    d <- data.frame(y = y, il = factor(pn$il_key), ay = factor(pn$t), il_takvim = factor(paste(pn$il_key, pn$month)))
    ok <- is.finite(d$y); fit <- lm(fe_formula, data = droplevels(d[ok, ]))  # observations of the period only
    E <- matrix(NA_real_, n, length(tt)); E[cbind(match(pn$il_key[ok], ik), match(pn$t[ok], tt))] <- resid(fit); E }
  pair_stat <- function(E, min_ay) {                                    # Fisher z and number of common months
    zz <- numeric(nrow(up)); na <- integer(nrow(up))
    for (p in seq_len(nrow(up))) { a <- E[up[p, 1], ]; b <- E[up[p, 2], ]; ok <- is.finite(a) & is.finite(b); na[p] <- sum(ok)
      zz[p] <- if (na[p] < min_ay || sd(a[ok]) == 0 || sd(b[ok]) == 0) NA_real_ else atanh(max(min(cor(a[ok], b[ok]), 0.999), -0.999)) }
    list(z = zz, n_ay = na) }
  hc1 <- function(z, X) {                                               # HC1 standard error, first column (province effects included)
    okk <- is.finite(z) & rowSums(!is.finite(X)) == 0
    dd <- data.frame(z = z[okk], X[okk, , drop = FALSE], Xfe[okk, , drop = FALSE]); f <- lm(z ~ . - 1 + 0, data = dd)
    se <- if (requireNamespace("sandwich", quietly = TRUE)) sqrt(diag(sandwich::vcovHC(f, type = "HC1")))[["x"]] else {  # Option A
      X1 <- model.matrix(f); X1 <- X1[, !is.na(coef(f)), drop = FALSE]; e <- resid(f); XtXi <- solve(crossprod(X1))       # Option B: manual HC1
      V <- XtXi %*% crossprod(X1 * e) %*% XtXi * nrow(X1) / (nrow(X1) - ncol(X1)); sqrt(diag(V))[["x"]] }
    c(b = unname(coef(f)[["x"]]), se = unname(se)) }
  dsp_test <- function(z, x, Z, mem, R = 999) {                         # DSP permutation (same as step06-10), both tails
    okk <- is.finite(z) & is.finite(x) & rowSums(!is.finite(Z)) == 0
    qz <- qr(Z[okk, , drop = FALSE]); df <- sum(okk) - qz$rank - 1
    rx <- qr.resid(qz, x[okk]); ez <- qr.resid(qz, z[okk])              # x and z are purged of the controls + province effects
    tf <- function(r1) { b <- sum(r1 * ez) / sum(r1^2); e <- ez - b * r1; b / sqrt(sum(e^2) / df / sum(r1^2)) }  # t-statistic
    t_obs <- tf(rx); RXv <- rep(NA_real_, length(x)); RXv[okk] <- rx
    RX <- matrix(0, n, n); RX[up] <- ifelse(is.na(RXv), 0, RXv); RX <- RX + t(RX); tp <- matrix(NA_real_, R, 2)
    for (k in seq_len(R)) { pa <- seq_len(n); pa[mem] <- sample(mem); pb <- sample.int(n)  # within network / all provinces
      tp[k, 1] <- tf(qr.resid(qz, RX[pa, pa][up][okk])); tp[k, 2] <- tf(qr.resid(qz, RX[pb, pb][up][okk])) }
    pu <- function(v) (1 + sum(v >= t_obs)) / (1 + R); pl <- function(v) (1 + sum(v <= t_obs)) / (1 + R)  # upper / lower tail
    c(p1 = pu(tp[, 1]), p2 = pu(tp[, 2]), p1_iki = min(1, 2 * min(pu(tp[, 1]), pl(tp[, 1]))),
      p2_iki = min(1, 2 * min(pu(tp[, 2]), pl(tp[, 2]))), n_cift = sum(okk)) }
  lab_t <- function(v) sprintf("%04d-%02d", (v - 1) %/% 12, (v - 1) %% 12 + 1)  # month number -> "YYYY-MM"
  ym <- function(y, m) y * 12 + m                                       # year-month -> month number
  donem <- list(                                                        # period definitions (based on t of the growth month)
    aylik  = list(erken = c(ym(2017, 1), ym(2020, 2)), gec = c(ym(2022, 1), max(tt))),
    yillik = list(erken = c(ym(2017, 1), ym(2020, 2)), gec = c(ym(2023, 1), max(tt))))
  min_ay <- c(aylik = 30, yillik = 18)                                  # minimum common months
  fe_f <- list(aylik = y ~ il_takvim + ay, yillik = y ~ il + ay)        # same fixed effects as step03c-10
  set.seed(20261118)                                                    # reproducible permutations
  out <- list()
  for (mk in c("yerli", "yabanci")) {
    Cm <- C[[mk]]; mem <- which(rowSums(Cm) > 0); x <- log1p(Cm[up])     # network members and itinerary intensity ln(1 + c)
    sim <- sim_make(2017:2019, mk)                                       # similarity of the main analysis (2017-2019)
    sim_g <- sim_make(2023:2024, mk)                                     # contemporaneous similarity (2023-2024, same coverage period)
    for (bv in c("aylik", "yillik")) {
      yv <- pn[[paste0(if (bv == "aylik") "dlog_m_geceleme_" else "dlog_y_geceleme_", mk)]]  # growth series
      zs <- list()
      for (dn in c("erken", "gec")) {
        rg <- donem[[bv]][[dn]]; y <- yv; y[pn$t < rg[1] | pn$t > rg[2]] <- NA  # observations outside the period set to NA
        ps <- pair_stat(resid_mat(y, fe_f[[bv]]), min_ay[[bv]]); zs[[dn]] <- ps$z  # within-period residual correlation
        am <- range(pn$t[is.finite(y)]); ay_say <- length(unique(pn$t[is.finite(y)]))  # actual month range and number of months
        b0 <- NA_real_
        for (sn in c("M0_rota", "M4_tum_benzerlik", if (dn == "gec") "M4_gec_benzerlik")) {
          Z <- cbind(geo, if (sn == "M4_tum_benzerlik") sim else if (sn == "M4_gec_benzerlik") sim_g else NULL)  # controls
          h <- hc1(ps$z, cbind(x = x, Z)); r <- dsp_test(ps$z, x, cbind(Z, Xfe), mem)
          if (sn == "M0_rota") b0 <- h[["b"]]
          out[[length(out) + 1]] <- data.frame(pazar = mk, buyume = bv, donem = dn, aralik = paste(lab_t(am[1]), "-", lab_t(am[2])),
            model = sn, b = round(h[["b"]], 4), se_hc1 = round(h[["se"]], 4), p_dsp_ag_ici = round(r[["p1"]], 3), p_dsp_tum = round(r[["p2"]], 3),
            p_iki_yon_ag_ici = NA, p_iki_yon_tum = NA, azalma_yuzde = if (sn != "M0_rota") round(100 * (1 - h[["b"]] / b0), 1) else NA,
            n_cift = r[["n_cift"]], n_ay = ay_say, medyan_ortak_ay = median(ps$n_ay), stringsAsFactors = FALSE)
          cat("  step11:", mk, bv, dn, sn, "| b =", round(h[["b"]], 4), "| se =", round(h[["se"]], 4),
              "| p =", round(r[["p1"]], 3), "/", round(r[["p2"]], 3), "| ay =", ay_say, "\n")
        }
      }
      dz <- zs$gec - zs$erken                                           # difference: late - early (positive = stronger in the late period)
      h <- hc1(dz, cbind(x = x, geo)); r <- dsp_test(dz, x, cbind(geo, Xfe), mem)
      out[[length(out) + 1]] <- data.frame(pazar = mk, buyume = bv, donem = "fark_gec_eksi_erken", aralik = "-",
        model = "M0_rota", b = round(h[["b"]], 4), se_hc1 = round(h[["se"]], 4), p_dsp_ag_ici = round(r[["p1"]], 3), p_dsp_tum = round(r[["p2"]], 3),
        p_iki_yon_ag_ici = round(r[["p1_iki"]], 3), p_iki_yon_tum = round(r[["p2_iki"]], 3), azalma_yuzde = NA,
        n_cift = r[["n_cift"]], n_ay = NA, medyan_ortak_ay = NA, stringsAsFactors = FALSE)
      cat("  step11:", mk, bv, "fark | b =", round(h[["b"]], 4), "| se =", round(h[["se"]], 4),
          "| p iki yon =", round(r[["p1_iki"]], 3), "/", round(r[["p2_iki"]], 3), "\n")
    }
  }
  res <- do.call(rbind, out); write_csv_utf8(res, f11)                  # CSV only
  cat("step11 -> sonuclar:\n"); print(res, row.names = FALSE)
  }
})

# =====================================================================
# step12: PROVINCE BOOTSTRAP - UNCERTAINTY OF THE REDUCTION CAUSED BY THE SIMILARITY CONTROLS
#   Question: how much does the itinerary intensity coefficient fall from M0 (itinerary + geography) to M4 (+ 4 similarity measures),
#         and what is the confidence interval of this reduction?
#   Method: province (node) bootstrap. The 81 provinces are drawn with replacement; all pairs among the drawn provinces
#           are rebuilt (pairs of a province with itself are dropped), and each draw gets its own province effect.
#           The z values, itinerary and similarity variables of each pair are taken from the original pair.
#           This covers uncertainty in both the provincial series (demand) and the dyadic dependence.
#   In each replication: b0 (M0), b4 (M4), difference (b0 - b4) and percentage reduction. 999 replications, percentile intervals.
#   Markets: domestic, international | growth: year-on-year (main analysis) and month-on-month.
#   Output: step12_bootstrap_reduction.csv (CSV only)
# =====================================================================
f12 <- file.path(proj_dir, "step12_bootstrap_reduction.csv")
log_warn("step12", {
  if (csv_ok(f12)) message("step12 zaten yapilmis, atlaniyor.") else {
  pn <- read_csv_utf8(f01d_panel)                                       # analysis panel
  ik <- sort(unique(pn$il_key)); n <- length(ik); tt <- sort(unique(pn$t))  # provinces and months
  readM <- function(f) { x <- read_csv_utf8(file.path(proj_dir, f)); M <- as.matrix(x[, -1]); dimnames(M) <- list(x$il_key, x$il_key); M[ik, ik] }  # reads a matrix
  C <- list(yerli = readM("step02b2_C_route_yerli.csv"), yabanci = readM("step02b2_C_route_yabanci.csv"))  # numbers of shared programmes
  Dk <- readM("step02a_dist_km.csv"); Kc <- readM("step02a_W_contig.csv") > 0  # distance and contiguity
  up <- which(upper.tri(Dk), arr.ind = TRUE)                            # 3240 province pairs
  Pidx <- matrix(NA_integer_, n, n); Pidx[up] <- seq_len(nrow(up)); Pidx[up[, 2:1]] <- seq_len(nrow(up))  # (i,j) -> pair index
  Xfe <- matrix(0, nrow(up), n); Xfe[cbind(seq_len(nrow(up)), up[, 1])] <- 1; Xfe[cbind(seq_len(nrow(up)), up[, 2])] <- 1  # province effects
  geo <- cbind(komsu = as.numeric(Kc[up]), log_uzaklik = log(Dk[up]))  # geographic controls
  kiyi <- c("adana", "antalya", "artvin", "aydin", "balikesir", "bartin", "bursa", "canakkale", "duzce", "edirne", "giresun", "hatay",
            "istanbul", "izmir", "kastamonu", "kirklareli", "kocaeli", "mersin", "mugla", "ordu", "rize", "sakarya", "samsun", "sinop",
            "tekirdag", "trabzon", "yalova", "zonguldak")                 # the 28 coastal provinces (same as step03d)
  pre <- pn[pn$year >= 2017 & pn$year <= 2019, ]                        # similarity measures 2017-2019 (same as the main analysis)
  prof <- function(v) { a <- aggregate(pre[[v]], by = list(il = pre$il_key, ay = pre$month), FUN = function(z) sum(z, na.rm = TRUE))
    P <- matrix(0, n, 12, dimnames = list(ik, 1:12)); P[cbind(match(a$il, ik), a$ay)] <- a$x; P / pmax(rowSums(P), 1) }  # seasonal profile
  tot <- function(v) { a <- tapply(pre[[v]], pre$il_key, sum, na.rm = TRUE); a[ik] }  # province totals
  yab_pay <- tot("geceleme_yabanci") / pmax(tot("geceleme_yabanci") + tot("geceleme_yerli"), 1)  # foreign share
  boy <- log1p((tot("geceleme_yabanci") + tot("geceleme_yerli")) / 36)  # size (log monthly mean)
  resid_mat <- function(y, fe_formula) {                                # fixed-effect residuals, province x month matrix
    d <- data.frame(y = y, il = factor(pn$il_key), ay = factor(pn$t), il_takvim = factor(paste(pn$il_key, pn$month)))
    ok <- is.finite(d$y); fit <- lm(fe_formula, data = d[ok, ])
    E <- matrix(NA_real_, n, length(tt)); E[cbind(match(pn$il_key[ok], ik), match(pn$t[ok], tt))] <- resid(fit); E }
  pair_z <- function(E) vapply(seq_len(nrow(up)), function(p) { a <- E[up[p, 1], ]; b <- E[up[p, 2], ]; ok <- is.finite(a) & is.finite(b)
    if (sum(ok) >= 36) atanh(max(min(cor(a[ok], b[ok]), 0.999), -0.999)) else NA_real_ }, numeric(1))  # Fisher z (same as the main analysis)
  coef1 <- function(X, z) {                                             # coefficient of the first column
    b <- tryCatch(.lm.fit(X, z)$coefficients[1], error = function(e) NA_real_)            # Option A: fast least squares
    if (!is.finite(b)) b <- tryCatch(qr.coef(qr(X), z)[1], error = function(e) NA_real_)  # Option B: QR solution
    unname(b) }
  set.seed(20261119)                                                    # reproducible bootstrap
  R <- 999
  out <- list()
  for (mk in c("yerli", "yabanci")) {
    x <- log1p(C[[mk]][up])                                              # itinerary intensity ln(1 + c)
    P <- prof(paste0("geceleme_", mk)); mevs <- cor(t(P)); mevs[!is.finite(mevs)] <- 0  # seasonality similarity
    sim <- cbind(mevsim_benzer = mevs[up], yab_pay_fark = abs(yab_pay[up[, 1]] - yab_pay[up[, 2]]),
                 kiyi_ikisi = as.numeric(ik[up[, 1]] %in% kiyi & ik[up[, 2]] %in% kiyi), buyukluk_fark = abs(boy[up[, 1]] - boy[up[, 2]]))
    for (bv in c("yillik", "aylik")) {
      y <- pn[[paste0(if (bv == "yillik") "dlog_y_geceleme_" else "dlog_m_geceleme_", mk)]]  # growth series
      z <- pair_z(resid_mat(y, if (bv == "yillik") y ~ il + ay else y ~ il_takvim + ay))     # pair correlations
      X0 <- cbind(x, geo); X4 <- cbind(x, geo, sim)                     # M0 and M4 regressors
      ok <- is.finite(z) & rowSums(!is.finite(X4)) == 0
      b0 <- coef1(cbind(X0, Xfe)[ok, ], z[ok]); b4 <- coef1(cbind(X4, Xfe)[ok, ], z[ok])  # original estimates
      bb <- matrix(NA_real_, R, 2)
      for (r in seq_len(R)) {
        s <- sample.int(n, n, replace = TRUE)                           # provinces drawn with replacement
        pr <- which(upper.tri(diag(n)), arr.ind = TRUE); pr <- pr[s[pr[, 1]] != s[pr[, 2]], , drop = FALSE]  # pairs of the draw, same province excluded
        id <- Pidx[cbind(s[pr[, 1]], s[pr[, 2]])]                         # original pair index
        F <- matrix(0, nrow(pr), n); F[cbind(seq_len(nrow(pr)), pr[, 1])] <- 1; F[cbind(seq_len(nrow(pr)), pr[, 2])] <- 1  # province effect per draw
        k <- ok[id]; zz <- z[id][k]
        bb[r, 1] <- coef1(cbind(X0[id, , drop = FALSE], F)[k, ], zz)    # bootstrap M0
        bb[r, 2] <- coef1(cbind(X4[id, , drop = FALSE], F)[k, ], zz)    # bootstrap M4
      }
      bb <- bb[is.finite(bb[, 1]) & is.finite(bb[, 2]), , drop = FALSE]
      fark <- bb[, 1] - bb[, 2]; azal <- 100 * fark / bb[, 1]           # difference and percentage reduction
      q <- function(v) round(unname(quantile(v, c(0.025, 0.975), na.rm = TRUE)), 4)  # 95% percentile interval
      out[[length(out) + 1]] <- data.frame(pazar = mk, buyume = bv, b0 = round(b0, 4), b4 = round(b4, 4), fark = round(b0 - b4, 4),
        azalma_yuzde = round(100 * (1 - b4 / b0), 1),
        b0_alt = q(bb[, 1])[1], b0_ust = q(bb[, 1])[2], b4_alt = q(bb[, 2])[1], b4_ust = q(bb[, 2])[2],
        fark_alt = q(fark)[1], fark_ust = q(fark)[2], azalma_alt = round(q(azal)[1], 1), azalma_ust = round(q(azal)[2], 1),
        azalma_medyan = round(median(azal), 1), pay_fark_pozitif = round(mean(fark > 0), 3), pay_b0_pozitif = round(mean(bb[, 1] > 0), 3),
        n_tekrar = nrow(bb), stringsAsFactors = FALSE)
      cat("  step12:", mk, bv, "| b0 =", round(b0, 4), "| b4 =", round(b4, 4), "| dusus % =", round(100 * (1 - b4 / b0), 1),
          "| fark %95 =", paste(q(fark), collapse = " / "), "| dusus %95 =", paste(round(q(azal), 1), collapse = " / "), "\n")
    }
  }
  res <- do.call(rbind, out); write_csv_utf8(res, f12)                  # CSV only
  cat("step12 -> sonuclar:\n"); print(res, row.names = FALSE)
  }
})

# =====================================================================
# step13: GAZETTEER MATCH RATE
#   Question: on what share of programme days were place names matched to at least one province?
#   A day counts as "with text" if its route or sightseeing field is not empty.
#   A day counts as "matched" if rota_iller or nokta_iller contains at least one province.
#   Outputs: step13_gazetteer_match.csv (rates by site and market)
#             step13_unmatched_days.csv  (all unmatched days, for manual checks)
# =====================================================================
f13a <- file.path(proj_dir, "step13_gazetteer_match.csv")
f13b <- file.path(proj_dir, "step13_unmatched_days.csv")
log_warn("step13", {
  if (csv_ok(f13a) && csv_ok(f13b)) message("step13 zaten yapilmis, atlaniyor.") else {
  dp <- read_csv_utf8(file.path(proj_dir, "step02b2_day_provinces.csv")) # day -> province matching
  td <- read_csv_utf8(file.path(proj_dir, "step02b1_tour_days.csv"))     # raw daily place names
  tp <- read_csv_utf8(file.path(proj_dir, "step02b2_tour_provinces.csv")) # programme -> market
  bos <- function(v) { v <- as.character(v); v[is.na(v)] <- ""; trimws(gsub(";", "", v, fixed = TRUE)) == "" }  # is the field empty
  key_d <- paste(dp$url, dp$gun); key_t <- paste(td$url, td$gun)        # url + day key
  dp$noktalar <- td$noktalar[match(key_d, key_t)]                       # adds the sightseeing points to the day table (Option A: match)
  if (all(is.na(dp$noktalar))) {                                        # Option B: adding with merge
    dp <- merge(dp[, setdiff(names(dp), "noktalar")], td[, c("url", "gun", "noktalar")], by = c("url", "gun"), all.x = TRUE) }
  dp$pazar <- tp$pazar[match(dp$url, tp$url)]                           # domestic / international
  dp$metinli <- !(bos(dp$rota) & bos(dp$noktalar))                      # does the day have place-name text
  dp$eslesti <- !(bos(dp$rota_iller) & bos(dp$nokta_iller))             # was at least one province found
  oz <- function(g, lab) data.frame(grup = lab, gun = nrow(g), metinli_gun = sum(g$metinli),
    eslesen_gun = sum(g$metinli & g$eslesti), oran = round(sum(g$metinli & g$eslesti) / max(sum(g$metinli), 1), 3),
    program = length(unique(g$url)), stringsAsFactors = FALSE)          # summary row
  res <- rbind(oz(dp, "tum"), do.call(rbind, lapply(split(dp, dp$pazar), function(g) oz(g, paste0("pazar_", g$pazar[1])))),
               do.call(rbind, lapply(split(dp, dp$site), function(g) oz(g, paste0("site_", g$site[1])))))
  write_csv_utf8(res, f13a)                                             # rates
  um <- dp[dp$metinli & !dp$eslesti, c("site", "pazar", "url", "gun", "rota", "noktalar")]  # unmatched days
  write_csv_utf8(um, f13b)                                              # list for manual checks
  cat("step13 -> eslesme oranlari:\n"); print(res, row.names = FALSE)
  cat("Eslesmeyen gun sayisi:", nrow(um), "\n")
  }
})

